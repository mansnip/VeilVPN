@model Domain.ViewModels.Authentication.SignUpViewModel
@{
    Layout = null;
    ViewData["Title"] = "ثبت نام | خدمات VPN امن و پرسرعت RahaGozar";
    var baseUrl = Context.Request.Scheme + "://" + Context.Request.Host;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="ثبت نام در سرویس RahaGozar - دسترسی به اینترنت امن و بدون محدودیت با حفظ حریم خصوصی. بهترین سرویس VPN در ایران با سرعت بالا و قیمت مناسب.">
    <meta name="keywords" content="ثبت نام VPN, خرید VPN, سرویس VPN ایران, امنیت اینترنت, دور زدن فیلتر, حریم خصوصی آنلاین">
    <meta name="author" content="RahaGozar">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="@baseUrl/Authentication/SignUp">
    <meta property="og:title" content="ثبت نام | خدمات VPN امن و پرسرعت RahaGozar">
    <meta property="og:description" content="ثبت نام در سرویس RahaGozar - دسترسی به اینترنت امن و بدون محدودیت با حفظ حریم خصوصی.">
    <meta property="og:image" content="@baseUrl/assets/images/veil-vpn-logo.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="@baseUrl/Authentication/SignUp">
    <meta property="twitter:title" content="ثبت نام | خدمات VPN امن و پرسرعت RahaGozar">
    <meta property="twitter:description" content="ثبت نام در سرویس RahaGozar - دسترسی به اینترنت امن و بدون محدودیت با حفظ حریم خصوصی.">
    <meta property="twitter:image" content="@baseUrl/assets/images/veil-vpn-logo.png">

    <!-- Canonical URL -->
    <link rel="canonical" href="@baseUrl/Authentication/SignUp">

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- Layout config Js -->
    <script src="~/assets/js/layout.js"></script>
    <!-- Bootstrap Css -->
    <link href="~/assets/css/bootstrap-rtl.min.css" rel="stylesheet" type="text/css">
    <!-- Icons Css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <!-- App Css-->
    <link href="~/assets/css/app-rtl.min.css" rel="stylesheet" type="text/css">
    <!-- custom Css-->
    <link href="~/assets/css/custom-rtl.min.css" rel="stylesheet" type="text/css">

    <!-- Structured data for SEO -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebPage",
          "name": "ثبت نام در RahaGozar",
          "description": "صفحه ثبت نام در سرویس VPN امن و پرسرعت RahaGozar",
          "publisher": {
            "@@type": "Organization",
            "name": "RahaGozar",
            "logo": {
              "@@type": "ImageObject",
              "url": "@baseUrl/assets/images/logo-dark.png"
            }
          }
        }
    </script>
</head>

<body>
    <!-- auth-page wrapper -->
    <div class="auth-page-wrapper auth-bg-cover py-5 d-flex justify-content-center align-items-center min-vh-100">
        <div class="bg-overlay"></div>
        <!-- auth-page content -->
        <div class="auth-page-content overflow-hidden pt-lg-5">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card overflow-hidden m-0 card-bg-fill galaxy-border-none">
                            <div class="row justify-content-center g-0">
                                <div class="col-lg-6">
                                    <div class="p-lg-5 p-4 auth-one-bg h-100">
                                        <div class="bg-overlay"></div>
                                        <div class="position-relative h-100 d-flex flex-column">
                                            <div class="mb-4">
                                                <a href="/" class="d-block">
                                                    <img src="~/assets/images/logo-light.png" alt="RahaGozar Logo" height="18">
                                                </a>
                                            </div>
                                            <div class="mt-auto">
                                                <div class="mb-3">
                                                    <i class="ri-double-quotes-l display-4 text-success"></i>
                                                </div>

                                                <div id="qoutescarouselIndicators" class="carousel slide" data-bs-ride="carousel">
                                                    <div class="carousel-indicators">
                                                        <button type="button" data-bs-target="#qoutescarouselIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                                                        <button type="button" data-bs-target="#qoutescarouselIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                                                        <button type="button" data-bs-target="#qoutescarouselIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                                                    </div>
                                                    <div class="carousel-inner text-center text-white-50 pb-5">
                                                        <div class="carousel-item active" data-bs-interval="2000">
                                                            <p class="fs-15 fst-italic">"با RahaGozar به راحتی به تمام محتوای اینترنت دسترسی دارم. سرعت عالی و قیمت مناسب!"</p>
                                                        </div>
                                                        <div class="carousel-item" data-bs-interval="2000">
                                                            <p class="fs-15 fst-italic">"حریم خصوصی و امنیت آنلاین من با RahaGozar تضمین شده. بهترین سرویس VPN ایران."</p>
                                                        </div>
                                                        <div class="carousel-item" data-bs-interval="2000">
                                                            <p class="fs-15 fst-italic">"پشتیبانی ۲۴ ساعته و کیفیت عالی خدمات RahaGozar من را بسیار راضی کرده است."</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- end carousel -->
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="p-lg-5 p-4">
                                        <div>
                                            <h1 class="text-primary h3">ایجاد حساب کاربری در RahaGozar</h1>
                                            <p class="text-muted">برای استفاده از خدمات امن و پرسرعت ما ثبت نام کنید.</p>
                                        </div>

                                        <div class="mt-4">
                                            <form class="needs-validation" novalidate asp-action="SignUp" asp-controller="Authentication" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="mb-3">
                                                    <label for="useremail" class="form-label">ایمیل<span class="text-danger">*</span></label>
                                                    <input asp-for="Email" type="email" class="form-control" id="useremail" placeholder="آدرس ایمیل را وارد کنید" required>
                                                    <span asp-validation-for="Email" class="text-danger"></span>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label" for="password-input">رمز عبور<span class="text-danger">*</span></label>
                                                    <div class="position-relative auth-pass-inputgroup">
                                                        <input asp-for="Password" type="password" class="form-control pe-5 password-input" onpaste="return false" placeholder="رمز عبور را وارد کنید" id="password-input" aria-describedby="passwordInput" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" required>
                                                        <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon"><i class="ri-eye-fill align-middle"></i></button>
                                                        <span asp-validation-for="Password" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="mb-4">
                                                    <p class="mb-0 fs-12 text-muted fst-italic">با ثبت نام در RahaGozar موافقت می کنید با <a href="/terms" class="text-primary text-decoration-underline fst-normal fw-medium">شرایط استفاده</a> و <a href="/privacy" class="text-primary text-decoration-underline fst-normal fw-medium">سیاست حریم خصوصی</a> ما</p>
                                                </div>

                                                <div id="password-contain" class="p-3 bg-light mb-2 rounded">
                                                    <h5 class="fs-13">رمز عبور باید حاوی:</h5>
                                                    <p id="pass-length" class="invalid fs-12 mb-2">حداقل <b>8 کاراکتر</b></p>
                                                    <p id="pass-lower" class="invalid fs-12 mb-2">حداقل یک <b>حرف کوچک</b> (a-z)</p>
                                                    <p id="pass-upper" class="invalid fs-12 mb-2">حداقل یک <b>حرف بزرگ</b> (A-Z)</p>
                                                    <p id="pass-number" class="invalid fs-12 mb-0">حداقل یک <b>عدد</b> (0-9)</p>
                                                </div>

                                                <div class="mt-4">
                                                    <button class="btn btn-success w-100" type="submit">ثبت نام و ایجاد حساب</button>
                                                </div>

                                                <div class="mt-4 text-center">
                                                    <div class="signin-other-title">
                                                        <h5 class="fs-13 mb-4 title text-muted">ثبت نام با</h5>
                                                    </div>

                                                    <div>
                                                        <button type="button" class="btn btn-primary btn-icon waves-effect waves-light" title="ثبت نام با فیسبوک"><i class="ri-facebook-fill fs-16"></i></button>
                                                        <button type="button" class="btn btn-danger btn-icon waves-effect waves-light" title="ثبت نام با گوگل"><i class="ri-google-fill fs-16"></i></button>
                                                        <button type="button" class="btn btn-dark btn-icon waves-effect waves-light" title="ثبت نام با گیت‌هاب"><i class="ri-github-fill fs-16"></i></button>
                                                        <button type="button" class="btn btn-info btn-icon waves-effect waves-light" title="ثبت نام با توییتر"><i class="ri-twitter-fill fs-16"></i></button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>

                                        <div class="mt-5 text-center">
                                            <p class="mb-0">از قبل حساب کاربری دارید؟ <a href="/Authentication/SignIn" class="fw-semibold text-primary text-decoration-underline">وارد شوید</a></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end card -->
                    </div>
                    <!-- end col -->
                </div>
                <!-- end row -->
            </div>
            <!-- end container -->
        </div>
        <!-- end auth page content -->
        <!-- footer -->
        <footer class="footer galaxy-border-none">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center">
                            <p class="mb-0 text-center">
                                © <script>document.write(new Date().getFullYear())</script> RahaGozar - تمامی حقوق محفوظ است
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- end Footer -->
    </div>
    <!-- end auth-page-wrapper -->
    <!-- JAVASCRIPT -->
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/feather-icons/feather.min.js"></script>
    <script src="~/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="~/assets/js/plugins.js"></script>

    <!-- validation init -->
    <script src="~/assets/js/pages/form-validation.init.js"></script>
    <!-- password create init -->
    <script src="~/assets/js/pages/passowrd-create.init.js"></script>

    <!-- App js -->
    @await Html.PartialAsync("_Notification")
</body>

</html>
