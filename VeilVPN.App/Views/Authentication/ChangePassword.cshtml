@model Domain.ViewModels.Authentication.ChangePasswordViewModel // فضای نام ViewModel را چک کن
@{
    ViewData["Title"] = "تغییر رمز عبور";
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
    // اگر از breadcrumb استفاده می‌کنی، می‌تونی اینجا تنظیمش کنی
    // ViewData["pTitle"] = "حساب کاربری";
    // ViewData["pageTitle"] = "تغییر رمز عبور";

    // تعیین مسیر لینک بازگشت بر اساس نقش کاربر (اختیاری)
    var backUrl = User.IsInRole("Admin")
                    ? Url.Action("Index", "Home", new { Area = "Admin" })
                    : Url.Action("Index", "Panel", new { Area = "UserPanel" });
}

<!-- Start Content-->
<div class="row justify-content-center">
    @* محتوا را در مرکز قرار می‌دهد *@
    <div class="col-md-8 col-lg-6 col-xl-5">
        @* عرض فرم را محدود می‌کند *@
        <div class="card mt-4">
            @* اضافه کردن کمی فاصله از بالا *@

            <div class="card-body p-4">
                <div class="text-center mt-2">
                    <h5 class="text-primary">تغییر رمز عبور</h5>
                    <p class="text-muted">رمز عبور حساب کاربری خود را به‌روزرسانی کنید.</p>
                </div>

                @* نمایش پیام‌های خطا یا موفقیت کلی (اگر از ShowError/ShowSuccess در کنترلر استفاده شود) *@
                @* می‌توان این بخش را به صورت یک Partial View درآورد *@
                @*@await Html.PartialAsync("_AlertsPartial")*@
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }


                <div class="p-2 mt-4">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label"></label>
                            <div class="position-relative auth-pass-inputgroup mb-3">
                                <input asp-for="OldPassword" type="password" class="form-control pe-5 password-input" placeholder="رمز عبور فعلی را وارد کنید">
                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon-old"><i class="ri-eye-fill align-middle"></i></button>
                            </div>
                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <div class="position-relative auth-pass-inputgroup mb-3">
                                <input asp-for="NewPassword" type="password" class="form-control pe-5 password-input" placeholder="رمز عبور جدید را وارد کنید">
                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon-new"><i class="ri-eye-fill align-middle"></i></button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <div class="position-relative auth-pass-inputgroup mb-3">
                                <input asp-for="ConfirmPassword" type="password" class="form-control pe-5 password-input" placeholder="تکرار رمز عبور جدید">
                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon-confirm"><i class="ri-eye-fill align-middle"></i></button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-success w-100" type="submit">
                                <i class="ri-save-line align-bottom me-1"></i> ذخیره تغییرات
                            </button>
                        </div>

                    </form>
                </div>
                <div class="mt-4 text-center">
                    <p class="mb-0">بازگشت به <a href="@backUrl" class="fw-semibold text-primary text-decoration-underline"> پنل کاربری </a> </p>
                </div>
            </div><!-- end card body -->
        </div><!-- end card -->

    </div>
</div>
<!-- end row -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- password-addon init -->
    <script src="/assets/js/pages/password-addon.init.js"></script> @* این اسکریپت برای دکمه نمایش/مخفی کردن رمز لازمه *@
}


