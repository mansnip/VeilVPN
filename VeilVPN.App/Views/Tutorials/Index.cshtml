@using Domain.ViewModels.UserPanel.Tutorials
@model IEnumerable<Domain.ViewModels.UserPanel.Tutorials.TutorialGridViewModel>
@{
    ViewData["Title"] = "آموزش‌ها";
    Layout = "~/Views/Shared/_Layout.cshtml"; // استفاده از Layout عمومی

    // واکشی داده‌های ViewBag برای دسترسی آسان‌تر (اختیاری ولی خواناتر)
    var categories = ViewBag.Categories as List<dynamic> ?? new List<dynamic>();
    var popularTutorials = ViewBag.PopularTutorials as List<TutorialGridViewModel> ?? new List<TutorialGridViewModel>();
    var archiveData = ViewBag.ArchiveData as List<dynamic> ?? new List<dynamic>();
    var tags = ViewBag.Tags as List<dynamic> ?? new List<dynamic>();
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
            <h4 class="mb-sm-0">@ViewData["Title"]</h4>
            @if (ViewData["CurrentFilter"] != null)
            {
                <span class="text-muted small">@ViewData["CurrentFilter"]</span>
            }
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="~/">صفحه اصلی</a></li>
                    <li class="breadcrumb-item active">آموزش‌ها</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    @* --- ستون سایدبار (چپ) --- *@
    <div class="col-xxl-3">
        <div class="card">
            <div class="card-body p-4">
                @* --- جستجو (نیاز به پیاده‌سازی جداگانه) --- *@
                <div class="search-box">
                    <p class="text-muted">جستجو کنید</p>
                    <form asp-action="Index" asp-controller="Tutorials" method="get">
                        @* فرم جستجو *@
                        <div class="position-relative">
                            <input type="text" name="searchQuery" class="form-control rounded bg-light border-light" placeholder="جستجو آموزش...">
                            <button type="submit" class="btn btn-link position-absolute end-0 top-0 bottom-0 px-2 text-muted"><i class="mdi mdi-magnify search-icon"></i></button>
                        </div>
                    </form>
                </div>

                @* --- دسته بندی ها (داینامیک) --- *@
                @if (categories.Any())
                {
                    <div class="mt-4 pt-4 border-top border-dashed border-bottom-0 border-start-0 border-end-0">
                        <p class="text-muted">دسته بندی ها</p>
                        <ul class="list-unstyled fw-medium">
                            <li><a asp-action="Index" asp-controller="Tutorials" asp-route-category="" class="text-muted py-2 d-block"><i class="mdi mdi-chevron-right me-1"></i>همه دسته‌ها</a></li>
                            @foreach (var categoryInfo in categories)
                            {
                                <li><a asp-action="Index" asp-controller="Tutorials" asp-route-category="@categoryInfo.CategoryName" class="text-muted py-2 d-block"><i class="mdi mdi-chevron-right me-1"></i>@categoryInfo.CategoryName <span class="badge badge-soft-success rounded-pill float-end ms-1 font-size-12">@categoryInfo.Count</span></a></li>
                            }
                        </ul>
                    </div>
                }

                @* --- آرشیو (داینامیک - ساده شده بر اساس سال) --- *@
                @if (archiveData.Any())
                {
                    <div class="mt-4 pt-4 border-top border-dashed border-bottom-0 border-start-0 border-end-0">
                        <p class="text-muted">آرشیو</p>
                        <ul class="list-unstyled fw-medium">
                            @foreach (var archiveInfo in archiveData)
                            {
                                <li><a href="#" class="text-muted py-2 d-block"><i class="mdi mdi-chevron-right me-1"></i>@archiveInfo.Year<span class="badge badge-soft-success rounded-pill float-end ms-1 font-size-12">@archiveInfo.Count</span></a></li>
                                @* برای لینک کردن نیاز به پارامتر سال دارید: asp-route-year="@archiveInfo.Year" *@
                            }
                        </ul>
                    </div>
                }

                @* --- پست های محبوب (داینامیک) --- *@
                @if (popularTutorials.Any())
                {
                    <div class="mt-4 pt-4 border-top border-dashed border-bottom-0 border-start-0 border-end-0">
                        <p class="text-muted mb-2">پست های محبوب</p>
                        <div class="list-group list-group-flush">
                            @foreach (var popularPost in popularTutorials)
                            {
                                <a asp-action="Details" asp-controller="Tutorials" asp-route-id="@popularPost.Id" class="list-group-item text-muted py-3 px-2">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 me-3">
                                            <img src="@popularPost.CoverImagePath" alt="@popularPost.Title" class="avatar-md h-auto d-block rounded object-fit-cover" style="width: 60px; height: 40px;"> @* اندازه ثابت *@
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <h5 class="fs-13 text-truncate mb-0">@popularPost.Title</h5> @* اندازه فونت کوچکتر *@
                                            @* <p class="mb-0 text-truncate fs-11">@popularPost.CreatedAt.ToString("dd MMMM yyyy")</p> *@ @* نمایش تاریخ اگر در ViewModel باشد *@
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }

                @* --- برچسب ها (داینامیک) --- *@
                @if (tags.Any())
                {
                    <div class="mt-4 pt-4 border-top border-dashed border-bottom-0 border-start-0 border-end-0">
                        <p class="text-muted">برچسب های محبوب</p>
                        <div class="d-flex flex-wrap gap-2 widget-tag">
                            @foreach (var tagInfo in tags)
                            {
                                <div><a asp-action="Index" asp-controller="Tutorials" asp-route-tag="@tagInfo.TagName" class="badge bg-light text-muted font-size-12">@tagInfo.TagName (@tagInfo.Count)</a></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    @* --- پایان ستون سایدبار --- *@

    @* --- ستون محتوای اصلی (راست) --- *@
    <div class="col-xxl-9">
        <div class="row gx-4">
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="alert alert-warning text-center">
                        <i class="ri-error-warning-line me-2 align-middle"></i>
                        @if (ViewData["CurrentFilter"] != null)
                        {
                            <span>هیچ آموزشی با فیلتر "@ViewData["CurrentFilter"]" یافت نشد.</span>
                            <a asp-action="Index" asp-controller="Tutorials" class="ms-2">نمایش همه</a>
                        }
                        else
                        {
                            <span>هیچ آموزشی برای نمایش یافت نشد.</span>
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col-xxl-12">
                        @* یا col-lg-6 col-md-12 برای دو ستونه شدن *@
                        <div class="card">
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-xxl-3 col-lg-5">
                                        <a asp-action="Details" asp-controller="Tutorials" asp-route-id="@item.Id">
                                            <img src="@item.CoverImagePath" alt="@item.Title" class="img-fluid rounded w-100 object-fit-cover" style="max-height: 180px;">
                                        </a>
                                    </div><!--end col-->
                                    <div class="col-xxl-9 col-lg-7">
                                        @if (!string.IsNullOrEmpty(item.Category))
                                        {
                                            <p class="mb-2 fs-12"><a asp-action="Index" asp-controller="Tutorials" asp-route-category="@item.Category" class="text-primary text-uppercase">@item.Category</a></p>
                                        }
                                        <a asp-action="Details" asp-controller="Tutorials" asp-route-id="@item.Id" class="text-reset d-block mb-2">
                                            <h5 class="fs-15 fw-semibold">@item.Title</h5>
                                        </a>
                                        <p class="text-muted mb-2 clamp-lines-3">@item.ShortDescription</p>
                                        <a asp-action="Details" asp-controller="Tutorials" asp-route-id="@item.Id" class="text-decoration-underline link-primary">ادامه مطلب<i class="ri-arrow-left-line ms-1 align-middle"></i></a>
                                    </div><!--end col-->
                                </div><!--end row-->
                            </div>
                        </div>
                    </div>

                    <!--end col-->
                }
            }
        </div><!--end row (Tutorial list)-->

        @* --- بخش صفحه‌بندی (نیاز به پیاده‌سازی کامل با PagedList و ...) --- *@
        <div class="row g-0 text-center text-sm-start align-items-center mb-4">
            <div class="col-sm-6">
                <div>
                    <p class="mb-sm-0 text-muted"> نمایش <span class="fw-semibold"> @Model.Count() </span> مورد </p> @* نمایش ساده تعداد *@
                    @* در صورت استفاده از PagedList: *@
                    @* <p class="mb-sm-0 text-muted"> نمایش @Model.FirstItemOnPage تا @Model.LastItemOnPage از @Model.TotalItemCount مورد</p> *@
                </div>
            </div>
            <div class="col-sm-6">
                @* محل نمایش لینک‌های صفحه‌بندی (توسط PagedList یا مشابه) *@
                @* <div class="pagination-container"> *@
                @* @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page, category = ViewBag.CurrentCategory, tag = ViewBag.CurrentTag }), PagedListRenderOptions.Bootstrap5Minimal) *@
                @* </div> *@
                <ul class="pagination pagination-separated justify-content-center justify-content-sm-end mb-sm-0">
                    <li class="page-item disabled"><a href="#" class="page-link">قبلی</a></li>
                    <li class="page-item active"><a href="#" class="page-link">1</a></li>
                    <li class="page-item"><a href="#" class="page-link">بعدی</a></li>
                </ul>
            </div>
        </div><!--end row (Pagination)-->

    </div>
    @* --- پایان ستون محتوای اصلی --- *@
</div><!--end row (Main Page Structure)-->
@section Styles {
    <style>
        .clamp-lines-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .object-fit-cover {
            object-fit: cover;
            width: 100%;
            height: 100%; /* برای اطمینان از پوشش کامل */
        }

        .widget-tag .badge {
            font-size: 0.75rem !important; /* کمی بزرگتر کردن فونت تگ‌ها */
        }

        .list-group-item .avatar-md.object-fit-cover {
            height: 40px !important; /* ارتفاع ثابت برای عکس پست های محبوب */
            width: 60px !important; /* عرض ثابت برای عکس پست های محبوب */
        }
    </style>
}

@section Scripts {
@* اسکریپت‌های لازم (مثلا برای فعال کردن tooltip ها اگر دارید) *@
}

