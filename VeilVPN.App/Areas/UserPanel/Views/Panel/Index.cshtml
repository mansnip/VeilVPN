@model Domain.ViewModels.UserPanel.Dashboard.DashboardViewModel
@using Application.Extensions
@{
    ViewData["Title"] = "داشبورد کاربری";
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
}

<!-- Start Content-->
<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent mb-4">
            @* اضافه کردن mb-4 برای فاصله *@
            <h4 class="mb-sm-0">داشبورد</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">پنل کاربری</a></li>
                    <li class="breadcrumb-item active">داشبورد</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<!-- نمایش پیام‌های موفقیت و خطا -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>موفقیت!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>خطا!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- پیام خوش آمدگویی -->
<div class="row">
    <div class="col-12">
        <div class="card bg-primary text-white border-0 shadow-sm">
            @* کمی استایل بیشتر *@
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="ri-shield-user-line fs-1"></i> @* آیکون مناسب‌تر *@
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="card-title text-white mb-1">سلام، @Model.UserName عزیز!</h5>
                        <p class="card-text mb-0">به پنل کاربری خود در رهاگذر خوش آمدید.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- ستون اصلی (بخش اشتراک) -->
    <div class="col-lg-8">
        <div class="card card-height-100 shadow-sm">
            @* افزودن سایه *@
            <div class="card-header align-items-center d-flex border-bottom-dashed">
                @* جداکننده خط‌چین *@
                <h4 class="card-title mb-0 flex-grow-1">
                    <i class="ri-shield-check-line align-middle me-1 text-primary"></i> وضعیت اشتراک
                </h4>
                @if (Model.HasActiveSubscription)
                {
                    <div class="flex-shrink-0">
                        @* دکمه تمدید که به صفحه خرید با ID اشتراک فعلی می‌رود *@
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="BuySubscription" asp-route-subscriptionId="@Model.ActiveSubscription.Id" class="btn btn-soft-success btn-sm">
                            <i class="ri-refresh-line align-bottom me-1"></i> تمدید اشتراک
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex-shrink-0">
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="BuySubscription" class="btn btn-success btn-sm">
                            <i class="ri-shopping-cart-2-line align-bottom me-1"></i> خرید اشتراک جدید
                        </a>
                    </div>
                }
            </div><!-- end card header -->

            <div class="card-body">
                @if (Model.HasActiveSubscription)
                {
                    var sub = Model.ActiveSubscription;
                    var progressColor = sub.UsagePercentage < 75 ? "primary" : (sub.UsagePercentage < 90 ? "warning" : "danger");

                    <h5 class="fs-15 mb-3">@sub.RemarkName</h5>

                    <div class="row gy-3">
                        <div class="col-md-6">
                            <p class="mb-2">
                                <i class="ri-calendar-check-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">تاریخ انقضا:</span> @sub.ExpiryDate.ToPersianDate()
                            </p>
                            <p class="mb-0">
                                <i class="ri-time-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">زمان باقیمانده:</span>
                                @if (sub.RemainingDays > 0)
                                {
                                    <span class="text-success">@sub.RemainingDays روز</span>
                                }
                                else
                                {
                                    <span class="text-danger">منقضی شده</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2">
                                <i class="ri-database-2-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">حجم کل:</span> @sub.TotalTrafficGB گیگابایت
                            </p>
                            <p class="mb-0">
                                <i class="ri-download-cloud-2-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">باقیمانده:</span> @sub.RemainingTrafficGB گیگابایت
                                (@if (sub.RemainingTrafficGB <= 0 && sub.TotalTrafficGB > 0)
                                {
                                    <span class="text-danger">تمام شده</span>
                                }
                                else
                                {
                                    <span class="text-success">موجود</span>
                                })
                            </p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="form-label mb-1">میزان مصرف ترافیک (@($"{sub.UsagePercentage:F1}")%)</label>
                        <div class="progress progress-lg rounded-pill" style="height: 10px;">
                            <div class="progress-bar bg-@progressColor" role="progressbar" style="width: @($"{sub.UsagePercentage}%")" aria-valuenow="@sub.UsagePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-1 fs-12 text-muted">
                            <span>@sub.UsedTrafficGB GB مصرف شده</span>
                            <span>@sub.TotalTrafficGB GB کل</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-2 border-top border-dashed">
                        @* جداکننده *@
                        <a asp-area="UserPanel" asp-controller="Subscription" asp-action="MySubscriptions" class="btn btn-soft-primary btn-sm">
                            <i class="ri-eye-line align-middle me-1"></i> مشاهده جزئیات کامل اشتراک
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="ri-error-warning-line fs-1 text-warning mb-3"></i>
                        <h5 class="text-muted">شما در حال حاضر هیچ اشتراک فعالی ندارید.</h5>
                        <p class="text-muted">برای استفاده از خدمات، لطفا یک اشتراک جدید خریداری کنید.</p>
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="BuySubscription" class="btn btn-success mt-2">
                            <i class="ri-shopping-cart-2-line align-bottom me-1"></i> خرید اشتراک
                        </a>
                    </div>
                }
            </div><!-- end card body -->
        </div><!-- end card -->
    </div><!-- end col -->
    <!-- ستون کناری (فاکتورها و لینک‌ها) -->
    <div class="col-lg-4">
        <!-- کارت فاکتورهای در انتظار -->
        <div class="card card-height-100 shadow-sm mb-4">
            @* افزودن سایه و فاصله پایین *@
            <div class="card-body text-center">
                <div class="avatar-sm mx-auto mb-3">
                    <span class="avatar-title bg-warning-subtle text-warning rounded-circle fs-2">
                        <i class="ri-file-list-3-line"></i>
                    </span>
                </div>
                <h4 class="fs-4 mb-1">
                    @Model.PendingInvoicesCount
                </h4>
                <p class="text-muted mb-3">فاکتور در انتظار پرداخت</p>
                <a asp-area="UserPanel" asp-controller="Panel" asp-action="Invoices" class="btn btn-soft-warning btn-sm w-100">
                    مشاهده و پرداخت فاکتورها
                </a>
            </div>
        </div>

        <!-- لینک های سریع (نمونه) -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="ri-links-line align-middle me-1"></i> لینک‌های سریع</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <a asp-area="UserPanel" asp-controller="Subscription" asp-action="MySubscriptions">
                            <i class="ri-list-check-2 align-middle me-2 text-primary"></i> اشتراک‌های من
                        </a>
                    </li>
                    <li class="list-group-item">
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="Invoices">
                            <i class="ri-file-text-line align-middle me-2 text-primary"></i> فاکتورهای من
                        </a>
                    </li>
                    <li class="list-group-item">
                        <a asp-area="UserPanel" asp-controller="Tutorials" asp-action="Index">@* لینک به صفحه راهنما یا دانلود *@
                            <i class="ri-download-2-line align-middle me-2 text-primary"></i> راهنمای اتصال و دانلود
                        </a>
                    </li>
                    <li class="list-group-item">
                        <a asp-area="UserPanel" asp-controller="Chat" asp-action="Index">@* لینک به صفحه تیکت‌ها *@
                            <i class="ri-customer-service-2-line align-middle me-2 text-primary"></i> پشتیبانی (تیکت)
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div><!-- end col -->
</div><!-- end row -->
<!-- بخش فاکتورهای اخیر -->
<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            @* افزودن سایه *@
            <div class="card-header d-flex align-items-center border-bottom-dashed">
                <h4 class="card-title flex-grow-1 mb-0">
                    <i class="ri-file-list-2-line align-middle me-1 text-info"></i> فاکتورهای اخیر
                </h4>
                <div class="flex-shrink-0">
                    <a asp-area="UserPanel" asp-controller="Panel" asp-action="Invoices" class="btn btn-soft-info btn-sm">
                        مشاهده همه فاکتورها <i class="ri-arrow-left-s-line align-middle"></i>
                    </a>
                </div>
            </div><!-- end cardheader -->
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-hover table-nowrap table-centered align-middle mb-0">
                        <thead class="table-light text-muted">
                            @* تغییر رنگ به table-light *@
                            <tr>
                                <th scope="col">شماره فاکتور</th>
                                <th scope="col">تاریخ</th>
                                <th scope="col">مبلغ</th>
                                <th scope="col">وضعیت</th>
                                <th scope="col">عملیات</th>
                            </tr><!-- end tr -->
                        </thead><!-- thead -->

                        <tbody>
                            @if (Model.RecentInvoices != null && Model.RecentInvoices.Any())
                            {
                                @foreach (var invoice in Model.RecentInvoices)
                                {
                                    <tr>
                                        <td class="fw-medium">@invoice.InvoiceNumber</td>
                                        <td>@invoice.InvoiceDate.ToPersianDate()</td>
                                        <td>@invoice.FinalPrice.ToPrice() تومان</td>
                                        <td>
                                            @if (invoice.Status == "پرداخت شده")
                                            {
                                                <span class="badge bg-success-subtle text-success">@invoice.Status</span>
                                            }
                                            else if (invoice.Status == "در انتظار پرداخت")
                                            {
                                                <span class="badge bg-warning-subtle text-warning">@invoice.Status</span>
                                            }
                                            else if (invoice.Status == "لغو شده")
                                            {
                                                <span class="badge bg-danger-subtle text-danger">@invoice.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info">@invoice.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="hstack gap-2">
                                                <a href="@Url.Action("ShowInvoice", "Panel", new { area = "UserPanel", id = invoice.Id })" class="btn btn-sm btn-soft-primary">
                                                    <i class="ri-eye-line align-middle"></i> <span class="d-none d-sm-inline-block">مشاهده</span> @* متن در موبایل مخفی شود *@
                                                </a>
                                                @if (invoice.Status == "در انتظار پرداخت")
                                                {
                                                    <form asp-area="UserPanel" asp-controller="Panel" asp-action="ProcessPayment" method="post" class="d-inline">
                                                        <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                                        <button type="submit" class="btn btn-sm btn-soft-success">
                                                            <i class="ri-bank-card-line align-middle"></i> <span class="d-none d-sm-inline-block">پرداخت</span>
                                                        </button>
                                                    </form>
                                                    @* دکمه لغو در داشبورد شاید ضروری نباشد، برای خلوت شدن حذف شد *@
                                                    @* <form asp-area="UserPanel" asp-controller="Panel" asp-action="CancelInvoice" method="post" onsubmit="return confirm('آیا از لغو این فاکتور اطمینان دارید؟');" class="d-inline">
                                                            <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                                            <button type="submit" class="btn btn-sm btn-soft-danger">
                                                                <i class="ri-close-circle-line align-middle"></i> <span class="d-none d-sm-inline-block">لغو</span>
                                                            </button>
                                                        </form> *@
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- end tr -->
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <i class="ri-information-line fs-3 text-muted mb-2"></i><br />
                                        هیچ فاکتور اخیری برای نمایش وجود ندارد.
                                    </td>
                                </tr>
                            }
                        </tbody><!-- end tbody -->
                    </table><!-- end table -->
                </div>
            </div><!-- end card body -->
        </div><!-- end card -->
    </div><!-- end col -->
</div><!-- end row -->
@section Scripts {
    <!-- اینجا می‌توانید اسکریپت‌های خاص این صفحه را اضافه کنید -->
@* <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script> *@
@* <script src="~/assets/js/pages/dashboard-projects.init.js"></script> *@ @* اگر نیاز به نمودار یا شمارنده دارید *@

    <script>
        // کد جاوا اسکریپت اضافی در صورت نیاز
        // مثال: آپدیت خودکار وضعیت یا...
    </script>
}