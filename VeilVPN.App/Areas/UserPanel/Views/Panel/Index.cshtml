@model Domain.ViewModels.UserPanel.Dashboard.DashboardViewModel
@using Application.Extensions
@{
    ViewData["Title"] = "داشبورد کاربری";
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
}

<!-- Start Content-->
<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent mb-4">
            <h4 class="mb-sm-0">داشبورد</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">پنل کاربری</a></li>
                    <li class="breadcrumb-item active">داشبورد</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<!-- نمایش پیام‌ها -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ri-check-double-line me-1 align-middle fs-16"></i> <strong>موفقیت!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ri-error-warning-line me-1 align-middle fs-16"></i> <strong>خطا!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- پیام خوش آمدگویی -->
<div class="row">
    <div class="col-12">
        <div class="card bg-primary text-white border-0 shadow">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="ri-user-smile-line fs-1"></i> <!-- آیکون دوستانه‌تر -->
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="card-title text-white mb-1">سلام، @Model.UserName عزیز!</h5>
                        <p class="card-text mb-0">به پنل کاربری خود در رهاگذر خوش آمدید.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- ستون اصلی (بخش اشتراک) -->
    <div class="col-lg-8">
        <div class="card card-height-100 shadow mb-4">
            <!-- اضافه کردن mb-4 -->
            <div class="card-header align-items-center d-flex border-bottom">
                <!-- حذف dashed -->
                <h4 class="card-title mb-0 flex-grow-1">
                    <i class="ri-shield-check-line align-middle me-1 text-primary"></i> وضعیت اشتراک فعلی
                </h4>
                @if (Model.HasActiveSubscription)
                {
                    <div class="flex-shrink-0">
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="BuySubscription" asp-route-subscriptionId="@Model.ActiveSubscription.Id" class="btn btn-success btn-sm">
                            <!-- تغییر به دکمه اصلی -->
                            <i class="ri-refresh-line align-bottom me-1"></i> تمدید اشتراک
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex-shrink-0">
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="BuySubscription" class="btn btn-success btn-sm">
                            <i class="ri-shopping-cart-2-line align-bottom me-1"></i> خرید اشتراک جدید
                        </a>
                    </div>
                }
            </div><!-- end card header -->

            <div class="card-body">
                @if (Model.HasActiveSubscription)
                {
                    var sub = Model.ActiveSubscription;
                    var progressColor = sub.UsagePercentage < 75 ? "primary" : (sub.UsagePercentage < 90 ? "warning" : "danger");

                    <h5 class="fs-15 mb-3">@sub.RemarkName</h5>

                    <div class="row gy-3 mb-4">
                        <!-- اضافه کردن فاصله پایین -->
                        <div class="col-md-6">
                            <p class="mb-2">
                                <i class="ri-calendar-check-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">تاریخ انقضا:</span> <span class="fw-bold">@sub.ExpiryDate.ToPersianDate()</span>
                            </p>
                            <p class="mb-0">
                                <i class="ri-time-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">زمان باقیمانده:</span>
                                @if (sub.RemainingDays > 0)
                                {
                                    <span class="badge bg-success-subtle text-success ms-1">@sub.RemainingDays روز</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger ms-1">منقضی شده</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2">
                                <i class="ri-database-2-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">حجم کل:</span> @sub.TotalTrafficGB گیگابایت
                            </p>
                            <p class="mb-0">
                                <i class="ri-download-cloud-2-line align-middle me-1 text-muted"></i>
                                <span class="fw-medium">باقیمانده:</span> <span class="fw-bold">@sub.RemainingTrafficGB</span> گیگابایت
                                @if (sub.TotalTrafficGB > 0) // فقط اگر حجم داشته باشه وضعیتش معنی داره
                                {
                                    @if (sub.RemainingTrafficGB <= 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1">تمام شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success ms-1">موجود</span>
                                    }
                                }
                            </p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="form-label mb-1">میزان مصرف ترافیک (@($"{sub.UsagePercentage:F1}")%)</label>
                        <div class="progress progress-lg rounded-pill" style="height: 12px;">
                            <!-- کمی افزایش ارتفاع -->
                            <div id="traffic-progress-bar" class="progress-bar bg-@progressColor progress-bar-striped progress-bar-animated" role="progressbar" style="width: @($"{sub.UsagePercentage}%")" aria-valuenow="@sub.UsagePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-1 fs-12 text-muted">
                            <span id="used-traffic">@sub.UsedTrafficGB GB مصرف شده</span>
                            <span id="total-traffic">@sub.TotalTrafficGB GB کل</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <!-- حذف dashed و چینش دکمه ها -->
                        <a asp-area="UserPanel" asp-controller="Subscription" asp-action="MySubscriptions" class="btn btn-outline-primary">
                            <!-- دکمه برجسته‌تر -->
                            <i class="ri-eye-line align-middle me-1"></i> مشاهده جزئیات کامل اشتراک
                        </a>
                        <!-- [جدید] دکمه رفرش دستی آمار -->
                        <div>
                            <button id="refresh-stats-btn" class="btn btn-soft-secondary" title="به‌روزرسانی آمار">
                                <i class="ri-refresh-line"></i>
                            </button>
                            <span id="stats-loading" class="spinner-border spinner-border-sm text-primary ms-2" role="status" style="display: none;"></span>
                        </div>
                    </div>
                }
                else // در صورتی که اشتراک فعال وجود نداشته باشد
                {
                    <div class="text-center py-4">
                        <div class="avatar-lg mx-auto mb-4">
                            <div class="avatar-title bg-warning-subtle text-warning fs-1 rounded-circle">
                                <i class="ri-error-warning-line"></i>
                            </div>
                        </div>
                        <h5 class="text-muted">شما در حال حاضر هیچ اشتراک فعالی ندارید.</h5>
                        <p class="text-muted mb-4">برای استفاده از خدمات و دسترسی به اینترنت آزاد، لطفا یک اشتراک جدید خریداری کنید.</p>
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="BuySubscription" class="btn btn-success">
                            <i class="ri-shopping-cart-2-line align-bottom me-1"></i> خرید اشتراک
                        </a>
                    </div>
                }
            </div><!-- end card body -->
        </div><!-- end card -->
    </div><!-- end col -->
    <!-- ستون کناری (فاکتورها و لینک‌ها) -->
    <div class="col-lg-4">
        <!-- کارت فاکتورهای در انتظار -->
        <div class="card card-height-100 shadow mb-4">
            <div class="card-body text-center d-flex flex-column">
                <!-- استفاده از flex برای چسباندن دکمه به پایین -->
                <div class="avatar-md mx-auto mb-3">
                    <span class="avatar-title bg-warning text-white rounded-circle fs-1">
                        <!-- رنگ اصلی هشدار -->
                        <i class="ri-file-list-3-fill"></i> <!-- آیکون پررنگ تر -->
                    </span>
                </div>
                <h4 class="fs-3 mb-1 fw-bold" id="pending-invoices-count">@Model.PendingInvoicesCount</h4>
                <p class="text-muted mb-3">فاکتور در انتظار پرداخت</p>
                <div class="mt-auto">
                    <!-- چسباندن به پایین کارت -->
                    <a asp-area="UserPanel" asp-controller="Panel" asp-action="Invoices" class="btn btn-warning w-100">
                        <!-- دکمه اصلی هشدار -->
                        مشاهده و پرداخت فاکتورها
                    </a>
                </div>
            </div>
        </div>

        <!-- لینک های سریع (طراحی دکمه ای) -->
        <div class="card shadow">
            <div class="card-header bg-light border-bottom">
                <!-- پس زمینه روشن برای هدر -->
                <h5 class="card-title mb-0"><i class="ri-links-fill align-middle me-1 text-primary"></i> لینک‌های سریع</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-area="UserPanel" asp-controller="Subscription" asp-action="MySubscriptions" class="btn btn-outline-primary text-start">
                        <i class="ri-list-check-2 align-middle me-2"></i> اشتراک‌های من
                    </a>
                    <a asp-area="UserPanel" asp-controller="Panel" asp-action="Invoices" class="btn btn-outline-primary text-start">
                        <i class="ri-file-text-line align-middle me-2"></i> فاکتورهای من
                    </a>
                    <a asp-area="UserPanel" asp-controller="Tutorials" asp-action="Index" class="btn btn-outline-primary text-start">
                        <i class="ri-download-cloud-2-line align-middle me-2"></i> راهنمای اتصال و دانلود
                    </a>
                    <a asp-area="UserPanel" asp-controller="Chat" asp-action="Index" class="btn btn-outline-primary text-start">
                        <i class="ri-customer-service-2-line align-middle me-2"></i> پشتیبانی (تیکت)
                    </a>
                </div>
            </div>
        </div><!-- end col -->
    </div><!-- end row -->
    <!-- بخش فاکتورهای اخیر -->
    <div class="row mt-4 col-lg-8">
        <!-- اضافه کردن فاصله بالا -->
        <div class="col-lg-12">
            <!-- تمام عرض -->
            <div class="card shadow">
                <div class="card-header d-flex align-items-center border-bottom bg-light">
                    <!-- جداکننده و پس زمینه روشن -->
                    <h4 class="card-title flex-grow-1 mb-0">
                        <i class="ri-file-list-3-line align-middle me-1 text-info"></i> تاریخچه فاکتورها (3 مورد اخیر)
                    </h4>
                    <div class="flex-shrink-0">
                        <a asp-area="UserPanel" asp-controller="Panel" asp-action="Invoices" class="btn btn-primary btn-sm">
                            <!-- لینک به صفحه کامل فاکتورها -->
                            مشاهده همه <i class="ri-arrow-left-s-line align-middle"></i>
                        </a>
                    </div>
                </div><!-- end card header -->
                <div class="card-body">
                    @if (Model.RecentInvoices != null && Model.RecentInvoices.Any())
                    {
                        <div class="table-responsive table-card">
                            <table class="table table-hover table-striped align-middle table-nowrap mb-0">
                                <!-- اضافه کردن استایل striped -->
                                <thead class="table-light text-muted">
                                    <!-- رنگ متن هدر -->
                                    <tr>
                                        <th scope="col">شماره فاکتور</th>
                                        <th scope="col">تاریخ ایجاد</th>
                                        <th scope="col">مبلغ کل</th>
                                        <th scope="col">وضعیت</th>
                                        <th scope="col">عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model.RecentInvoices)
                                    {
                                        <tr>
                                            <td><a asp-area="UserPanel" asp-controller="Panel" asp-action="InvoiceDetail" asp-route-invoiceId="@invoice.Id" class="fw-medium link-primary">#@invoice.InvoiceNumber</a></td>
                                            <td>@invoice.InvoiceDate.ToPersianDate()</td> @* نمایش زمان دقیق‌تر *@
                                            <td>@invoice.FinalPrice.ToString("N0") تومان</td>
                                            <td>
                                                @if (invoice.Status == "پرداخت شده")
                                                {
                                                    <span class="badge bg-success-subtle text-success"><i class="ri-check-double-line align-middle me-1"></i>پرداخت شده</span>
                                                }
                                                else if (invoice.Status == "در انتظار پرداخت")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning"><i class="ri-time-line align-middle me-1"></i>در انتظار پرداخت</span>
                                                }
                                                else if (invoice.Status == "لغو شده")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger"><i class="ri-close-circle-line align-middle me-1"></i>لغو شده</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">@invoice.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="hstack gap-2">
                                                    @* برای چیدمان دکمه ها *@
                                                    <a asp-area="UserPanel" asp-controller="Panel" asp-action="InvoiceDetail" asp-route-invoiceId="@invoice.Id" class="btn btn-sm btn-soft-primary">
                                                        <i class="ri-eye-line align-middle"></i> <span class="d-none d-sm-inline-block">مشاهده</span>
                                                    </a>
                                                    @if (invoice.Status == "در انتظار پرداخت")
                                                    {
                                                        // نکته: لینک پرداخت باید به کنترلر و اکشن صحیح که عملیات پرداخت را آغاز می‌کند، اشاره کند.
                                                        <a asp-area="" asp-controller="Payment" asp-action="PayInvoice" asp-route-invoiceId="@invoice.Id" class="btn btn-sm btn-soft-success">
                                                            <i class="ri-secure-payment-line align-middle"></i> <span class="d-none d-sm-inline-block">پرداخت</span>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else // در صورتی که هیچ فاکتوری وجود نداشته باشد
                    {
                        <div class="text-center py-4">
                            <div class="avatar-lg mx-auto mb-4">
                                <div class="avatar-title bg-light text-muted fs-1 rounded-circle">
                                    <i class="ri-file-text-line"></i>
                                </div>
                            </div>
                            <h5 class="text-muted">هنوز هیچ فاکتوری برای شما ثبت نشده است.</h5>
                        </div>
                    }
                </div><!-- end card-body -->
            </div><!-- end card -->
        </div><!-- end col -->
    </div><!-- end row -->
    <!-- [جدید] بخش JavaScript برای رفرش آمار -->
    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const refreshButton = document.getElementById('refresh-stats-btn');
                const loadingSpinner = document.getElementById('stats-loading');
                const subscriptionId = '@(Model.HasActiveSubscription ? Model.ActiveSubscription.Id : Guid.Empty)'; // دریافت ID اشتراک از مدل

                // Add data attributes to elements needing update for easier selection in JS
                 const remainingTrafficEl = document.querySelector('.col-md-6 p:nth-child(2) .fw-bold');
                 if(remainingTrafficEl) remainingTrafficEl.dataset.stat = 'remaining-traffic';

                 const remainingDaysEl = document.querySelector('.col-md-6 p:nth-child(2) .badge');
                 if(remainingDaysEl) remainingDaysEl.dataset.stat = 'remaining-days';

                 // Optional: Give the label an ID if it doesn't have one
                 const progressLabel = document.querySelector('.mt-4 > label.form-label.mb-1');
                 if(progressLabel && !progressLabel.id) progressLabel.id = 'traffic-usage-label';
                 const progressBar = document.getElementById('traffic-progress-bar');
                 if(progressBar && progressLabel && progressLabel.id) progressBar.setAttribute('aria-labelledby', progressLabel.id); // Improve accessibility


                if (refreshButton && loadingSpinner && subscriptionId && subscriptionId !== '@Guid.Empty.ToString()') { // Ensure subscriptionId is valid
                    refreshButton.addEventListener('click', function() {
                        // Show spinner, hide button (or disable it)
                        loadingSpinner.style.display = 'inline-block';
                        refreshButton.disabled = true;
                        console.log('Refreshing subscription stats for ID:', subscriptionId);

                        // --- AJAX Call to get updated stats ---
                        // !!! مهم: URL زیر باید با اندپوینت واقعی شما در کنترلر جایگزین شود !!!
                                    fetch(`/UserPanel/Panel/GetSubscriptionStats/${subscriptionId}`, {
                            method: 'GET',
                            headers: {
                                'Accept': 'application/json',
                                // Add AntiForgery token if needed for GET requests (less common but possible)
                                // 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            }
                        })
                        .then(response => {
                            if (!response.ok) {
                                 // Try to read error message from body if available
                                 return response.text().then(text => {
                                    throw new Error(`HTTP error! status: ${response.status}, message: ${text || 'No error message'}`);
                                 });
                            }
                            return response.json();
                        })
                        .then(data => {
                            console.log('Received stats:', data);
                            if (data && data.success === true && data.stats) { // Check success flag and stats object
                                // Update UI elements
                                updateStatsUI(data.stats);
                                 showToast('آمار اشتراک با موفقیت به‌روز شد.', 'success');
                            } else {
                                // Log the actual response for debugging
                                console.error('Failed to get stats or invalid data format. Response:', data);
                                showToast('خطا در دریافت آمار: ' + (data ? data.message : 'پاسخ نامعتبر'), 'error');
                            }
                        })
                        .catch(error => {
                            console.error('Error fetching subscription stats:', error);
                            showToast('خطا در ارتباط با سرور: ' + error.message, 'error');
                        })
                        .finally(() => {
                            // Hide spinner, re-enable button
                            loadingSpinner.style.display = 'none';
                            refreshButton.disabled = false;
                        });
                    });
                } else {
                     if (!refreshButton) console.warn("Refresh button not found.");
                     if (!loadingSpinner) console.warn("Loading spinner not found.");
                     if (!subscriptionId || subscriptionId === '@Guid.Empty.ToString()') console.warn("No active subscription ID found for refresh functionality.");
                }

                // Function to update UI elements with new stats
                function updateStatsUI(stats) {
                    // Update Remaining Traffic text
                    const remainingTrafficElement = document.querySelector('[data-stat="remaining-traffic"]');
                     if (remainingTrafficElement && stats.remainingTrafficGB !== undefined) {
                        remainingTrafficElement.textContent = stats.remainingTrafficGB.toFixed(2); // Format to 2 decimal places
                    } else if (remainingTrafficElement) { console.warn('Remaining traffic data missing in stats'); }
                      else { console.warn('Remaining traffic element not found for update'); }


                    // Update Used Traffic text
                    const usedTrafficElement = document.getElementById('used-traffic');
                    if (usedTrafficElement && stats.usedTrafficGB !== undefined) {
                        usedTrafficElement.textContent = `${stats.usedTrafficGB.toFixed(2)} GB مصرف شده`; // Format to 2 decimal places
                    } else if (usedTrafficElement) { console.warn('Used traffic data missing in stats'); }
                      else { console.warn('Used traffic element not found for update'); }

                     // Update Total Traffic text
                     const totalTrafficElement = document.getElementById('total-traffic');
                     if (totalTrafficElement && stats.totalTrafficGB !== undefined) {
                        totalTrafficElement.textContent = `${stats.totalTrafficGB.toFixed(2)} GB کل`; // Format to 2 decimal places
                     } else if (totalTrafficElement) { console.warn('Total traffic data missing in stats'); }
                       else { console.warn('Total traffic element not found for update'); }


                    // Update Progress Bar
                    const progressBar = document.getElementById('traffic-progress-bar');
                    const usagePercentageLabel = document.getElementById('traffic-usage-label'); // Use ID assigned earlier
                     if (progressBar && stats.usagePercentage !== undefined) {
                         const percentage = parseFloat(stats.usagePercentage);
                         progressBar.style.width = `${percentage}%`;
                         progressBar.setAttribute('aria-valuenow', percentage);

                         // Update progress bar color based on percentage
                         progressBar.classList.remove('bg-primary', 'bg-warning', 'bg-danger'); // Remove existing color classes
                         let progressColor = 'primary';
                         if (percentage >= 90) {
                             progressColor = 'danger';
                         } else if (percentage >= 75) {
                             progressColor = 'warning';
                         }
                         progressBar.classList.add(`bg-${progressColor}`);

                         // Update the label text
                         if (usagePercentageLabel) {
                             usagePercentageLabel.textContent = `میزان مصرف ترافیک (${percentage.toFixed(1)}%)`;
                         }

                     } else if (progressBar) { console.warn('Usage percentage data missing in stats'); }
                       else { console.warn('Progress bar element not found for update'); }

                    // Update Remaining Days Badge
                    const remainingDaysBadge = document.querySelector('[data-stat="remaining-days"]');
                     if (remainingDaysBadge && stats.remainingDays !== undefined) {
                        if (stats.remainingDays > 0) {
                           remainingDaysBadge.textContent = `${stats.remainingDays} روز`;
                           remainingDaysBadge.className = 'badge bg-success-subtle text-success ms-1'; // Ensure correct class
                           remainingDaysBadge.dataset.stat = 'remaining-days'; // Keep data attribute
                        } else {
                           remainingDaysBadge.textContent = 'منقضی شده';
                           remainingDaysBadge.className = 'badge bg-danger-subtle text-danger ms-1'; // Update class for expired status
                           remainingDaysBadge.dataset.stat = 'remaining-days'; // Keep data attribute
                        }
                    } else if (remainingDaysBadge) { console.warn('Remaining days data missing in stats'); }
                      else { console.warn('Remaining days element not found for update'); }

                    // Update other elements as needed, e.g., Subscription Name, Expiry Date, etc.
                    // Example (assuming you have elements with these IDs or data attributes):
                    // const expiryDateElement = document.getElementById('subscription-expiry-date');
                    // if (expiryDateElement && stats.expiryDatePersian) {
                    //     expiryDateElement.textContent = stats.expiryDatePersian;
                    // }
                    // const subscriptionNameElement = document.getElementById('subscription-name');
                    // if (subscriptionNameElement && stats.subscriptionName) {
                    //     subscriptionNameElement.textContent = stats.subscriptionName;
                    // }
                }

                // Function to show toast messages (requires a toast library like Toastify or Bootstrap Toasts)
