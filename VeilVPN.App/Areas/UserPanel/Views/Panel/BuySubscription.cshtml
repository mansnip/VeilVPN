@model Domain.ViewModels.UserPanel.SubscriptionModel
@{
    ViewData["Title"] = "خرید اشتراک";
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
}


@await Component.InvokeAsync("CustomizeSubscription", Model)



            <div class="row justify-content-center mt-5">
                <div class="col-lg-8">
                    <div class="text-center mb-4 pb-2">
                        <h4 class="fw-semibold fs-22">سوالات متداول</h4>
                        <p class="text-muted mb-4 fs-15">پاسخ به سوالات رایج درباره خدمات RahaGozar</p>
                    </div>
                </div>
                <!--end col-->
            </div>
            <!--end row-->

            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="accordion accordion-border-box" id="faqAccordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            چگونه می‌توانم اشتراک RahaGozar را خریداری کنم؟
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                                        <div class="accordion-body">
                                            برای خرید اشتراک RahaGozar، کافیست یکی از پلن‌های موجود را انتخاب کرده و روی دکمه "خرید اشتراک" کلیک کنید. سپس وارد صفحه پرداخت شده و پس از تکمیل فرآیند پرداخت، اشتراک شما فعال خواهد شد.
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingTwo">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                            آیا می‌توانم پلن خود را ارتقا دهم؟
                                        </button>
                                    </h2>
                                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                                        <div class="accordion-body">
                                            بله، شما می‌توانید در هر زمان پلن خود را ارتقا دهید. برای این کار، وارد پنل کاربری خود شده و از بخش "اشتراک‌های من" اقدام به ارتقای پلن کنید. هزینه مابه‌التفاوت از شما دریافت خواهد شد.
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingThree">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                            چگونه می‌توانم از RahaGozar در دستگاه‌های مختلف استفاده کنم؟
                                        </button>
                                    </h2>
                                    <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                                        <div class="accordion-body">
                                            پس از خرید اشتراک، می‌توانید از پنل کاربری خود، نرم‌افزار RahaGozar را برای سیستم‌عامل‌های مختلف (ویندوز، مک، اندروید و iOS) دانلود کرده و با استفاده از نام کاربری و رمز عبور خود، در دستگاه‌های مختلف استفاده کنید.
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingFour">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                                            آیا استفاده از RahaGozar قانونی است؟
                                        </button>
                                    </h2>
                                    <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                                        <div class="accordion-body">
                                            استفاده از VPN در اکثر کشورها قانونی است، اما قوانین هر کشور متفاوت است. RahaGozar برای حفظ حریم خصوصی و امنیت آنلاین شما طراحی شده است. لطفاً از قوانین کشور خود مطلع باشید و از VPN برای فعالیت‌های غیرقانونی استفاده نکنید.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

<!-- اسکریپت برای تغییر بین قیمت‌های ماهانه و سالانه -->
<script>
    function togglePricing() {
        const monthlyPrices = document.querySelectorAll('.monthly-price');
        const annualPrices = document.querySelectorAll('.annual-price');
        const planSwitch = document.getElementById('plan-switch');

        monthlyPrices.forEach(price => {
            price.style.display = planSwitch.checked ? 'none' : 'block';
        });

        annualPrices.forEach(price => {
            price.style.display = planSwitch.checked ? 'block' : 'none';
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        // تنظیم اولیه نمایش قیمت‌ها
        togglePricing();
    });
</script>

