@model Domain.ViewModels.UserPanel.InvoiceViewModel
@{
    ViewData["Title"] = "فاکتور #" + Model.InvoiceNumber; // عنوان کوتاه‌تر و استانداردتر
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
    bool isPending = Model.PaymentStatus == "در انتظار پرداخت";
    bool hasCouponApplied = !string.IsNullOrEmpty(Model.AppliedDiscountCode);
    var amountBeforeCoupon = Model.TotalAmount + Model.CouponDiscountAmount;
}

@* --- افزودن Breadcrumb برای ناوبری بهتر --- *@
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">@ViewData["Title"]</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Panel">پنل کاربری</a></li>
                    <li class="breadcrumb-item"><a asp-action="MyInvoices" asp-controller="Panel">فاکتورهای من</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xxl-9">
        <div class="card overflow-hidden" id="invoiceCard">
            @* اضافه کردن overflow-hidden برای گوشه‌های گرد کارت اصلی *@
            @* --- هدر بهبود یافته --- *@
            <div class="card-header bg-primary bg-gradient text-white p-4">
                @* استفاده از پس‌زمینه برای تمایز هدر *@
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <img src="~/assets/images/logo-light.png" class="card-logo" alt="logo light" height="30">
                        <h3 class="text-white mt-2 mb-0">فاکتور</h3>
                    </div>
                    <div class="text-end">
                        <p class="mb-1"><i class="ri-mail-line me-1 align-middle"></i> info@rahagoozar.com</p>
                        <p class="mb-1"><i class="ri-global-line me-1 align-middle"></i> www.rahagoozar.com</p>
                        <p class="mb-0"><i class="ri-phone-line me-1 align-middle"></i> 021-xxxxxxx</p>
                    </div>
                </div>
            </div>

            @* --- اطلاعات اصلی فاکتور با آیکون و چیدمان بهتر --- *@
            <div class="card-body border-bottom border-bottom-dashed p-4">
                <div class="row g-3">
                    <div class="col-lg-3 col-6">
                        <p class="text-muted mb-2 text-uppercase fw-semibold fs-12"><i class="ri-hashtag me-1"></i>شماره فاکتور</p>
                        <h6 class="fs-15 mb-0">#@Model.InvoiceNumber</h6>
                    </div>
                    <div class="col-lg-3 col-6">
                        <p class="text-muted mb-2 text-uppercase fw-semibold fs-12"><i class="ri-calendar-2-line me-1"></i>تاریخ صدور</p>
                        <h6 class="fs-15 mb-0">@Model.InvoiceDate.ToString("yyyy/MM/dd - HH:mm")</h6>
                    </div>
                    <div class="col-lg-3 col-6">
                        <p class="text-muted mb-2 text-uppercase fw-semibold fs-12"><i class="ri-wallet-3-line me-1"></i>وضعیت پرداخت</p>
                        <span class="badge @GetStatusBadgeClass(Model.PaymentStatus) fs-13 p-2">@Model.PaymentStatus</span>
                    </div>
                    <div class="col-lg-3 col-6">
                        <p class="text-muted mb-2 text-uppercase fw-semibold fs-12"><i class="ri-money-dollar-circle-line me-1"></i>مبلغ نهایی</p>
                        <h6 class="fs-15 mb-0">@Model.TotalAmount.ToString("N0") تومان</h6>
                    </div>
                </div>
            </div>

            @* --- اطلاعات پرداخت کننده و اشتراک با آیکون و تفکیک بهتر --- *@
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase fw-semibold fs-13 mb-3"><i class="ri-user-line me-1"></i>اطلاعات پرداخت کننده</h6>
                        <p class="fw-medium mb-2">@Model.UserFullName</p>
                        <p class="text-muted mb-0">@Model.UserEmail <i class="ri-mail-line me-2"></i></p>
                        <p class="text-muted mb-1"><i class="ri-phone-line me-2"></i>@Model.UserPhone</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase fw-semibold fs-13 mb-3"><i class="ri-service-line me-1"></i>اطلاعات اشتراک</h6>
                        <p class="fw-medium mb-2">نام اشتراک :  @Model.RemarkName</p>
                        <p class="text-muted mb-1"><i class="ri-database-2-line me-2"></i>حجم ترافیک: @Model.Subscription.Traffic گیگابایت</p>
                        <p class="text-muted mb-1"><i class="ri-time-line me-2"></i>مدت زمان: @Model.Subscription.Duration روز</p>
                        @if (Model.IsRenewal)
                        {
                            <p class="text-info mb-0 mt-2"><i class="ri-refresh-line me-2"></i><strong>تمدید اشتراک:</strong> @Model.RenewalSubscriptionName</p>
                        }
                    </div>
                </div>
            </div>

            @* --- جدول جزئیات آیتم‌ها با استایل بهبود یافته --- *@
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-borderless table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            @* استفاده از table-light برای هدر *@
                            <tr class="text-muted">
                                @* استفاده از text-muted در هدر *@
                                <th scope="col" style="width: 50px;">#</th>
                                <th scope="col" class="text-start">جزئیات محصول</th>
                                <th scope="col" class="text-end">قیمت واحد</th>
                                <th scope="col" class="text-end">تخفیف پلن</th>
                                <th scope="col" class="text-end">جمع</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">1</th>
                                <td class="text-start">
                                    <span class="fw-medium">@Model.RemarkName</span>
                                    <p class="text-muted mb-0 fs-12">اشتراک @Model.Subscription.Duration روزه با @Model.Subscription.Traffic گیگابایت ترافیک</p>
                                </td>
                                <td class="text-end">@Model.Subscription.BasePrice.ToString("N0") تومان</td>
                                <td class="text-end">
                                    @Model.Subscription.PlanDiscountAmount.ToString("N0") تومان
                                    @if (Model.Subscription.PlanDiscountPercent > 0)
                                    {
                                        <small class="text-muted d-block">(@Model.Subscription.PlanDiscountPercent %)</small>
                                    }
                                </td>
                                <td class="text-end fw-medium">@Model.Subscription.FinalPrice.ToString("N0") تومان</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @* --- بخش خلاصه قیمت و کد تخفیف بازطراحی شده --- *@
            <div class="card-body p-4 border-top border-top-dashed">
                <div class="row justify-content-end">
                    <div class="col-lg-6">
                        <div class="p-3 bg-light rounded">
                            @* کادر مجزا برای خلاصه قیمت *@
                            <table class="table table-borderless table-sm mb-0">
                                <tbody>
                                    <tr>
                                        <td class="fw-medium">جمع کل (قبل از کد تخفیف)</td>
                                        <td class="text-end">@amountBeforeCoupon.ToString("N0") تومان</td>
                                    </tr>
                                    @if (hasCouponApplied)
                                    {
                                        <tr>
                                            <td class="fw-medium">
                                                <i class="ri-coupon-3-line text-success me-1"></i> کد تخفیف <span class="text-muted">(@Model.AppliedDiscountCode)</span>
                                            </td>
                                            <td class="text-end text-danger">
                                                <i class="ri-subtract-line me-1"></i> @Model.CouponDiscountAmount.ToString("N0") تومان
                                                @if (Model.CouponDiscountPercent > 0)
                                                {
                                                    <small class="d-block">(%@Model.CouponDiscountPercent)</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    <tr class="border-top border-top-dashed mt-2 pt-2">
                                        <th scope="row" class="fs-15 fw-bold">مبلغ نهایی قابل پرداخت:</th>
                                        <th class="text-end fs-15 fw-bold">@Model.TotalAmount.ToString("N0") تومان</th>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        @* --- فرم اعمال کد تخفیف با استایل بهتر (input-group) --- *@
                        @if (isPending && !hasCouponApplied)
                        {
                            <div class="mt-4">
                                <h6 class="mb-3">کد تخفیف دارید؟</h6>
                                <form asp-action="ApplyDiscountCode" asp-controller="Panel" method="post">
                                    <input type="hidden" name="invoiceId" value="@Model.Id" />
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="discountCode" placeholder="کد تخفیف خود را وارد کنید" aria-label="کد تخفیف" aria-describedby="applyDiscountBtn">
                                        <button class="btn btn-success" type="submit" id="applyDiscountBtn"><i class="ri-discount-percent-line me-1 align-bottom"></i> اعمال</button>
                                    </div>
                                    <span class="text-warning">@TempData["ErrorMessage"]</span>
                                    <span class="text-success">@TempData["SuccessMessage"]</span>
                                </form>
                            </div>
                        }
                        else if (isPending && hasCouponApplied)
                        {
                            <div class="mt-3 alert alert-success d-flex align-items-center" role="alert">
                                <i class="ri-check-double-line fs-18 me-2"></i>
                                <div>
                                    کد تخفیف <strong>@Model.AppliedDiscountCode</strong> اعمال شده است.
                                    @* افزودن دکمه حذف کد در آینده
                                    <form asp-action="RemoveDiscountCode" method="post" style="display: inline;">
                                        <input type="hidden" name="invoiceId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-2">(حذف کد)</button>
                                    </form>
                                    *@
                                </div>
                            </div>
                        }

                        @* --- نمایش پیام‌های خطا/موفقیت کد تخفیف --- *@
                        @if (TempData["DiscountError"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                                <i class="ri-error-warning-line me-1 align-middle"></i> @TempData["DiscountError"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (TempData["DiscountSuccess"] != null && !hasCouponApplied) // فقط اگر کوپن جدیدا اعمال شده نمایش بده
                        {
                            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                                <i class="ri-check-line me-1 align-middle"></i> @TempData["DiscountSuccess"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* --- یادداشت و دکمه‌های عملیات در فوتر کارت --- *@
            <div class="card-footer bg-light p-4 d-print-none">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="text-muted">
                        <i class="ri-information-line me-1"></i> <span class="fw-semibold">یادداشت:</span> تمامی مبالغ به تومان است.
                    </div>
                    <div class="hstack gap-2 justify-content-end">
                        @if (isPending)
                        {
                            <form asp-area="UserPanel" asp-controller="Panel" asp-action="CancelInvoice" method="post" class="d-inline" onsubmit="return confirm('آیا از لغو این فاکتور اطمینان دارید؟');">
                                <input type="hidden" name="invoiceId" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger"><i class="ri-close-circle-line align-bottom me-1"></i> لغو فاکتور</button>
                            </form>
                            <form asp-area="UserPanel" asp-controller="Panel" asp-action="ProcessPayment" method="post" class="d-inline">
                                <input type="hidden" name="invoiceId" value="@Model.Id" />
                                <button type="submit" class="btn btn-success btn-lg"><i class="ri-paypal-line align-bottom me-1"></i> پرداخت آنلاین</button> @* دکمه پرداخت بزرگتر *@
                            </form>
                        }
                        @if (ViewBag.IsPreview == true)
                        {
                            <form asp-area="UserPanel" asp-controller="Panel" asp-action="CreateInvoice" method="post">
                                <input type="hidden" name="traffic" value="@ViewBag.Traffic" />
                                <input type="hidden" name="duration" value="@ViewBag.Duration" />
                                <input type="hidden" name="remarkName" value="@ViewBag.RemarkName" />

                                <!-- اضافه کردن فیلد مخفی برای شناسه اشتراک در حال تمدید -->
                                @if (ViewBag.IsRenewal == true && !string.IsNullOrEmpty(ViewBag.RenewalId))
                                {
                                    <input type="hidden" name="renewalId" value="@ViewBag.RenewalId" />
                                }

                                <button type="submit" class="btn btn-primary">
                                    @if (ViewBag.IsRenewal == true)
                                    {
                                        <i class="ri-refresh-line align-bottom me-1"></i>
                                        <span>تمدید اشتراک</span>
                                    }
                                    else
                                    {
                                        <i class="ri-shopping-cart-line align-bottom me-1"></i>
                                        <span>خرید اشتراک</span>
                                    }
                                </button>
                            </form>
                        }
                        <a href="javascript:window.print()" class="btn btn-primary"><i class="ri-printer-line align-bottom me-1"></i> چاپ</a>
                        @* <a href="javascript:void(0);" class="btn btn-info"><i class="ri-download-2-line align-bottom me-1"></i> دانلود PDF</a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        // استفاده از کلاس‌های استانداردتر و خواناتر بج بوت‌استرپ 5
        return status switch
        {
            "پرداخت شده" => "badge bg-success-subtle text-success",
            "در انتظار پرداخت" => "badge bg-warning-subtle text-warning",
            "لغو شده" => "badge bg-danger-subtle text-danger",
            "پیش نمایش" => "badge bg-info-subtle text-info",
            _ => "badge bg-secondary-subtle text-secondary",
        };
    }
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
