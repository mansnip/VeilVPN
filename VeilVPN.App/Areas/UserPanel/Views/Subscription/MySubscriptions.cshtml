@model List<Domain.DTOs.VPN.SubscriptionViewModel>
@{
    ViewData["Title"] = "اشتراک‌های من";
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
}

<!-- شروع عنوان صفحه -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">اشتراک‌های من</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">اشتراک VPN</a></li>
                    <li class="breadcrumb-item active">اشتراک‌های من</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<style>
    #connectionLinkModal .modal-body {
        text-align: center;
    }

        #connectionLinkModal .modal-body .d-flex {
            flex-direction: column; /* برای قرار گرفتن دکمه‌ها زیر هم */
        }

        #connectionLinkModal .modal-body button {
            width: 100%; /* عریض شدن دکمه‌ها */
        }
</style>
<!-- شروع بخش کارت اشتراک فعال -->
@if (Model != null && Model.Any(s => s.IsActive && s.HasVpnConnection))
{
    var activeSubscription = Model.FirstOrDefault(s => s.IsActive && s.HasVpnConnection);
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header border-0 align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">اشتراک فعال</h4>
                    <div>
                        <span class="badge @activeSubscription.StatusClass">@activeSubscription.StatusText</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-4">
                            <div class="text-center p-3">
                                <div class="avatar-md mx-auto mb-3">
                                    <div class="avatar-title bg-soft-primary text-primary rounded-circle fs-1">
                                        <i class="ri-wifi-line"></i>
                                    </div>
                                </div>
                                <h5 class="mb-3">@activeSubscription.Traffic گیگابایت / @activeSubscription.Duration روزه</h5>
                                <p class="text-muted mb-0">سرور: @activeSubscription.VpnServerName</p>
                                <p class="text-muted mb-0">نام کاربری: @activeSubscription.VpnEmailName</p>
                                <div class="mt-3">
                                    @if (activeSubscription.VpnRemainingDays.HasValue)
                                    {
                                        <span class="badge bg-light text-muted p-2">
                                            <i class="ri-time-line align-middle me-1"></i> @activeSubscription.VpnRemainingDays روز باقی‌مانده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted p-2">
                                            <i class="ri-time-line align-middle me-1"></i> نامحدود
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-8">
                            <div class="p-3">
                                <div class="row">
                                    <!-- نمایش ترافیک واقعی از سرور VPN -->
                                    <div class="col-md-6 mb-4">
                                        <h5 class="mb-3">ترافیک مصرفی (سرور VPN)</h5>
                                        <div class="progress animated-progress custom-progress progress-label">
                                            <div class="progress-bar @(activeSubscription.VpnUsagePercentage > 80 ? "bg-danger" : "bg-primary")"
                                                 role="progressbar"
                                                 style="width: @activeSubscription.VpnUsagePercentage%"
                                                 aria-valuenow="@activeSubscription.VpnUsagePercentage"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                <div class="label">@activeSubscription.VpnUsagePercentage%</div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between mt-2">
                                            <span class="text-muted small">مصرف شده: @(activeSubscription.Traffic - activeSubscription.VpnRemainingTraffic) GB</span>
                                            <span class="text-muted small">باقی‌مانده: @activeSubscription.VpnRemainingTraffic GB</span>
                                        </div>
                                    </div>
                                    <!-- نمایش زمان باقیمانده از سرور VPN -->
                                    <div class="col-md-6 mb-4">
                                        <h5 class="mb-3">مدت زمان باقیمانده</h5>
                                        @if (activeSubscription.VpnRemainingDays.HasValue)
                                        {
                                            var daysPercentage = (int)((activeSubscription.VpnRemainingDays.Value * 100.0) / activeSubscription.Duration);
                                            <div class="progress animated-progress custom-progress progress-label">
                                                <div class="progress-bar @(daysPercentage < 20 ? "bg-danger" : "bg-success")"
                                                     role="progressbar"
                                                     style="width: @daysPercentage%"
                                                     aria-valuenow="@daysPercentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                    <div class="label">@daysPercentage%</div>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between mt-2">
                                                <span class="text-muted small">گذشته: @(activeSubscription.Duration - activeSubscription.VpnRemainingDays) روز</span>
                                                <span class="text-muted small">باقی‌مانده: @activeSubscription.VpnRemainingDays روز</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info mb-0">
                                                <i class="ri-information-line me-2"></i> زمان نامحدود
                                            </div>
                                        }
                                    </div>
                                </div>
                                <!-- وضعیت اتصال -->
                                <div class="alert @(activeSubscription.IsVpnActive ? "alert-success" : "alert-warning") d-flex align-items-center mb-4">
                                    <i class="@(activeSubscription.IsVpnActive ? "ri-checkbox-circle-line" : "ri-error-warning-line") me-2 fs-4"></i>
                                    <div>
                                        @if (activeSubscription.IsVpnActive)
                                        {
                                            <span>اتصال به سرور VPN برقرار است</span>
                                        }
                                        else
                                        {
                                            <span>وضعیت اشتراک شما غیرفعال می باشد.</span>
                                        }
                                    </div>
                                </div>
                                <!-- دکمه های عملیات -->
                                <div class="mt-4 d-flex justify-content-between">
                                    <div>
                                        <a href="@Url.Action("Index", "Chat", new { area = "UserPanel" })" class="btn btn-outline-warning">
                                            <i class="ri-customer-service-2-line align-bottom me-1"></i> گزارش مشکل
                                        </a>
                                    </div>
                                    <div>
                                        <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel", subscriptionId = activeSubscription.Id })" class="btn btn-outline-info me-2">
                                            <i class="ri-refresh-line align-bottom me-1"></i> تمدید اشتراک
                                        </a>
                                        <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-primary">
                                            <i class="ri-add-line align-bottom me-1"></i> خرید اشتراک جدید
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- شروع لیست اشتراک‌ها -->
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">تاریخچه اشتراک‌ها</h4>
                <div class="flex-shrink-0">
                    <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-primary btn-sm">
                        <i class="ri-add-line align-bottom me-1"></i> خرید اشتراک جدید
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive table-card">
                        <table class="table table-hover align-middle table-nowrap mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">تاریخ شروع</th>
                                    <th scope="col">تاریخ پایان</th>
                                    <th scope="col">ترافیک</th>
                                    <th scope="col">مدت (روز)</th>
                                    <th scope="col">نام اشتراک</th>
                                    <th scope="col">ترافیک باقیمانده</th>
                                    <th scope="col">وضعیت</th>
                                    <th scope="col">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subscription in Model.OrderByDescending(s => s.StartDate))
                                {
                                    <tr>
                                        <td>@subscription.StartDate.ToPersianDate()</td>
                                        <td>@subscription.EndDate.ToPersianDate()</td>
                                        <td>@subscription.Traffic گیگابایت</td>
                                        <td>@subscription.Duration</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(subscription.RemarkName))
                                            {
                                                <span class="badge bg-info-subtle text-info">@subscription.RemarkName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="progress animated-progress progress-sm">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @((subscription.RemainingTraffic * 100) / subscription.Traffic)%" aria-valuenow="@((subscription.RemainingTraffic * 100) / subscription.Traffic)" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <small>@subscription.RemainingTraffic از @subscription.Traffic گیگابایت</small>
                                        </td>
                                        <td>
                                            <span class="badge @subscription.StatusClass">@subscription.StatusText</span>
                                        </td>
                                        <td>
                                            <!-- دکمه های عملیات -->
                                            <div class="hstack gap-2 flex-wrap">
                                                <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#subscriptionDetails-@subscription.Id">
                                                    <i class="ri-eye-line align-bottom"></i> جزئیات
                                                </button>
                                                <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#connectionLinkModal-@subscription.Id">
                                                    <i class="ri-link-m"></i> نمایش لینک اتصال
                                                </button>

                                                @if (subscription.EndDate.AddDays(30) < DateTime.Now || subscription.RemainingTraffic < 30) // نمایش دکمه تمدید اگر کمتر از 30 روز یا کمتر از 30 گیگابایت باقی مانده باشد
                                                {
                                                    <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel", subscriptionId = subscription.Id })" class="btn btn-sm btn-outline-primary">
                                                        <i class="ri-refresh-line align-bottom"></i> تمدید
                                                    </a>
                                                }

                                                <a href="@Url.Action("Index", "Chat", new { area = "UserPanel" })" class="btn btn-sm btn-outline-warning">
                                                    <i class="ri-customer-service-2-line align-bottom me-1"></i> پشتیبانی
                                                </a>
                                            </div>
                                            <style>
                                                #qrcode- @subscription.Id {
                                                    display: flex;
                                                    justify-content: center; /* مرکز کردن به صورت افقی */
                                                    align-items: center; /* مرکز کردن به صورت عمودی (در صورت نیاز) */
                                                }
                                            </style>
                                            <!-- مودال لینک اتصال -->
                                            <div class="modal fade" id="connectionLinkModal-@subscription.Id" tabindex="-1" aria-labelledby="connectionLinkModalLabel-@subscription.Id" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">لینک اتصال اشتراک</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-center">
                                                            <!-- QR Code -->
                                                            <div id="qrcode-@subscription.Id"
                                                                 class="mb-3 d-flex justify-content-center qrcode-container" @* کلاس qrcode-container اضافه شد *@
                                                                 data-link="@subscription.SubscriptionLink" @* لینک اشتراک به عنوان دیتا اتریبیوت اضافه شد *@
                                                                 data-subid="@subscription.Id">
                                                                @* آی‌دی اشتراک برای لاگ و اشکال‌زدایی *@
                                                                <!-- QR Code توسط جاوا اسکریپت در اینجا ایجاد می‌شود -->
                                                                <div class="spinner-border text-primary" role="status">
                                                                    <span class="visually-hidden">در حال بارگذاری QR Code...</span>
                                                                </div>
                                                            </div>
                                                            <p class="text-muted small">(برای کپی لینک بر روی QR Code کلیک کنید)</p> @* راهنمای بهتر *@

                                                            <!-- دکمه‌های آموزشی -->
                                                            <div class="tutorial-buttons d-flex flex-column gap-2 mt-4">
                                                                @* لینک‌های آموزشی خود را اینجا قرار دهید *@
                                                                <button class="btn btn-info btn-lg" onclick="window.open('YOUR_WINDOWS_TUTORIAL_URL', '_blank')"> <i class="ri-windows-fill align-middle"></i> آموزش ویندوز</button>
                                                                <button class="btn btn-success btn-lg" onclick="window.open('YOUR_ANDROID_TUTORIAL_URL', '_blank')"><i class="ri-android-fill align-middle"></i> آموزش اندروید</button>
                                                                <button class="btn btn-secondary btn-lg" onclick="window.open('YOUR_IOS_TUTORIAL_URL', '_blank')"><i class="ri-apple-fill align-middle"></i> آموزش iOS</button>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">بستن</button>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>

                                            <!-- مدال جزئیات -->
                                            <div class="modal fade" id="subscriptionDetails-@subscription.Id" tabindex="-1" aria-labelledby="subscriptionDetailsLabel-@subscription.Id" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="subscriptionDetailsLabel-@subscription.Id">جزئیات اشتراک</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="table-responsive">
                                                                <table class="table table-borderless mb-0">
                                                                    <tbody>
                                                                        <tr>
                                                                            <th>شناسه اشتراک:</th>
                                                                            <td>@subscription.Id</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>نوع اشتراک:</th>
                                                                            <td>@subscription.Traffic گیگابایت / @subscription.Duration روزه</td>
                                                                        </tr>
                                                                        @if (!string.IsNullOrEmpty(subscription.RemarkName))
                                                                        {
                                                                            <tr>
                                                                                <th>نام اشتراک:</th>
                                                                                <td>@subscription.RemarkName</td>
                                                                            </tr>
                                                                        }
                                                                        <tr>
                                                                            <th>تاریخ شروع:</th>
                                                                            <td>@subscription.StartDate.ToPersianDate()</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>تاریخ پایان:</th>
                                                                            <td>@subscription.EndDate.ToPersianDate()</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>ترافیک کل:</th>
                                                                            <td>@subscription.Traffic گیگابایت</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>ترافیک مصرف شده:</th>
                                                                            <td>@(subscription.Traffic - subscription.RemainingTraffic) گیگابایت</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>ترافیک باقیمانده:</th>
                                                                            <td>@subscription.RemainingTraffic گیگابایت</td>
                                                                        </tr>
                                                                        @if (!string.IsNullOrEmpty(subscription.VpnServerName))
                                                                        {
                                                                            <tr>
                                                                                <th>سرور VPN:</th>
                                                                                <td>@subscription.VpnServerName</td>
                                                                            </tr>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(subscription.VpnEmailName))
                                                                        {
                                                                            <tr>
                                                                                <th>نام کاربری VPN:</th>
                                                                                <td>@subscription.VpnEmailName</td>
                                                                            </tr>
                                                                        }
                                                                        <tr>
                                                                            <th>وضعیت:</th>
                                                                            <td>
                                                                                <span class="badge @subscription.StatusClass">@subscription.StatusText</span>
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                        
                                                        <div class="modal-footer">
                                                            <div class="hstack gap-2 justify-content-end flex-wrap">
                                                                @if (subscription.EndDate.AddDays(30) < DateTime.Now || subscription.RemainingTraffic < 30)
                                                                {
                                                                    <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel", subscriptionId = subscription.Id })" class="btn btn-outline-primary">
                                                                        <i class="ri-refresh-line align-bottom me-1"></i> تمدید اشتراک
                                                                    </a>
                                                                }
                                                                <a href="@Url.Action("SupportRequest", "Panel", new { area = "UserPanel", subscriptionId = subscription.Id })" class="btn btn-outline-warning">
                                                                    <i class="ri-customer-service-2-line align-bottom me-1"></i> پشتیبانی
                                                                </a>
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">بستن</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center p-4">
                        <div class="avatar-md mx-auto mb-4">
                            <div class="avatar-title bg-light text-danger rounded-circle">
                                <i class="ri-information-line fs-1"></i>
                            </div>
                        </div>
                        <h4 class="mb-3">هیچ اشتراکی یافت نشد!</h4>
                        <p class="text-muted mb-4">شما تا به حال هیچ اشتراکی خریداری نکرده‌اید.</p>
                        <div>
                            <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-success">خرید اشتراک</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- پایان لیست اشتراک‌ها -->
<!-- راهنمای اشتراک -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">سوالات متداول درباره اشتراک</h4>
            </div>
            <div class="card-body">
                <div class="accordion custom-accordionwithicon accordion-flush" id="accordionFlushExample">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="flush-headingOne">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                                چگونه اشتراک RahaGozar را خریداری کنم؟
                            </button>
                        </h2>
                        <div id="flush-collapseOne" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
                            <div class="accordion-body">
                                برای خرید اشتراک، ابتدا یکی از طرح‌های موجود را انتخاب کرده و روی دکمه "خرید اشتراک" کلیک کنید. سپس مراحل پرداخت را تکمیل نمایید. پس از تأیید پرداخت، اشتراک شما بلافاصله فعال می‌شود و می‌توانید از خدمات RahaGozar استفاده کنید.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="flush-headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseTwo" aria-expanded="false" aria-controls="flush-collapseTwo">
                                آیا می‌توانم طرح اشتراک خود را ارتقا دهم؟
                            </button>
                        </h2>
                        <div id="flush-collapseTwo" class="accordion-collapse collapse" aria-labelledby="flush-headingTwo" data-bs-parent="#accordionFlushExample">
                            <div class="accordion-body">
                                بله، شما می‌توانید در هر زمان طرح اشتراک خود را ارتقا دهید. برای این کار، به پنل کاربری خود مراجعه کرده و از بخش "اشتراک‌های من" اقدام به خرید اشتراک جدید کنید. تفاوت قیمت بین طرح فعلی و طرح جدید از شما دریافت خواهد شد.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="flush-headingThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseThree" aria-expanded="false" aria-controls="flush-collapseThree">
                                چگونه می‌توانم از RahaGozar در چند دستگاه استفاده کنم؟
                            </button>
                        </h2>
                        <div id="flush-collapseThree" class="accordion-collapse collapse" aria-labelledby="flush-headingThree" data-bs-parent="#accordionFlushExample">
                            <div class="accordion-body">
                                پس از خرید اشتراک، می‌توانید نرم‌افزار RahaGozar را برای سیستم‌عامل‌های مختلف (ویندوز، مک، اندروید، iOS) دانلود کرده و با استفاده از اطلاعات کاربری خود وارد شوید. شما می‌توانید همزمان در چند دستگاه از RahaGozar استفاده کنید، اما توجه داشته باشید که میزان ترافیک مصرفی در همه دستگاه‌ها محاسبه می‌شود.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="flush-headingFour">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseFour" aria-expanded="false" aria-controls="flush-collapseFour">
                                آیا استفاده از RahaGozar قانونی است؟
                            </button>
                        </h2>
