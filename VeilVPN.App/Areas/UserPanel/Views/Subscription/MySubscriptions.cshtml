<!-- پایان راهنمای اشتراک -->
@section Scripts {
    @* <script src="~/lib/qrcode/qrcode.min.js" type="text/javascript"></script> *@
@* کتابخانه qrcode.js از CDN *@
    <script src="~/lib/qrcode.min.js" type="text/javascript"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // انتخاب همه مودال‌های لینک اتصال با استفاده از بخشی از ID
            const subscriptionModals = document.querySelectorAll('[id^="connectionLinkModal-"]');

            subscriptionModals.forEach(modalElement => {
                // اضافه کردن Listener برای رویداد 'show.bs.modal' (زمانی که مودال شروع به باز شدن می‌کند)
                modalElement.addEventListener('show.bs.modal', function (event) {
                    const modal = event.target; // مودالی که در حال باز شدن است
                    // پیدا کردن محفظه QR Code *داخل* این مودال خاص
                    const qrContainer = modal.querySelector('.qrcode-container');

                    if (!qrContainer) {
                        console.error("محفظه QR Code با کلاس '.qrcode-container' در مودال پیدا نشد:", modal.id);
                        return; // خروج از تابع اگر محفظه پیدا نشد
                    }

                    // بررسی اینکه آیا QR Code قبلاً تولید شده است (برای جلوگیری از تولید مجدد)
                    // qrcode.js معمولا یک تگ <canvas> یا <img> ایجاد می‌کند.
                    if (qrContainer.querySelector('canvas') || qrContainer.querySelector('img')) {
                        // console.log("QR Code قبلاً برای این مودال تولید شده است:", qrContainer.id);
                        return; // اگر از قبل وجود دارد، کاری انجام نده
                    }

                    // خواندن لینک از data attribute
                    const link = qrContainer.getAttribute('data-link');
                    const subId = qrContainer.getAttribute('data-subid'); // برای لاگ

                    if (link && link.trim() !== '') {
                        try {
                            // پاک کردن محتوای قبلی (مثل اسپینر لودینگ یا پیام خطا)
                            qrContainer.innerHTML = '';

                            // ایجاد QR Code جدید
                            var qrcode = new QRCode(qrContainer, {
                                text: link,        // لینک اشتراک
                                width: 300,        // عرض QR Code به پیکسل
                                height: 300,       // ارتفاع QR Code به پیکسل
                                colorDark: "#000000", // رنگ اصلی کد
                                colorLight: "#ffffff", // رنگ پس‌زمینه
                                correctLevel: QRCode.CorrectLevel.M // سطح تصحیح خطا (H بالاترین و برای اسکن از صفحه بهتر است)
                            });

                            // --- افزودن قابلیت کپی با کلیک ---
                            qrContainer.style.cursor = 'pointer';
                            // حذف listener قبلی اگر وجود داشت (برای اطمینان)
                            qrContainer.onclick = null;
                            // اضافه کردن listener جدید
                            qrContainer.onclick = function() {
                                navigator.clipboard.writeText(link).then(function() {
                                    // *** نمایش ALERT موفقیت آمیز ***
                                    alert('لینک اتصال با موفقیت در کلیپ‌بورد کپی شد!');
                                    // ******************************

                                }, function(err) {
                                    console.error('خطا در کپی لینک اتصال: ', err);
                                    // *** نمایش ALERT خطا ***
                                    alert('خطا در کپی لینک. لطفا بررسی کنید مرورگر شما اجازه دسترسی به کلیپ‌بورد را می‌دهد یا به صورت دستی لینک را از بخش مربوطه کپی کنید.');
                                    // *************************
                                });
                            };
                            // --- پایان قابلیت کپی با کلیک ---

                        } catch (e) {
                            console.error(`خطا در تولید QR Code برای اشتراک ${subId}:`, e);
                            // نمایش پیام خطا در محفظه QR Code
                            qrContainer.innerHTML = '<p class="text-danger small mt-2">خطا در نمایش QR Code</p>';
                        }
                    } else {
                        // اگر لینک خالی یا ناموجود بود
                        console.warn(`لینک اتصال برای QR Code اشتراک ${subId} یافت نشد یا خالی است.`);
                        qrContainer.innerHTML = '<p class="text-muted small mt-2">لینک اتصال برای این اشتراک موجود نیست.</p>';
                    }
                });
            });
        });
    </script>

    <!-- سفارشی کردن متن آکاردئون -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // برای اصلاح نمایش اکاردئون
            var accordionButtons = document.querySelectorAll('.accordion-button');
            accordionButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    setTimeout(function() {
                        window.dispatchEvent(new Event('resize'));
                    }, 300);
                });
            });
        });
    </script>
}