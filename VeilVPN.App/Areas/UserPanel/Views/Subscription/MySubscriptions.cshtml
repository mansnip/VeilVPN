@model List<Domain.DTOs.VPN.SubscriptionViewModel>
@{
    ViewData["Title"] = "اشتراک‌های من";
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
    // پیدا کردن اولین اشتراک فعال برای نمایش در کارت ویژه
    var activeSubscription = Model?.FirstOrDefault(s => s.IsActive && s.HasVpnConnection && s.StatusText == "فعال");
}

<!-- شروع عنوان صفحه -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">اشتراک‌های من</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Panel", new { area = "UserPanel" })">پنل کاربری</a></li>
                    <li class="breadcrumb-item active">اشتراک‌های من</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- [شروع] کارت اشتراک فعال (در صورت وجود) -->
@if (activeSubscription != null)
{
    <div class="row">
        <div class="col-xl-12">
            <div class="card border border-success shadow-sm">
                @* کمی برجسته تر *@
                <div class="card-header bg-success-subtle border-0 align-items-center d-flex">
                    @* هدر با رنگ ملایم *@
                    <h4 class="card-title mb-0 flex-grow-1 text-success">
                        <i class="ri-shield-check-line align-middle me-1"></i> اشتراک فعال شما
                    </h4>
                    <div>
                        <span class="badge fs-6 @activeSubscription.StatusClass">
                            @* کمی بزرگتر *@
                            <i class="ri-check-double-line align-middle"></i> @activeSubscription.StatusText
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    @* کمی پدینگ بیشتر *@
                    <div class="row gy-4">
                        @* اضافه کردن فاصله عمودی بین ردیف‌ها در حالت موبایل *@
                        <!-- بخش اطلاعات کلی -->
                        <div class="col-lg-4 col-md-6">
                            <div class="text-center p-3 border rounded h-100 d-flex flex-column justify-content-center">
                                @* کادر و چیدمان بهتر *@
                                <div class="avatar-md mx-auto mb-3">
                                    <div class="avatar-title bg-primary-subtle text-primary rounded-circle fs-1">
                                        <i class="ri-wifi-fill"></i> @* آیکون پررنگ تر *@
                                    </div>
                                </div>
                                <h5 class="mb-2">@activeSubscription.Traffic گیگابایت / @activeSubscription.Duration روزه</h5>
                                @if (!string.IsNullOrEmpty(activeSubscription.RemarkName))
                                {
                                    <p class="text-info mb-2">نام: @activeSubscription.RemarkName</p>
                                }
                                <p class="text-muted mb-1 small">سرور: @activeSubscription.VpnServerName</p>
                                <p class="text-muted mb-3 small">نام کاربری: @activeSubscription.VpnEmailName</p>
                                <div class="mt-auto">
                                    @* قرار دادن در پایین *@
                                    @if (activeSubscription.VpnRemainingDays.HasValue)
                                    {
                                        <span class="badge bg-light text-dark p-2 border">
                                            @* با بوردر *@
                                            <i class="ri-calendar-2-line align-middle me-1"></i> @activeSubscription.VpnRemainingDays روز باقی‌مانده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark p-2 border">
                                            <i class="ri-infinity-line align-middle me-1"></i> زمان نامحدود
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- بخش جزئیات مصرف و زمان -->
                        <div class="col-lg-8 col-md-6">
                            <div class="p-3">
                                <div class="row">
                                    <!-- ترافیک مصرفی -->
                                    <div class="col-md-6 mb-4">
                                        <h6 class="mb-3 fw-semibold">
                                            <i class="ri-database-2-line align-middle me-1 text-primary"></i> ترافیک مصرفی (بر اساس سرور)
                                        </h6>
                                        <div class="progress animated-progress custom-progress progress-label mb-2">
                                            <div class="progress-bar @(activeSubscription.VpnUsagePercentage > 85 ? "bg-danger" : (activeSubscription.VpnUsagePercentage > 60 ? "bg-warning" : "bg-primary"))"
                                                 role="progressbar" style="width: @activeSubscription.VpnUsagePercentage%"
                                                 aria-valuenow="@activeSubscription.VpnUsagePercentage" aria-valuemin="0" aria-valuemax="100">
                                                <div class="label">@activeSubscription.VpnUsagePercentage%</div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between text-muted small">
                                            <span><i class="ri-download-2-line"></i> مصرف: @String.Format("{0:0.##}", activeSubscription.Traffic - activeSubscription.VpnRemainingTraffic) GB</span>
                                            <span><i class="ri-stack-line"></i> مانده: @String.Format("{0:0.##}", activeSubscription.VpnRemainingTraffic) GB</span>
                                        </div>
                                    </div>
                                    <!-- زمان باقیمانده -->
                                    <div class="col-md-6 mb-4">
                                        <h6 class="mb-3 fw-semibold">
                                            <i class="ri-time-line align-middle me-1 text-success"></i> زمان باقیمانده
                                        </h6>
                                        @if (activeSubscription.VpnRemainingDays.HasValue && activeSubscription.Duration > 0)
                                        {
                                            var daysPercentage = 100 - (int)(((double)(activeSubscription.Duration - activeSubscription.VpnRemainingDays.Value) / activeSubscription.Duration) * 100);
                                            if (daysPercentage < 0) daysPercentage = 0;
                                            if (daysPercentage > 100) daysPercentage = 100; // اطمینان از محدوده

                                            <div class="progress animated-progress custom-progress progress-label mb-2">
                                                <div class="progress-bar @(daysPercentage < 15 ? "bg-danger" : (daysPercentage < 40 ? "bg-warning" : "bg-success"))"
                                                     role="progressbar" style="width: @daysPercentage%"
                                                     aria-valuenow="@daysPercentage" aria-valuemin="0" aria-valuemax="100">
                                                    <div class="label">@daysPercentage%</div>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between text-muted small">
                                                <span><i class="ri-skip-right-line"></i> گذشته: @(activeSubscription.Duration - activeSubscription.VpnRemainingDays) روز</span>
                                                <span><i class="ri-timer-line"></i> مانده: @activeSubscription.VpnRemainingDays روز</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info py-2 mb-0">
                                                @* استایل بهتر برای نامحدود *@
                                                <i class="ri-information-line me-1"></i> زمان نامحدود
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- وضعیت اتصال -->
                                <div class="alert @(activeSubscription.IsVpnActive ? "alert-success" : "alert-danger") d-flex align-items-center p-2 mb-4">
                                    @* قرمز برای غیرفعال *@
                                    <i class="@(activeSubscription.IsVpnActive ? "ri-shield-check-line" : "ri-error-warning-line") me-2 fs-5"></i>
                                    <div class="fw-medium">
                                        @if (activeSubscription.IsVpnActive)
                                        {
                                            <span>اتصال به سرور VPN برقرار و فعال است.</span>
                                        }
                                        else
                                        {
                                            <span>اتصال به سرور برقرار نیست یا اشتراک غیرفعال است.</span>
                                        }
                                    </div>
                                </div>

                                <!-- دکمه های عملیات -->
                                <div class="mt-4 d-flex justify-content-end flex-wrap gap-2">
                                    @* چیدمان از راست و فاصله *@
                                    <a href="@Url.Action("Index", "Chat", new { area = "UserPanel" })" class="btn btn-outline-warning">
                                        <i class="ri-question-line align-bottom me-1"></i> پشتیبانی / گزارش مشکل
                                    </a>
                                    <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel", subscriptionId = activeSubscription.Id })" class="btn btn-outline-info">
                                        <i class="ri-refresh-line align-bottom me-1"></i> تمدید اشتراک
                                    </a>
                                    @* --- دکمه جدید نمایش لینک اتصال برای کارت فعال --- *@
                                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#connectionLinkModal-@activeSubscription.Id">
                                        <i class="ri-link-m align-bottom me-1"></i> نمایش لینک اتصال
                                    </button>
                                    <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-primary">
                                        <i class="ri-add-circle-line align-bottom me-1"></i> خرید اشتراک جدید
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- [پایان] کارت اشتراک فعال -->
<!-- [شروع] لیست کامل اشتراک‌ها -->
<div class="row">
    <div class="col-xl-12">
        <div class="card @(activeSubscription == null ? "mt-0" : "mt-4")">
            @* اگر کارت فعال نبود، مارجین بالا نده *@
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">
                    <i class="ri-list-check-2 align-middle me-1"></i> لیست کامل اشتراک‌ها
                </h4>
                <div class="flex-shrink-0">
                    <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-primary btn-sm">
                        <i class="ri-add-line align-bottom me-1"></i> خرید اشتراک جدید
                    </a>
                </div>
            </div>
            <div class="card-body pt-0">
                @* حذف پدینگ بالا برای چسبیدن به هدر *@
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive table-card mt-3">
                        @* کمی مارجین بالا *@
                        <table class="table table-hover table-striped align-middle table-nowrap mb-0">
                            @* اضافه کردن استایل striped *@
                            <thead class="table-light text-muted">
                                @* رنگ متن هدر *@
                                <tr>
                                    <th>تاریخ شروع</th>
                                    <th>تاریخ پایان</th>
                                    <th>طرح (ترافیک/مدت)</th>
                                    <th>نام اشتراک</th>
                                    <th>ترافیک باقیمانده (دیتابیس)</th> @* مشخص کردن منبع ترافیک *@
                                    <th>وضعیت</th>
                                    <th style="width: 280px;">عملیات</th> @* کمی عرض بیشتر برای دکمه ها *@
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subscription in Model.OrderByDescending(s => s.StartDate))
                                {
                                    var isCurrentActive = activeSubscription != null && subscription.Id == activeSubscription.Id;
                                    <tr class="@(isCurrentActive ? "table-success" : "")">
                                        @* هایلایت ردیف فعال *@
                                        <td>@subscription.StartDate.ToPersianDate()</td>
                                        <td>@subscription.EndDate.ToPersianDate()</td>
                                        <td>@subscription.Traffic گیگ / @subscription.Duration روز</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(subscription.RemarkName))
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis">@subscription.RemarkName</span> @* رنگ بهتر *@
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                        <td class="usage-info-cell">
                                            @* کلاس برای این سلول *@
                                            @if (subscription.Traffic > 0)
                                            {
                                                var initialPercent = subscription.HasVpnConnection ? subscription.VpnUsagePercentage : (int)(((double)(subscription.Traffic - subscription.RemainingTraffic) / subscription.Traffic) * 100);
                                                if (initialPercent < 0) initialPercent = 0; if (initialPercent > 100) initialPercent = 100;
                                                var initialRemaining = subscription.HasVpnConnection ? subscription.VpnRemainingTraffic : subscription.RemainingTraffic;
                                                var initialUsed = subscription.Traffic - initialRemaining;

                                                <div class="progress animated-progress custom-progress progress-label mb-1" style="height: 18px;">
                                                    <div class="progress-bar usage-progress-bar @(initialPercent > 85 ? "bg-danger" : (initialPercent > 60 ? "bg-warning" : "bg-primary"))"
                                                         role="progressbar" style="width: @initialPercent%" aria-valuenow="@initialPercent" aria-valuemin="0" aria-valuemax="100">
                                                        <div class="label usage-progress-label">@initialPercent%</div>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between small text-muted">
                                                    <span>مصرف: <span class="usage-used">@String.Format("{0:0.##}", initialUsed) GB</span></span>
                                                    <span>مانده: <span class="usage-remaining fw-bold">@String.Format("{0:0.##}", initialRemaining) GB</span></span>
                                                </div>
                                                <div class="text-center mt-1 spinner-grow spinner-grow-sm text-secondary usage-loader" role="status" style="display: none;">
                                                    <span class="visually-hidden">...</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border"><i class="ri-infinity-line"></i> نامحدود</span>
                                                <div class="usage-loader" style="display: none;"></div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge fs-base @subscription.StatusClass">@subscription.StatusText</span> @* متن کمی بزرگتر *@
                                        </td>
                                        <td>
                                            <!-- دکمه های عملیات -->
                                            <div class="hstack gap-1 flex-wrap">
                                                @* کاهش فاصله *@
                                                <button type="button" class="btn btn-sm btn-soft-primary" data-bs-toggle="modal" data-bs-target="#subscriptionDetails-@subscription.Id" title="نمایش جزئیات">
                                                    <i class="ri-eye-line"></i> جزئیات
                                                </button>
                                                @if (subscription.HasVpnConnection && !string.IsNullOrEmpty(subscription.SubscriptionLink)) // فقط اگر لینک وجود دارد نمایش بده
                                                {
                                                    <button type="button" class="btn btn-sm btn-soft-success" data-bs-toggle="modal" data-bs-target="#connectionLinkModal-@subscription.Id" title="نمایش لینک اتصال">
                                                        <i class="ri-link-m"></i> لینک
                                                    </button>
                                                }

                                                <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel", subscriptionId = subscription.Id })" class="btn btn-sm btn-soft-info" title="تمدید اشتراک">
                                                    <i class="ri-refresh-line"></i> تمدید
                                                </a>
                                                <a href="@Url.Action("Index", "Chat", new { area = "UserPanel" })" class="btn btn-sm btn-soft-warning" title="پشتیبانی و گزارش مشکل">
                                                    <i class="ri-question-line"></i> پشتیبانی
                                                </a>
                                            </div>

                                            <!-- [شروع] مودال لینک اتصال (برای هر ردیف) -->
                                            @if (subscription.HasVpnConnection && !string.IsNullOrEmpty(subscription.SubscriptionLink))
                                            {
                                                <div class="modal fade" id="connectionLinkModal-@subscription.Id" tabindex="-1" aria-labelledby="connectionLinkModalLabel-@subscription.Id" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title" id="connectionLinkModalLabel-@subscription.Id">
                                                                    <i class="ri-link align-middle me-1"></i> لینک اتصال اشتراک @(!string.IsNullOrEmpty(subscription.RemarkName) ? $"({subscription.RemarkName})" : "")
                                                                </h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body text-center">
                                                                <!-- QR Code Container -->
                                                                <div class="mb-3 d-inline-block p-2 border rounded bg-light qrcode-container" @* استایل بهتر و کلاس *@
                                                                     data-link="@subscription.SubscriptionLink"
                                                                     data-subid="@subscription.Id"
                                                                     style="cursor: pointer;" @* نشان دادن قابلیت کلیک *@
                                                                     title="برای کپی لینک کلیک کنید">
                                                                    <div id="qrcode-@subscription.Id">
                                                                        <!-- QR Code توسط جاوا اسکریپت در اینجا ایجاد می‌شود -->
                                                                        <div class="spinner-border text-primary" role="status">
                                                                            <span class="visually-hidden">در حال بارگذاری QR Code...</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <p class="text-muted small mb-4">برای کپی لینک، روی QR Code کلیک کنید.</p>

                                                                <!-- دکمه‌های آموزش -->
                                                                <h6 class="mb-3">راهنمای اتصال</h6>
                                                                <div class="d-flex justify-content-center flex-wrap gap-2">
                                                                    @* لینک‌های آموزشی واقعی خود را اینجا قرار دهید *@
                                                                    <a class="btn btn-outline-info" href="~/UserPanel/Tutorials/Index"><i class="ri-windows-fill align-middle me-1"></i> ویندوز</a>
                                                                    <a class="btn btn-outline-success" href="~/UserPanel/Tutorials/Index"><i class="ri-android-fill align-middle me-1"></i> اندروید</a>
                                                                    <a class="btn btn-outline-dark" href="~/UserPanel/Tutorials/Index"><i class="ri-apple-fill align-middle me-1"></i> آیفون (iOS)</a>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">بستن</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            <!-- [پایان] مودال لینک اتصال -->
                                            <!-- [شروع] مدال جزئیات (برای هر ردیف) -->
                                            <div class="modal fade" id="subscriptionDetails-@subscription.Id" tabindex="-1" aria-labelledby="subscriptionDetailsLabel-@subscription.Id" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                                    @* کمی بزرگتر برای نمایش بهتر *@
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="subscriptionDetailsLabel-@subscription.Id">
                                                                <i class="ri-information-line align-middle me-1"></i> جزئیات اشتراک @(!string.IsNullOrEmpty(subscription.RemarkName) ? $"({subscription.RemarkName})" : "")
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="table-responsive">
                                                                <table class="table table-bordered table-sm mb-0">
                                                                    @* بوردر و کوچک‌تر *@
                                                                    <tbody>
                                                                        <tr>
                                                                            <th class="bg-light" style="width: 180px;">شناسه سیستم:</th>
                                                                            <td><code>@subscription.Id</code></td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th class="bg-light">طرح اشتراک:</th>
                                                                            <td>@subscription.Traffic گیگابایت / @subscription.Duration روزه</td>
                                                                        </tr>
                                                                        @if (!string.IsNullOrEmpty(subscription.RemarkName))
                                                                        {
                                                                            <tr>
                                                                                <th class="bg-light">نام اشتراک:</th>
                                                                                <td>@subscription.RemarkName</td>
                                                                            </tr>
                                                                        }
                                                                        <tr>
                                                                            <th class="bg-light">تاریخ شروع:</th>
                                                                            <td>@subscription.StartDate.ToPersianDate()</td> @* نمایش زمان *@
                                                                        </tr>
                                                                        <tr>
                                                                            <th class="bg-light">تاریخ پایان:</th>
                                                                            <td>@subscription.EndDate.ToPersianDate()</td> @* نمایش زمان *@
                                                                        </tr>
                                                                        <tr>
                                                                            <th class="bg-light">وضعیت فعلی:</th>
                                                                            <td>
                                                                                <span class="badge fs-base @subscription.StatusClass">@subscription.StatusText</span>
                                                                            </td>
                                                                        </tr>
                                                                        @* --- نمایش اطلاعات VPN فقط در صورت وجود --- *@
                                                                        @if (subscription.HasVpnConnection)
                                                                        {
                                                                            <tr>
                                                                                <th class="bg-light">سرور VPN:</th>
                                                                                <td>@subscription.VpnServerName</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th class="bg-light">نام کاربری VPN:</th>
                                                                                <td>@subscription.VpnEmailName</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th class="bg-light">وضعیت اتصال VPN:</th>
                                                                                <td>
                                                                                    @if (subscription.IsVpnActive)
                                                                                    {
                                                                                        <span class="badge bg-success-subtle text-success-emphasis"><i class="ri-shield-check-line align-middle"></i> فعال</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge bg-danger-subtle text-danger-emphasis"><i class="ri-error-warning-line align-middle"></i> غیر فعال / قطع</span>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th class="bg-light">کل ترافیک (سرور):</th>
                                                                                <td>@subscription.Traffic GB</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th class="bg-light">ترافیک مصرف شده (سرور):</th>
                                                                                <td>@String.Format("{0:0.##}", subscription.Traffic - subscription.VpnRemainingTraffic) GB</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th class="bg-light">ترافیک باقیمانده (سرور):</th>
                                                                                <td><span class="fw-bold text-primary">@String.Format("{0:0.##}", subscription.VpnRemainingTraffic) GB</span></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th class="bg-light">زمان باقیمانده (سرور):</th>
                                                                                <td>
                                                                                    @if (subscription.VpnRemainingDays.HasValue)
                                                                                    {
                                                                                        <span class="fw-bold text-success">@subscription.VpnRemainingDays روز</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge bg-info-subtle text-info-emphasis">نامحدود</span>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th class="bg-light">لینک اتصال:</th>
                                                                                <td>
                                                                                    @if (!string.IsNullOrEmpty(subscription.SubscriptionLink))
                                                                                    {
                                                                                        <code style="word-break: break-all; direction: ltr; text-align:left;">@subscription.SubscriptionLink</code>
                                                                                        <button class="btn btn-sm btn-soft-secondary ms-2 p-1" onclick="navigator.clipboard.writeText('@subscription.SubscriptionLink'); alert('لینک کپی شد!')" title="کپی لینک">
                                                                                            <i class="ri-file-copy-line"></i>
                                                                                        </button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted small">لینک موجود نیست</span>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                        else // اگر HasVpnConnection false بود
                                                                        {
                                                                            <tr>
                                                                                <td colspan="2" class="text-center text-muted py-3">
                                                                                    <i class="ri-loader-2-line fs-4 align-middle me-1"></i> در حال حاضر اطلاعات اتصال VPN برای این اشتراک در دسترس نیست (ممکن است در حال آماده‌سازی باشد).
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                        @* --- پایان اطلاعات VPN --- *@

                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <div class="hstack gap-2 justify-content-end flex-wrap">
                                                                @* --- دکمه جدید نمایش لینک اتصال در مودال جزئیات --- *@
                                                                @if (subscription.HasVpnConnection && !string.IsNullOrEmpty(subscription.SubscriptionLink))
                                                                {
                                                                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#connectionLinkModal-@subscription.Id" title="نمایش لینک و QR Code">
                                                                        <i class="ri-link-m align-bottom me-1"></i> نمایش لینک اتصال
                                                                    </button>
                                                                }

                                                                <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel", subscriptionId = subscription.Id })" class="btn btn-info">
                                                                    <i class="ri-refresh-line align-bottom me-1"></i> تمدید اشتراک
                                                                </a>
                                                                <a href="@Url.Action("Index", "Chat", new { area = "UserPanel" })" class="btn btn-warning">
                                                                    <i class="ri-question-line align-bottom me-1"></i> پشتیبانی / گزارش مشکل
                                                                </a>
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">بستن</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- [پایان] مدال جزئیات -->
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <!-- پیام عدم وجود اشتراک -->
                    <div class="text-center p-4 border rounded mt-4 bg-light">
                        @* ظاهر بهتر *@
                        <div class="avatar-md mx-auto mb-4">
                            <div class="avatar-title bg-danger-subtle text-danger rounded-circle fs-1">
                                @* رنگ ملایم‌تر *@
                                <i class="ri-folder-zip-line"></i> @* آیکون مرتبط‌تر *@
                            </div>
                        </div>
                        <h4 class="mb-3">هیچ اشتراکی یافت نشد!</h4>
                        <p class="text-muted mb-4">شما تا به حال هیچ اشتراکی خریداری نکرده‌اید یا اشتراک‌های قبلی شما منقضی شده‌اند.</p>
                        <div>
                            <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-success btn-lg">
                                <i class="ri-shopping-cart-line align-middle me-1"></i> خرید اولین اشتراک
                            </a>
                        </div>
                    </div>
                }
            </div><!-- end card-body -->
        </div><!-- end card -->
    </div><!-- end col -->
</div><!-- end row -->
