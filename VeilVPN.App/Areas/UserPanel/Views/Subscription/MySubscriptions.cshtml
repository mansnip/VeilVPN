<!-- [پایان] راهنمای اشتراک / سوالات متداول -->
@section Scripts {
@* کتابخانه qrcode.js - می‌توانید از CDN استفاده کنید یا اگر فایل را به صورت محلی دارید، آدرس آن را بدهید *@
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
@* اگر فایل local دارید، مشابه این آدرس‌دهی کنید: *@
@* <script src="~/lib/qrcodejs/qrcode.min.js"></script> *@

    <script>
        // --- تابع کمکی برای کپی متن در کلیپ‌بورد ---
        function copyToClipboard(text, element) {
            navigator.clipboard.writeText(text).then(function () {
                // نمایش پیام موفقیت (می‌توانید از tooltip یا روش دیگری استفاده کنید)
                const originalTooltip = element.getAttribute('data-bs-original-title');
                const successMessage = 'لینک کپی شد!';
                var tooltip = bootstrap.Tooltip.getInstance(element);
                if (!tooltip) {
                     tooltip = new bootstrap.Tooltip(element, {
                        title: successMessage,
                        trigger: 'manual'
                    });
                } else {
                     tooltip.setContent({ '.tooltip-inner': successMessage });
                }
                tooltip.show();
                setTimeout(() => {
                    tooltip.hide();
                     // tooltip.setContent({ '.tooltip-inner': originalTooltip }); // بازگرداندن متن اصلی (اختیاری)
                }, 2000);
            }, function (err) {
                console.error('خطا در کپی کردن لینک: ', err);
                alert('مشکلی در کپی کردن لینک رخ داد. لطفا به صورت دستی کپی کنید.');
            });
        }

        // --- اجرای کد پس از بارگذاری کامل DOM ---
        document.addEventListener('DOMContentLoaded', function () {

            const connectionLinkModals = document.querySelectorAll('[id^="connectionLinkModal-"]');

            connectionLinkModals.forEach(modalElement => {
                modalElement.addEventListener('shown.bs.modal', function (event) {
                    const modal = event.target;
                    const qrContainer = modal.querySelector('.qrcode-container');

                    if (!qrContainer) {
                        console.error("خطا: محفظه QR Code با کلاس '.qrcode-container' در مودال پیدا نشد:", modal.id);
                        if (qrContainer) qrContainer.innerHTML = '<p class="text-danger">خطا در بارگذاری QR Code.</p>';
                        return;
                    }

                    if (qrContainer.querySelector('canvas') || qrContainer.querySelector('img')) {
                        return; // Already generated
                    }

                    const link = qrContainer.getAttribute('data-link');
                    const subId = qrContainer.getAttribute('data-subid');

                    if (link && link.trim() !== '') {
                        qrContainer.innerHTML = ''; // Clear previous content/spinner

                        try {
                            const qrcode = new QRCode(qrContainer, {
                                text: link,
                                width: 200, // Adjust size as needed
                                height: 200, // Adjust size as needed
                                colorDark: "#000000",
                                colorLight: "#ffffff",
                                // ***** تغییر کلیدی اینجاست *****
                                correctLevel: QRCode.CorrectLevel.M // تغییر از H به M (Medium)
                                // *******************************
                            });

                            qrContainer.style.cursor = 'pointer';
                            qrContainer.setAttribute('data-bs-toggle', 'tooltip');
                            qrContainer.setAttribute('data-bs-placement', 'top');
                            qrContainer.setAttribute('data-bs-original-title', 'برای کپی لینک کلیک کنید');
                            // Initialize tooltip instance if needed, or rely on the general initializer below

                            qrContainer.onclick = function () {
                                copyToClipboard(link, qrContainer);
                            };

                            console.log(`[QR Code] کد QR برای اشتراک ${subId} با سطح تصحیح خطا 'M' ایجاد شد.`);

                        } catch (error) {
                            // *** مدیریت خطا در صورت بروز مشکل حتی با سطح M ***
                            console.error(`[QR Code] خطا در ساخت QR Code برای اشتراک ${subId} (سطح M):`, error);
                            // بررسی اینکه آیا خطا هنوز هم Overflow است؟
                            if (error.message && error.message.includes("code length overflow")) {
                                qrContainer.innerHTML = `<p class="text-danger small mt-2">خطا: لینک اتصال بیش از حد طولانی است و حتی با کاهش سطح خطا قابل تبدیل به QR Code نیست. لطفاً لینک را به صورت دستی کپی کنید.</p>
                                                         <button class="btn btn-secondary btn-sm mt-2" onclick="copyToClipboard('${link.replace(/'/g, "\\'")}', this)">کپی دستی لینک</button>`; // دکمه کپی دستی اضافه شد
                            } else {
                                qrContainer.innerHTML = '<p class="text-danger small mt-2">خطا در ساخت QR Code. لطفا صفحه را رفرش کنید یا با پشتیبانی تماس بگیرید.</p>';
                            }
                        }

                    } else {
                        console.warn(`[QR Code] لینک اشتراک برای مودال ${modal.id} (اشتراک ${subId}) خالی یا نامعتبر است.`);
                        qrContainer.innerHTML = '<p class="text-warning small mt-2"><i class="ri-error-warning-line align-middle me-1"></i> لینک اتصال برای این اشتراک یافت نشد.</p>';
                    }
                });

                 modalElement.addEventListener('hidden.bs.modal', function (event) {
                     const modal = event.target;
                     const qrContainer = modal.querySelector('.qrcode-container');
                     if (qrContainer) {
                         const tooltip = bootstrap.Tooltip.getInstance(qrContainer);
                         if (tooltip) {
                             tooltip.dispose();
                         }
                         // Optional: Clear QR code on close to force regeneration next time
                         // qrContainer.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">...</span></div>';
                     }
                 });

            }); // End forEach modal

            // Initialize any remaining tooltips on the page
             var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
             var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                 // Avoid re-initializing tooltips already handled by copyToClipboard or qrContainer click
                 if (!bootstrap.Tooltip.getInstance(tooltipTriggerEl)) {
                    return new bootstrap.Tooltip(tooltipTriggerEl)
                 }
             });

            console.log("[MySubscriptions] Script reloaded. QR Code generation logic updated (CorrectLevel: M).");

        }); // --- End of DOMContentLoaded ---
    </script>
}