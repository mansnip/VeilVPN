@model Domain.ViewModels.UserPanel.SubscriptionnViewModel
@{
    ViewData["Title"] = "وضعیت اشتراک";
    Layout = "~/Areas/UserPanel/Views/Shared/_Layout.cshtml";
}

<!-- شروع عنوان صفحه -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">وضعیت اشتراک</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">اشتراک VPN</a></li>
                    <li class="breadcrumb-item active">وضعیت</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- پایان عنوان صفحه -->
<!-- شروع خلاصه وضعیت -->
<div class="row">
    <div class="col-xl-12">
        @if (Model != null && Model.IsActive)
        {
            <!-- کاربر دارای اشتراک فعال است -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="flex-shrink-0">
                            <div class="avatar-lg rounded-circle bg-soft-success">
                                <i class="ri-check-line text-success display-5 m-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="mb-0 text-success">اشتراک شما فعال است</h5>
                            <p class="text-muted mb-0">
                                شما دارای یک اشتراک @Model.Traffic گیگابایت / @Model.Duration روزه هستید که تا تاریخ @Model.EndDate.ToPersianDate() معتبر است.
                            </p>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge badge-soft-success fs-6 p-2">فعال</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-4">
                            <div class="card border card-border-primary">
                                <div class="card-header bg-soft-primary">
                                    <span class="me-2">
                                        <i class="ri-calendar-line align-middle"></i>
                                    </span>
                                    <span class="card-title text-primary">مدت اشتراک</span>
                                </div>
                                <div class="card-body">
                                    <div class="text-center">
                                        <h1 class="display-6 mb-3">@Model.DaysRemaining</h1>
                                        <p class="card-text">روز باقی‌مانده از @Model.Duration روز</p>

                                        <div class="progress animated-progress custom-progress">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(((Model.Duration - Model.DaysRemaining) * 100) / Model.Duration)%" aria-valuenow="@(((Model.Duration - Model.DaysRemaining) * 100) / Model.Duration)" aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between mt-2">
                                            <small>@Model.StartDate.ToPersianDate()</small>
                                            <small>@Model.EndDate.ToPersianDate()</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border card-border-success">
                                <div class="card-header bg-soft-success">
                                    <span class="me-2">
                                        <i class="ri-exchange-box-line align-middle"></i>
                                    </span>
                                    <span class="card-title text-success">ترافیک باقی‌مانده</span>
                                </div>
                                <div class="card-body">
                                    <div class="text-center">
                                        <h1 class="display-6 mb-3">@Model.RemainingTraffic</h1>
                                        <p class="card-text">گیگابایت باقی‌مانده از @Model.Traffic گیگابایت</p>

                                        <div class="progress animated-progress custom-progress">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @((Model.RemainingTraffic * 100) / Model.Traffic)%" aria-valuenow="@((Model.RemainingTraffic * 100) / Model.Traffic)" aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between mt-2">
                                            <small>@(Model.Traffic - Model.RemainingTraffic) گیگابایت مصرف شده</small>
                                            <small>@Model.Traffic گیگابایت کل</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border card-border-info">
                                <div class="card-header bg-soft-info">
                                    <span class="me-2">
                                        <i class="ri-information-line align-middle"></i>
                                    </span>
                                    <span class="card-title text-info">اطلاعات اشتراک</span>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <span>شناسه اشتراک</span>
                                            <span class="text-muted">@Model.Id</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <span>تاریخ شروع</span>
                                            <span class="text-muted">@Model.StartDate.ToPersianDate()</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <span>تاریخ پایان</span>
                                            <span class="text-muted">@Model.EndDate.ToPersianDate()</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <span>میانگین مصرف روزانه</span>
                                            <span class="text-muted">@(Math.Round((double)(Model.Traffic - Model.RemainingTraffic) / (Model.Duration - Model.DaysRemaining > 0 ? Model.Duration - Model.DaysRemaining : 1), 2)) گیگابایت</span>
                                        </li>
                                    </ul>
                                    <div class="text-center mt-3">
                                        <a href="@Url.Action("MySubscriptions", "Subscription", new { area = "UserPanel" })" class="btn btn-info btn-sm">مشاهده همه اشتراک‌ها</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- کاربر اشتراک فعال ندارد -->
            <div class="card">
                <div class="card-body text-center p-4">
                    <div class="avatar-lg mx-auto mt-2 mb-5">
                        <div class="avatar-title bg-light text-warning rounded-circle display-3">
                            <i class="ri-error-warning-line"></i>
                        </div>
                    </div>
                    <h4 class="text-warning">شما اشتراک فعالی ندارید!</h4>
                    <p class="text-muted mx-4 mb-4">برای استفاده از خدمات RahaGozar، لازم است یک اشتراک خریداری کنید.</p>
                    <div class="mt-4">
                        <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-success">خرید اشتراک</a>
                        <a href="@Url.Action("MySubscriptions", "Subscription", new { area = "UserPanel" })" class="btn btn-light ms-2">تاریخچه اشتراک‌ها</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- پایان خلاصه وضعیت -->
<!-- بخش راهنمای استفاده -->
@if (Model != null && Model.IsActive)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">راهنمای استفاده از RahaGozar</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card ribbon-box border shadow-none mb-lg-0">
                                <div class="card-body">
                                    <div class="ribbon ribbon-primary ribbon-shape">ویندوز و مک</div>
                                    <div class="mt-4 pt-2">
                                        <h5 class="fs-14 mb-3">نحوه اتصال در سیستم عامل ویندوز و مک</h5>
                                        <ol class="ps-4 text-muted mb-0">
                                            <li class="mb-2">نرم‌افزار را از <a href="#" class="text-reset text-decoration-underline">اینجا</a> دانلود کنید.</li>
                                            <li class="mb-2">نرم‌افزار را نصب کنید.</li>
                                            <li class="mb-2">با نام کاربری و رمز عبور خود وارد شوید.</li>
                                            <li class="mb-2">یکی از سرورهای موجود را انتخاب کنید.</li>
                                            <li>بر روی دکمه اتصال کلیک کنید.</li>
                                        </ol>
                                        <div class="text-center mt-4">
                                            <a href="#" class="btn btn-soft-primary btn-sm">دانلود نرم‌افزار ویندوز</a>
                                            <a href="#" class="btn btn-soft-info btn-sm ms-2">دانلود نرم‌افزار مک</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card ribbon-box border shadow-none mb-lg-0">
                                <div class="card-body">
                                    <div class="ribbon ribbon-success ribbon-shape">اندروید و iOS</div>
                                    <div class="mt-4 pt-2">
                                        <h5 class="fs-14 mb-3">نحوه اتصال در گوشی موبایل</h5>
                                        <ol class="ps-4 text-muted mb-0">
                                            <li class="mb-2">نرم‌افزار موبایل را از فروشگاه‌های اپلیکیشن دانلود کنید.</li>
                                            <li class="mb-2">نرم‌افزار را باز کنید.</li>
                                            <li class="mb-2">با نام کاربری و رمز عبور خود وارد شوید.</li>
                                            <li class="mb-2">یکی از سرورهای موجود را انتخاب کنید.</li>
                                            <li>بر روی دکمه اتصال کلیک کنید.</li>
                                        </ol>
                                        <div class="text-center mt-4">
                                            <a href="#" class="btn btn-soft-success btn-sm">دانلود نرم‌افزار اندروید</a>
                                            <a href="#" class="btn btn-soft-secondary btn-sm ms-2">دانلود نرم‌افزار iOS</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- پایان بخش راهنمای استفاده -->
<!-- بخش پیشنهاد اشتراک -->
@if (Model == null || !Model.IsActive || Model.DaysRemaining < 7)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="card bg-soft-warning border-warning">
                <div class="card-header bg-soft-warning">
                    <h5 class="card-title text-warning mb-0">پیشنهاد ویژه</h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <p class="card-text mb-1">
                                @if (Model == null || !Model.IsActive)
                                {
                                    <span>هم‌اکنون اشتراک فعالی ندارید. برای استفاده از خدمات RahaGozar یک اشتراک خریداری کنید.</span>
                                }
                                else if (Model.DaysRemaining < 7)
                                {
                                    <span>اشتراک شما به زودی منقضی می‌شود! تنها @Model.DaysRemaining روز باقی مانده است.</span>
                                }
                            </p>
                            <p class="card-text text-muted">
                                با خرید اشتراک یک‌ساله از 20% تخفیف بهره‌مند شوید.
                            </p>
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" class="btn btn-warning">خرید اشتراک</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- پایان بخش پیشنهاد اشتراک -->
<!-- بخش آمار مصرف -->
@if (Model != null && Model.IsActive)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">آمار مصرف</h4>
                </div>
                <div class="card-body">
                    <div id="chart-area" data-colors='["--vz-success", "--vz-danger"]' class="apex-charts" dir="ltr"></div>
                </div>
            </div>
        </div>
    </div>
}
<!-- پایان بخش آمار مصرف -->
<!-- بخش سوالات متداول -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">سوالات متداول</h4>
            </div>
            <div class="card-body">
                <div class="accordion custom-accordionwithicon" id="accordionExample">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                چگونه از RahaGozar در چند دستگاه استفاده کنم؟
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                شما می‌توانید با یک اشتراک، همزمان در چند دستگاه از RahaGozar استفاده کنید. کافی است نرم‌افزار را در دستگاه‌های مختلف نصب کرده و با اطلاعات کاربری خود وارد شوید. توجه داشته باشید که میزان ترافیک مصرفی در همه دستگاه‌ها محاسبه می‌شود.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                اگر ترافیک من تمام شود چه اتفاقی می‌افتد؟
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                اگر ترافیک شما به پایان برسد، اتصال VPN شما قطع می‌شود. برای ادامه استفاده، می‌توانید یک اشتراک جدید خریداری کنید یا ترافیک اضافی بخرید.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                آیا می‌توانم اشتراک خود را ارتقا دهم؟
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                بله، شما می‌توانید اشتراک خود را ارتقا دهید. برای این کار، کافی است یک اشتراک جدید با حجم یا مدت بیشتر خریداری کنید.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingFour">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                                چه کنم اگر به مشکل فنی برخوردم؟
                            </button>
                        </h2>
                        <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                در صورت بروز هرگونه مشکل فنی، می‌توانید با تیم پشتیبانی ما از طریق بخش "تماس با ما" ارتباط برقرار کنید. کارشناسان ما در اسرع وقت به شما پاسخ خواهند داد.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- پایان بخش سوالات متداول -->
@section Scripts {
    <!-- نمودار apex -->
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>

    <!-- کد مربوط به نمودار -->
    @if (Model != null && Model.IsActive)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // دیتای نمودار - این دیتا باید با اطلاعات واقعی مصرف کاربر جایگزین شود
                var trafficData = [];

                // برای مثال، داده‌های ساختگی برای ۷ روز گذشته
                var today = new Date();
                for (var i = 6; i >= 0; i--) {
                    var day = new Date(today);
                    day.setDate(day.getDate() - i);

                    // مقدار مصرف تصادفی بین ۰.۵ تا ۲ گیگابایت
                    var usage = Math.random() * 1.5 + 0.5;
                    usage = Math.round(usage * 100) / 100; // گرد کردن به ۲ رقم اعشار

                    trafficData.push({
                        x: day.toLocaleDateString('fa-IR'),
                        y: usage
                    });
                }

                var options = {
                    chart: {
                        height: 350,
                        type: 'area',
                        toolbar: {
                            show: false
                        }
                    },
                    dataLabels: {
                        enabled: false
                    },
                    stroke: {
                        curve: 'smooth',
                        width: 2
                    },
                    series: [{
                        name: 'مصرف روزانه (گیگابایت)',
                        data: trafficData
                    }],
                    xaxis: {
                        type: 'category',
                        categories: trafficData.map(item => item.x),
                        labels: {
                            style: {
                                fontFamily: 'Vazirmatn, sans-serif',
                            }
                        }
                    },
                    yaxis: {
                        title: {
                            text: 'مصرف (گیگابایت)',
                            style: {
                                fontFamily: 'Vazirmatn, sans-serif',
                            }
                        },
                        labels: {
                            formatter: function (value) {
                                return value.toFixed(2) + " GB";
                            },
                            style: {
                                fontFamily: 'Vazirmatn, sans-serif',
                            }
                        }
                    },
                    colors: ['#0ab39c'],
                    tooltip: {
                        y: {
                            formatter: function (value) {
                                return value.toFixed(2) + " گیگابایت";
                            }
                        }
                    },
                    fill: {
                        type: 'gradient',
                        gradient: {
                            shadeIntensity: 1,
                            opacityFrom: 0.7,
                            opacityTo: 0.3,
                            stops: [0, 90, 100]
                        }
                    },
                    legend: {
                        position: 'top',
                        horizontalAlign: 'right',
                        floating: true,
                        offsetY: -25,
                        offsetX: -5
                    }
                };

                var chart = new ApexCharts(document.querySelector("#chart-area"), options);
                chart.render();
            });
        </script>
    }
}