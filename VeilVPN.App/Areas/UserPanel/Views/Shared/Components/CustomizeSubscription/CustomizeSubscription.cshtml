                                    <p class="text-muted">با انتخاب مقدار ترافیک و مدت زمان، اشتراک متناسب با نیاز خود را ایجاد کنید.</p>

                                    <div class="mt-4">
                                        <div class="mb-4">
                                            <h6 class="fs-14 mb-2">میزان ترافیک (گیگابایت)</h6>
                                            <div class="d-flex align-items-center">
                                                <input type="range" class="form-range flex-grow-1" min="10" max="500" step="10" id="trafficRange" value="30">
                                                <span class="badge bg-primary-subtle text-primary ms-2 fs-14 min-w-60px text-center" id="trafficValue">30 GB</span>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <h6 class="fs-14 mb-2">مدت زمان (روز)</h6>
                                            <div class="d-flex align-items-center">
                                                <input type="range" class="form-range flex-grow-1" min="15" max="365" step="5" id="durationRange" value="30">
                                                <span class="badge bg-success-subtle text-success ms-2 fs-14 min-w-60px text-center" id="durationValue">30 روز</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="fs-14 mb-2">تعداد کاربران</h6>
                                            <div class="d-flex align-items-center">
                                                <input type="range" class="form-range flex-grow-1" min="1" max="1" step="1" id="usersRange" value="1" disabled>
                                                <span class="badge bg-info-subtle text-info ms-2 fs-14 min-w-60px text-center">نامحدود</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border shadow-none bg-light">
                                <div class="card-header bg-soft-primary">
                                    <h5 class="mb-0 text-primary">خلاصه سفارش</h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-borderless mb-0">
                                            <tbody>
                                                <tr>
                                                    <td class="fw-medium">ترافیک:</td>
                                                    <td class="text-end" id="summaryTraffic">30 گیگابایت</td>
                                                </tr>
                                                <tr>
                                                    <td class="fw-medium">مدت زمان:</td>
                                                    <td class="text-end" id="summaryDuration">30 روز</td>
                                                </tr>
                                                <tr>
                                                    <td class="fw-medium">تعداد کاربران:</td>
                                                    <td class="text-end">نامحدود</td>
                                                </tr>
                                                <tr class="bg-success-subtle">
                                                    <td class="fw-semibold fs-16">قیمت نهایی:</td>
                                                    <td class="fw-semibold fs-16 text-end" id="summaryPrice">120,000 تومان</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-4 pt-2">
                                        <a href="/Subscription/Purchase" class="btn btn-success w-100">خرید اشتراک</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

