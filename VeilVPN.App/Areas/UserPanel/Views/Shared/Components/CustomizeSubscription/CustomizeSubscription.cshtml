@model Domain.ViewModels.UserPanel.SubscriptionModel
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">شخصی‌سازی اشتراک VeilVPN</h4>
            </div><!-- end card header -->

            <div class="card-body">
                <div class="live-preview">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card border shadow-none">
                                <div class="card-body">
                                    <h5 class="fs-16 fw-semibold">اشتراک دلخواه خود را بسازید</h5>
                                    <p class="text-muted">با انتخاب مقدار ترافیک و مدت زمان، اشتراک متناسب با نیاز خود را ایجاد کنید.</p>

                                    <div class="mt-4">
                                        <div class="mb-4">
                                            <h6 class="fs-14 mb-2">میزان ترافیک (گیگابایت)</h6>
                                            <div class="d-flex align-items-center">
                                                <input type="range" class="form-range flex-grow-1" min="10" max="500" step="10" id="trafficRange" value="@Model.Traffic">
                                                <span class="badge bg-primary-subtle text-primary ms-2 fs-14 min-w-60px text-center" id="trafficValue">@Model.Traffic GB</span>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <h6 class="fs-14 mb-2">مدت زمان (روز)</h6>
                                            <div class="d-flex align-items-center">
                                                <input type="range" class="form-range flex-grow-1" min="15" max="365" step="5" id="durationRange" value="@Model.Duration">
                                                <span class="badge bg-success-subtle text-success ms-2 fs-14 min-w-60px text-center" id="durationValue">@Model.Duration روز</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="fs-14 mb-2">تعداد کاربران</h6>
                                            <div class="d-flex align-items-center">
                                                <input type="range" class="form-range flex-grow-1" min="1" max="1" step="1" id="usersRange" value="1" disabled>
                                                <span class="badge bg-info-subtle text-info ms-2 fs-14 min-w-60px text-center">نامحدود</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border shadow-none bg-light">
                                <div class="card-header bg-soft-primary">
                                    <h5 class="mb-0 text-primary">خلاصه سفارش</h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-borderless mb-0">
                                            <tbody>
                                                <tr>
                                                    <td class="fw-medium">ترافیک:</td>
                                                    <td class="text-end" id="summaryTraffic">@Model.Traffic گیگابایت</td>
                                                </tr>
                                                <tr>
                                                    <td class="fw-medium">مدت زمان:</td>
                                                    <td class="text-end" id="summaryDuration">@Model.Duration روز</td>
                                                </tr>
                                                <tr>
                                                    <td class="fw-medium">تعداد کاربران:</td>
                                                    <td class="text-end">نامحدود</td>
                                                </tr>
                                                <tr id="discountRow" style="display: none;">
                                                    <td class="fw-medium">تخفیف:</td>
                                                    <td class="text-end text-success" id="summaryDiscount">0%</td>
                                                </tr>
                                                <tr class="bg-success-subtle">
                                                    <td class="fw-semibold fs-16">قیمت نهایی:</td>
                                                    <td class="fw-semibold fs-16 text-end" id="summaryPrice">در حال محاسبه...</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-4 pt-2">
                                        <form id="subscriptionForm" asp-area="UserPanel" asp-controller="Panel" asp-action="ShowInvoicePreview" method="get">
                                            <input type="hidden" id="hiddenTraffic" name="traffic" value="30">
                                            <input type="hidden" id="hiddenDuration" name="duration" value="30">
                                            <button type="submit" class="btn btn-success w-100">مشاهده پیش‌فاکتور</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- اضافه کردن اسکریپت برای محاسبه قیمت -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
    // تعریف قیمت‌های پایه
    const pricePerGB = 2500; // قیمت هر گیگابایت: 2500 تومان
    const pricePerDay = 1500; // قیمت هر روز: 1500 تومان

    // اسلایدرها
    const trafficRange = document.getElementById('trafficRange');
    const durationRange = document.getElementById('durationRange');

    // نمایش مقادیر
    const trafficValue = document.getElementById('trafficValue');
    const durationValue = document.getElementById('durationValue');
    const summaryTraffic = document.getElementById('summaryTraffic');
    const summaryDuration = document.getElementById('summaryDuration');
    const summaryPrice = document.getElementById('summaryPrice');
    const discountRow = document.getElementById('discountRow');
    const summaryDiscount = document.getElementById('summaryDiscount');

    // فیلدهای پنهان فرم
    const hiddenTraffic = document.getElementById('hiddenTraffic');
    const hiddenDuration = document.getElementById('hiddenDuration');

    // تابع محاسبه قیمت در سمت کلاینت (فقط برای نمایش)
    function calculatePrice() {
    const traffic = parseInt(trafficRange.value);
    const duration = parseInt(durationRange.value);

    // محاسبه قیمت پایه
    const trafficCost = traffic * pricePerGB;
    const durationCost = duration * pricePerDay;

    // مجموع قیمت پایه
    let finalPrice = trafficCost + durationCost;

    // اعمال تخفیف بر اساس مدت زمان
    let discount = 0;

    if (duration >= 300 && duration <= 365) {       // 10 تا 12 ماه (300-365 روز)
    discount = 0.20;                            // 20 درصد تخفیف
    } else if (duration >= 180 && duration < 300) { // 6 تا 10 ماه (180-299 روز)
    discount = 0.15;                            // 15 درصد تخفیف
    } else if (duration >= 90 && duration < 180) {  // 3 تا 6 ماه (90-179 روز)
    discount = 0.10;                            // 10 درصد تخفیف
    }

    // اعمال تخفیف
    finalPrice = finalPrice * (1 - discount);

    // گرد کردن قیمت به هزار تومان نزدیک‌تر
    finalPrice = Math.round(finalPrice / 1000) * 1000;

    return { price: finalPrice, discount: discount * 100 };
    }

    // دریافت قیمت از سرور
    async function getPriceFromServer(traffic, duration) {
    try {
    // تغییر آدرس به کنترلر جدید Subscription
    const response = await fetch('@Url.Action("CalculatePrice", "Subscription", new { area = "UserPanel" })', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
    },
    body: JSON.stringify({
    traffic: traffic,
    duration: duration
    })
    });

    if (!response.ok) {
    throw new Error('خطا در دریافت قیمت از سرور');
    }

    const data = await response.json();
    return { price: data.price, discount: data.discount };
    } catch (error) {
    console.error('خطا:', error);
    // در صورت خطا، از محاسبه سمت کلاینت استفاده می‌کنیم
    return calculatePrice();
    }
    }

    // به‌روزرسانی نمایش مقادیر
    async function updateDisplay() {
    const traffic = parseInt(trafficRange.value);
    const duration = parseInt(durationRange.value);

    // نمایش مقادیر انتخاب شده
    trafficValue.textContent = `${traffic} GB`;
    durationValue.textContent = `${duration} روز`;
    summaryTraffic.textContent = `${traffic} گیگابایت`;
    summaryDuration.textContent = `${duration} روز`;

    // به‌روزرسانی فیلدهای پنهان فرم
    hiddenTraffic.value = traffic;
    hiddenDuration.value = duration;

    // نشان دادن "در حال محاسبه..." هنگام درخواست
    summaryPrice.textContent = "در حال محاسبه...";

    // دریافت قیمت از سرور
    const result = await getPriceFromServer(traffic, duration);

    // نمایش قیمت
    summaryPrice.textContent = `${result.price.toLocaleString()} تومان`;

    // نمایش تخفیف اگر وجود داشته باشد
    if (result.discount > 0) {
    discountRow.style.display = "table-row";
    summaryDiscount.textContent = `${result.discount}%`;
    } else {
    discountRow.style.display = "none";
    }
    }

    // رویدادهای تغییر مقادیر
    trafficRange.addEventListener('input', function() {
    // به‌روزرسانی سریع مقادیر نمایشی بدون انتظار برای پاسخ سرور
    trafficValue.textContent = `${this.value} GB`;
    summaryTraffic.textContent = `${this.value} گیگابایت`;
    hiddenTraffic.value = this.value;

    // با تأخیر کوتاه، قیمت را از سرور دریافت می‌کنیم
    clearTimeout(this.timer);
    this.timer = setTimeout(updateDisplay, 300);
    });

    durationRange.addEventListener('input', function() {
    // به‌روزرسانی سریع مقادیر نمایشی بدون انتظار برای پاسخ سرور
    durationValue.textContent = `${this.value} روز`;
    summaryDuration.textContent = `${this.value} روز`;
    hiddenDuration.value = this.value;

    // با تأخیر کوتاه، قیمت را از سرور دریافت می‌کنیم
    clearTimeout(this.timer);
    this.timer = setTimeout(updateDisplay, 300);
    });

    // مقداردهی اولیه
    updateDisplay();
    });
</script>

<!-- اضافه کردن استایل برای عرض ثابت badge -->
<style>
    .min-w-60px {
        min-width: 60px;
    }
</style>