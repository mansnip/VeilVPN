<!-- اضافه کردن اسکریپت برای محاسبه قیمت -->
<script>
        document.addEventListener('DOMContentLoaded', function() {
        // تعریف قیمت‌های پایه
        const pricePerGB = 2500; // قیمت هر گیگابایت: 2500 تومان
        const pricePerDay = 1500; // قیمت هر روز: 1500 تومان

        // اسلایدرها
        const trafficRange = document.getElementById('trafficRange');
        const durationRange = document.getElementById('durationRange');

        // نمایش مقادیر
        const trafficValue = document.getElementById('trafficValue');
        const durationValue = document.getElementById('durationValue');
        const summaryTraffic = document.getElementById('summaryTraffic');
        const summaryDuration = document.getElementById('summaryDuration');
        const summaryPrice = document.getElementById('summaryPrice');

        // تابع محاسبه قیمت
        function calculatePrice() {
            const traffic = parseInt(trafficRange.value);
            const duration = parseInt(durationRange.value);

            // محاسبه قیمت پایه
            const trafficCost = traffic * pricePerGB;
            const durationCost = duration * pricePerDay;

            // مجموع قیمت پایه
            let finalPrice = trafficCost + durationCost;

            // اعمال تخفیف بر اساس مدت زمان
            let discount = 0;

            if (duration >= 300 && duration <= 365) {       // 10 تا 12 ماه (300-365 روز)
                discount = 0.20;                            // 20 درصد تخفیف
            } else if (duration >= 180 && duration < 300) { // 6 تا 10 ماه (180-299 روز)
                discount = 0.15;                            // 15 درصد تخفیف
            } else if (duration >= 90 && duration < 180) {  // 3 تا 6 ماه (90-179 روز)
                discount = 0.10;                            // 10 درصد تخفیف
            }

            // اعمال تخفیف
            finalPrice = finalPrice * (1 - discount);

            // گرد کردن قیمت به هزار تومان نزدیک‌تر
            finalPrice = Math.round(finalPrice / 1000) * 1000;

            return finalPrice;
        }

        // به‌روزرسانی نمایش مقادیر
        function updateDisplay() {
            const traffic = trafficRange.value;
            const duration = durationRange.value;
            const price = calculatePrice();

            trafficValue.textContent = `${traffic} GB`;
            durationValue.textContent = `${duration} روز`;
            summaryTraffic.textContent = `${traffic} گیگابایت`;
            summaryDuration.textContent = `${duration} روز`;
            summaryPrice.textContent = `${price.toLocaleString()} تومان`;
        }

        // رویدادهای تغییر مقادیر
        trafficRange.addEventListener('input', updateDisplay);
        durationRange.addEventListener('input', updateDisplay);

        // مقداردهی اولیه
        updateDisplay();
    });


</script>

