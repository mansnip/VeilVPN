@model IEnumerable<Domain.Entities.Account.User>

@{
    ViewData["Title"] = "مدیریت کاربران";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
            <h4 class="mb-sm-0">مدیریت کاربران</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="~/Admin/Home/Index">داشبورد</a></li>
                    <li class="breadcrumb-item active">مدیریت کاربران</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">لیست کاربران</h4>
            </div><!-- end card header -->

            <div class="card-body">
                <div class="listjs-table" id="userList">
                    <div class="row g-4 mb-3">
                        <div class="col-sm-auto">
                            <div>
                                <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-success add-btn"><i class="ri-add-line align-bottom me-1"></i>کاربر جدید</a>
                                <button class="btn btn-soft-danger" onclick="deleteMultiple()"><i class="ri-delete-bin-2-line"></i></button>
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="d-flex justify-content-sm-end">
                                <div class="search-box ms-2">
                                    <input type="text" class="form-control search" placeholder="جستجو...">
                                    <i class="ri-search-line search-icon"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive table-card mt-3 mb-1">
                        <table class="table align-middle table-nowrap" id="userTable">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 50px;">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                        </div>
                                    </th>
                                    <th class="sort" data-sort="id">شناسه</th>
                                    <th class="sort" data-sort="email">ایمیل</th>
                                    <th class="sort" data-sort="phone">شماره تماس</th>
                                    <th class="sort" data-sort="role">نقش</th>
                                    <th class="sort" data-sort="status">وضعیت</th>
                                    <th class="sort" data-sort="date">تاریخ ثبت‌نام</th>
                                    <th class="sort" data-sort="action">عملیات</th>
                                </tr>
                            </thead>
                            <tbody class="list form-check-all">
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <th scope="row">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="chk_child" value="@user.Id">
                                            </div>
                                        </th>
                                        <td class="id"><a href="javascript:void(0);" class="fw-medium link-primary">@user.Id.Substring(0, 8)</a></td>
                                        <td class="email">@user.Email</td>
                                        <td class="phone">@(user.PhoneNumber ?? "ثبت نشده")</td>
                                        <td class="role">@user.Role</td>
                                        <td class="status">
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success text-uppercase">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger text-uppercase">غیرفعال</span>
                                            }
                                        </td>
                                        <td class="date">@user.CreateDateTime.ToPersianDate()</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <div class="edit">
                                                    <a href="~/Admin/Users/Edit/@user.Id" class="btn btn-sm btn-success">ویرایش</a>
                                                </div>
                                                <div class="remove">
                                                    <button class="btn btn-sm btn-danger remove-item-btn" data-id="@user.Id" data-bs-toggle="modal" data-bs-target="#deleteModal">حذف</button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="noresult" style="display: none">
                            <div class="text-center">
                                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                                <h5 class="mt-2">متاسفانه! هیچ کاربری یافت نشد</h5>
                                <p class="text-muted mb-0">هیچ کاربری با معیارهای جستجوی شما پیدا نشد.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <div class="pagination-wrap hstack gap-2">
                            <a class="page-item pagination-prev disabled" href="javascript:void(0);">قبلی</a>
                            <ul class="pagination listjs-pagination mb-0"></ul>
                            <a class="page-item pagination-next" href="javascript:void(0);">بعدی</a>
                        </div>
                    </div>
                </div>
            </div><!-- end card -->
        </div>
        <!-- end col -->
    </div>
    <!-- end col -->
</div>
<!-- end row -->
    </div>
<!-- container-fluid -->
</div>
<!-- End Page-content -->
<!-- Modal حذف -->
<div class="modal fade zoomIn" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>مطمئن هستید؟</h4>
                        <p class="text-muted mx-4 mb-0">آیا مطمئن هستید که می‌خواهید این کاربر را حذف کنید؟</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">انصراف</button>
                    <a href="#" id="delete-user-link" class="btn w-sm btn-danger">بله، حذف شود!</a>
                </div>
            </div>
        </div>


        @section Scripts {
            <script>
                // حذف کاربر
                $(document).on('click', '.remove-item-btn', function () {
                    var userId = $(this).data('id');
                    $('#delete-user-link').attr('href', '/Admin/Users/Delete/' + userId);
                });

                // جستجو و صفحه‌بندی
                var userList = new List('userList', {
                    valueNames: ['id', 'email', 'phone', 'role', 'status', 'date'],
                    page: 10,
                    pagination: true
                });

                // انتخاب همه
                $("#checkAll").on("click", function () {
                    $('input[name="chk_child"]').prop('checked', this.checked);
                });
            </script>
        }

