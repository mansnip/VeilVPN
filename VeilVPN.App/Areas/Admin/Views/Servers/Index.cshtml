@model IEnumerable<Domain.Entities.VPN.VPNServer>

@{
    ViewData["Title"] = "مدیریت سرورهای VPN";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
            <h4 class="mb-sm-0">مدیریت سرورهای VPN</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript:%20void(0);">داشبورد</a></li>
                    <li class="breadcrumb-item active">سرورهای VPN</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">لیست سرورهای VPN</h4>
            </div><!-- end card header -->

            <div class="card-body">
                <div class="listjs-table" id="serverList">
                    <div class="row g-4 mb-3">
                        <div class="col-sm-auto">
                            <div>
                                <a href="@Url.Action("Create", "Servers")" class="btn btn-success add-btn">
                                    <i class="ri-add-line align-bottom me-1"></i>افزودن سرور جدید
                                </a>
                                <button class="btn btn-soft-danger" onclick="deleteMultiple()">
                                    <i class="ri-delete-bin-2-line"></i> حذف انتخاب شده‌ها
                                </button>
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="d-flex justify-content-sm-end">
                                <div class="search-box ms-2">
                                    <input type="text" class="form-control search" placeholder="جستجو...">
                                    <i class="ri-search-line search-icon"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive table-card mt-3 mb-1">
                        <table class="table align-middle table-nowrap" id="serverTable">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 50px;">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                        </div>
                                    </th>
                                    <th class="sort" data-sort="server_name">نام سرور</th>
                                    <th class="sort" data-sort="ip_address">آدرس IP</th>
                                    <th class="sort" data-sort="location">موقعیت</th>
                                    <th class="sort" data-sort="users">کاربران</th>
                                    <th class="sort" data-sort="status">وضعیت</th>
                                    <th class="sort" data-sort="updated_at">آخرین بروزرسانی</th>
                                    <th class="sort" data-sort="action">عملیات</th>
                                </tr>
                            </thead>
                            <tbody class="list form-check-all">
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var server in Model)
                                    {
                                        <tr>
                                            <th scope="row">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="chk_child" value="@server.Id">
                                                </div>
                                            </th>
                                            <td class="server_name">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(server.Flag))
                                                    {
                                                        <img src="@server.Flag" alt="@server.Location" class="me-2 rounded" width="24">
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-xs me-2">
                                                            <div class="avatar-title bg-soft-primary text-primary rounded-circle">
                                                                <i class="ri-server-line"></i>
                                                            </div>
                                                        </div>
                                                    }
                                                    <span>@server.Name</span>
                                                </div>
                                            </td>
                                            <td class="ip_address">@server.IpAddress</td>
                                            <td class="location">@server.Location</td>
                                            <td class="users">
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1" style="height: 6px; width: 80px;">
                                                        @{
                                                            var percentage = server.MaxUsers > 0 ? (server.CurrentUsers * 100) / server.MaxUsers : 0;
                                                            var progressClass = percentage < 50 ? "bg-success" :
                                                            (percentage < 75 ? "bg-warning" : "bg-danger");
                                                        }
                                                        <div class="progress-bar @progressClass" role="progressbar"
                                                             style="width: @percentage%;" aria-valuenow="@percentage"
                                                             aria-valuemin="0" aria-valuemax="100">
                                                        </div>
                                                    </div>
                                                    <span class="ms-2">@server.CurrentUsers/@server.MaxUsers</span>
                                                </div>
                                            </td>
                                            <td class="status">
                                                @if (server.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success text-uppercase">فعال</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger text-uppercase">غیرفعال</span>
                                                }
                                            </td>
                                            <td class="updated_at">
                                                @(server.UpdatedAt.HasValue ? server.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm") : "-")
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <div class="edit">
                                                        <a href="@Url.Action("Edit", "Servers", new { id = server.Id })" class="btn btn-sm btn-success">
                                                            <i class="ri-pencil-line"></i>
                                                        </a>
                                                    </div>
                                                    <div class="edit">
                                                        <a href="@Url.Action("Login", "Servers", new { id = server.Id })" class="btn btn-sm btn-success">
                                                            <i class="ri-pencil-line"></i>
                                                        </a>
                                                    </div>
                                                    <div class="view">
                                                        <a href="@Url.Action("Details", "Servers", new { id = server.Id })" class="btn btn-sm btn-info">
                                                            <i class="ri-eye-line"></i>
                                                        </a>
                                                    </div>
                                                    <div class="remove">
                                                        <button class="btn btn-sm btn-danger remove-item-btn" data-id="@server.Id">
                                                            <i class="ri-delete-bin-line"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <div class="py-4">
                                                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                                                <h5 class="mt-4">هیچ سروری یافت نشد</h5>
                                                <p class="text-muted mb-4">هیچ سرور VPN در سیستم ثبت نشده است. برای افزودن سرور جدید روی دکمه «افزودن سرور جدید» کلیک کنید.</p>
                                                <a href="@Url.Action("Create", "Servers")" class="btn btn-primary">
                                                    <i class="ri-add-line align-bottom me-1"></i> افزودن سرور جدید
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="noresult" style="display: none">
                            <div class="text-center">
                                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                                <h5 class="mt-2">متاسفم! هیچ نتیجه‌ای یافت نشد</h5>
                                <p class="text-muted mb-0">هیچ سروری با مشخصات جستجوی شما پیدا نشد.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <div class="pagination-wrap hstack gap-2">
                            <a class="page-item pagination-prev disabled" href="javascript:void(0);">قبلی</a>
                            <ul class="pagination listjs-pagination mb-0"></ul>
                            <a class="page-item pagination-next" href="javascript:void(0);">بعدی</a>
                        </div>
                    </div>
                </div>
            </div><!-- end card -->
        </div>
        <!-- end col -->
    </div>
    <!-- end col -->
</div>

<!-- end row -->
<!-- Delete Modal -->
<div class="modal fade zoomIn" id="deleteServerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>آیا از حذف این سرور اطمینان دارید؟</h4>
                        <p class="text-muted mx-4 mb-0">این عملیات غیرقابل بازگشت است و تمام اطلاعات مربوط به این سرور حذف خواهد شد.</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn w-sm btn-danger" id="delete-record">بله، حذف شود</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                $(document).ready(function () {
            // تنظیم جدول با list.js
            var serverList = new List('serverList', {
                valueNames: [
                    'server_name',
                    'ip_address',
                    'location',
                    'users',
                    { name: 'status', attr: 'data-status' },
                    'updated_at'
                ],
                page: 10,
                pagination: true
            });

            // مدیریت حذف تکی
            $('.remove-item-btn').click(function () {
                var serverId = $(this).data('id');
                $('#deleteServerModal').modal('show');

                $('#delete-record').off('click').on('click', function () {
                    // ارسال درخواست حذف به سرور
                    $.ajax({
                        url: '@Url.Action("Delete", "Servers")',
                        type: 'POST',
                        data: { id: serverId },
                        headers: {
                            'RequestVerificationToken': $('input:hidden[name="__RequestVerificationToken"]').val()
                        },
                        success: function (result) {
                            if (result.success) {
                                $('#deleteServerModal').modal('hide');
                                // نمایش پیام موفقیت
                                toastr.success('سرور با موفقیت حذف شد');
                                // ریلود صفحه پس از حذف
                                setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            } else {
                                toastr.error(result.message || 'خطا در حذف سرور');
                            }
                        },
                        error: function () {
                            toastr.error('خطا در ارتباط با سرور');
                        }
                    });
                });
            });

            // مدیریت انتخاب همه
            $("#checkAll").on("click", function (e) {
                $('input[name="chk_child"]').prop('checked', $(this).prop("checked"));
            });

            // حذف چندتایی
            window.deleteMultiple = function () {
                var selectedIds = [];

                // جمع‌آوری آیدی‌های انتخاب شده
                $('input[name="chk_child"]:checked').each(function () {
                    selectedIds.push($(this).val());
                });

                if (selectedIds.length === 0) {
                    toastr.warning('لطفا حداقل یک سرور را انتخاب کنید');
                    return;
                }

                $('#deleteServerModal').modal('show');

                $('#delete-record').off('click').on('click', function () {
                    // ارسال درخواست حذف چندتایی به سرور
                    $.ajax({
                        url: '@Url.Action("DeleteMultiple", "Servers")',
                        type: 'POST',
                        data: { ids: selectedIds },
                        headers: {
                            'RequestVerificationToken': $('input:hidden[name="__RequestVerificationToken"]').val()
                        },
                        success: function (result) {
                            if (result.success) {
                                $('#deleteServerModal').modal('hide');
                                // نمایش پیام موفقیت
                                toastr.success('سرورهای انتخاب شده با موفقیت حذف شدند');
                                // ریلود صفحه پس از حذف
                                setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            } else {
                                toastr.error(result.message || 'خطا در حذف سرورها');
                            }
                        },
                        error: function () {
                            toastr.error('خطا در ارتباط با سرور');
                        }
                    });
                });
            };
        });
    </script>

}