@model Domain.Entities.VPN.VPNServer

@{
    ViewData["Title"] = "افزودن سرور VPN جدید";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
            <h4 class="mb-sm-0">افزودن سرور VPN جدید</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "VpnServers")">سرورهای VPN</a></li>
                    <li class="breadcrumb-item active">افزودن سرور جدید</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">مشخصات سرور جدید</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">نام سرور</label>
                                <input asp-for="Name" class="form-control" placeholder="نام سرور را وارد کنید" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً نام سرور را وارد کنید
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="IpAddress" class="form-label">آدرس IP</label>
                                <input asp-for="IpAddress" class="form-control" placeholder="192.168.1.1" required />
                                <span asp-validation-for="IpAddress" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً آدرس IP سرور را وارد کنید
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="ApiUrl" class="form-label">آدرس API</label>
                                <input asp-for="ApiUrl" class="form-control" placeholder="https://example.com/api" required />
                                <span asp-validation-for="ApiUrl" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً آدرس API را وارد کنید
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="Location" class="form-label">موقعیت</label>
                                <input asp-for="Location" class="form-control" placeholder="آلمان، فرانکفورت" required />
                                <span asp-validation-for="Location" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً موقعیت سرور را وارد کنید
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="ApiUsername" class="form-label">نام کاربری API</label>
                                <input asp-for="ApiUsername" class="form-control" placeholder="نام کاربری API را وارد کنید" required />
                                <span asp-validation-for="ApiUsername" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً نام کاربری API را وارد کنید
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="ApiPassword" class="form-label">رمز عبور API</label>
                                <input asp-for="ApiPassword" type="password" class="form-control" placeholder="رمز عبور API را وارد کنید" required />
                                <span asp-validation-for="ApiPassword" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً رمز عبور API را وارد کنید
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-4">
                            <div class="mb-3">
                                <label asp-for="InboundID" class="form-label">شماره اینباند</label>
                                <input asp-for="InboundID" type="number" class="form-control" required />
                                <span asp-validation-for="InboundID" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً شماره اینباند را وارد کنید
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                <label asp-for="MaxUsers" class="form-label">حداکثر تعداد کاربران</label>
                                <input asp-for="MaxUsers" type="number" class="form-control" min="1" required />
                                <span asp-validation-for="MaxUsers" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً حداکثر تعداد کاربران را وارد کنید
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                <label asp-for="CurrentUsers" class="form-label">تعداد کاربران فعلی</label>
                                <input asp-for="CurrentUsers" type="number" class="form-control" min="0" value="0" required />
                                <span asp-validation-for="CurrentUsers" class="text-danger"></span>
                                <div class="invalid-feedback">
                                    لطفاً تعداد کاربران فعلی را وارد کنید
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="Flag" class="form-label">آدرس پرچم</label>
                                <input asp-for="Flag" class="form-control" placeholder="آدرس تصویر پرچم را وارد کنید" />
                                <span asp-validation-for="Flag" class="text-danger"></span>
                                <div class="form-text">آدرس تصویر پرچم کشور سرور را وارد کنید (اختیاری)</div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="IsActive" class="form-label d-block">وضعیت سرور</label>
                                <div class="form-check form-check-inline">
                                    <input type="checkbox" asp-for="IsActive" class="form-check-input" />
                                    <label class="form-check-label" for="IsActive">فعال</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-lg-12">
                            <div class="hstack gap-2 justify-content-end">
                                <a asp-action="Index" class="btn btn-light">انصراف</a>
                                <button type="submit" class="btn btn-primary">ثبت سرور</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // اعتبارسنجی فرم
        (function () {
        'use strict'

        // فرم‌هایی که نیاز به اعتبارسنجی دارند
        var forms = document.querySelectorAll('.needs-validation')

        // حلقه برای جلوگیری از ارسال
        Array.prototype.slice.call(forms)
        .forEach(function (form) {
        form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
        event.preventDefault()
        event.stopPropagation()
        }

        form.classList.add('was-validated')
        }, false)
        })
        })()
    </script>
    }

