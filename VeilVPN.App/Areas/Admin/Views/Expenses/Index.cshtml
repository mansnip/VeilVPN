            //     icon: 'success',
            //     confirmButtonText: 'باشه',
            //     customClass: {
            //          confirmButton: 'btn btn-primary me-2', // کلاس‌های Velzon
            //     },
            //     buttonsStyling: false // برای استفاده از کلاس‌های خودتان
