            // مثال با SweetAlert2
            // Swal.fire({
            //     title: 'خطا!',
            //     text: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["ErrorMessage"]!.ToString()))',
            //     icon: 'error',
            //     confirmButtonText: 'باشه',
            //      customClass: {
            //          confirmButton: 'btn btn-primary me-2',
            //      },
            //      buttonsStyling: false
            // });

            // مثال با Toastr
            // toastr.error('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["ErrorMessage"]!.ToString()))', 'خطا');
        </script>
    }
}


