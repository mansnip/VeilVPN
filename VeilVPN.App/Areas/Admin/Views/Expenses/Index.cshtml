            // مثال با Toastr (اگر نصب و فعال شده باشد)
            // toastr.success('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"]!.ToString()))', 'موفقیت');

        </script>
