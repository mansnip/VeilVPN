@model IEnumerable<Domain.ViewModels.Admin.DiscountCodeViewModel>
@{
    ViewData["Title"] = "مدیریت کدهای تخفیف";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Breadcrumb -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">@ViewData["Title"]</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard" asp-area="Admin">داشبورد ادمین</a></li>
                    <li class="breadcrumb-item active">مدیریت کد تخفیف</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Display TempData Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ri-check-line me-1 align-middle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ri-error-warning-line me-1 align-middle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <h5 class="card-title mb-0 flex-grow-1"><i class="ri-list-check me-1 text-primary"></i>لیست کدهای تخفیف</h5>
                <div class="flex-shrink-0">
                    <a asp-action="Create" class="btn btn-success btn-sm"><i class="ri-add-line align-bottom me-1"></i> ایجاد کد جدید</a>
                </div>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center" role="alert">
                        هیچ کد تخفیفی یافت نشد.
                    </div>
                }
                else
                {
                    <div class="table-responsive table-card">
                        <table class="table table-hover table-nowrap align-middle mb-0">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.Code)</th>
                                    <th>@Html.DisplayNameFor(model => model.DiscountPercent)</th>
                                    <th>تعداد استفاده (شده/کل)</th>
                                    <th>@Html.DisplayNameFor(model => model.ExpiryDate)</th>
                                    <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                                    <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="fw-medium">@item.Code</span></td>
                                        <td>@item.DiscountPercent %</td>
                                        <td>@item.CurrentUses / @item.MaxUses</td>
                                        <td>@(item.ExpiryDate?.ToString("yyyy/MM/dd") ?? "ندارد")</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">غیرفعال</span>
                                            }
                                            @if (item.ExpiryDate.HasValue && item.ExpiryDate < DateTime.Today)
                                            {
                                                <span class="badge bg-warning-subtle text-warning ms-1">منقضی شده</span>
                                            }
                                        </td>
                                        <td>@item.CreatedDate.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            <ul class="list-inline hstack gap-2 mb-0">
                                                <li class="list-inline-item" data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="top" title="ویرایش">
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary d-inline-block">
                                                        <i class="ri-pencil-fill fs-16"></i>
                                                    </a>
                                                </li>
                                                <li class="list-inline-item">
                                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-link p-0 @(item.IsActive ? "text-warning" : "text-success")"
                                                                data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="top"
                                                                title="@(item.IsActive ? "غیرفعال کردن" : "فعال کردن")"
                                                                onclick="return confirm('آیا از @(item.IsActive ? "غیرفعال" : "فعال") کردن کد [@item.Code] اطمینان دارید؟')">
                                                            <i class="ri-@(item.IsActive ? "eye-off" : "eye")-line fs-16"></i>
                                                        </button>
                                                    </form>
                                                </li>
                                                <li class="list-inline-item" data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="top" title="حذف کامل">
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0"
                                                                onclick="return confirm('هشدار! آیا از حذف کامل و دائمی کد [@item.Code] اطمینان دارید؟ این عمل قابل بازگشت نیست و در صورت استفاده شدن کد ممکن است با خطا مواجه شوید.')">
                                                            <i class="ri-delete-bin-5-line fs-16"></i>
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination (در آینده می‌توانید اضافه کنید) -->
                }
            </div><!-- end card-body -->
        </div><!-- end card -->
    </div><!-- end col -->
</div><!-- end row -->
@section Scripts {
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}