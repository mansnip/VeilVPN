@model Domain.DTOs.VPN.SubscriptionViewModel

@{
    ViewData["Title"] = "جزئیات اشتراک";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    // محاسبه درصد زمان گذشته برای نوار پیشرفت (اگر لازم است)
    int timeUsagePercent = 0;
    if (Model.VpnRemainingDays.HasValue && Model.Duration > 0)
    {
        var elapsedDays = Model.Duration - Model.VpnRemainingDays.Value;
        timeUsagePercent = (int)Math.Round((double)elapsedDays * 100 / Model.Duration);
        if (timeUsagePercent < 0) timeUsagePercent = 0; // جلوگیری از منفی شدن
        if (timeUsagePercent > 100) timeUsagePercent = 100; // جلوگیری از بیشتر از 100 شدن
    }
    else if (!Model.VpnRemainingDays.HasValue) // نامحدود
    {
        timeUsagePercent = 0; // یا 100؟ بستگی به نمایش دارد
    }

    // محاسبه ترافیک مصرف شده
    var usedTrafficGb = (Model.Traffic - Model.VpnRemainingTraffic);
    var usedTrafficDisplay = usedTrafficGb > 0 ? usedTrafficGb.ToString("0.##") : "0"; // نمایش با حداکثر دو رقم اعشار

    // تعیین کلاس برای نوار پیشرفت ترافیک
    var trafficProgressClass = "bg-info";
    if (Model.VpnUsagePercentage > 90)
    {
        trafficProgressClass = "bg-danger";
    }
    else if (Model.VpnUsagePercentage > 70)
    {
        trafficProgressClass = "bg-warning";
    }

    // تعیین کلاس برای نوار پیشرفت زمان
    var timeProgressClass = "bg-success";
    if (timeUsagePercent > 90)
    {
        timeProgressClass = "bg-danger";
    }
    else if (timeUsagePercent > 70)
    {
        timeProgressClass = "bg-warning";
    }

}
<!-- شروع عنوان صفحه -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
            <h4 class="mb-sm-0">جزئیات اشتراک</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Subscription")">اشتراک‌ها</a></li>
                    <li class="breadcrumb-item active">جزئیات</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- پایان عنوان صفحه -->

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <!-- ... کد هدر کارت ... -->
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-borderless table-nowrap mb-0">
                        <tbody>
                            <tr>
                                <th scope="row" class="text-muted">شناسه اشتراک</th>
                                <td>@Model.Id</td>
                                <th scope="row" class="text-muted">کاربر</th>
                                @* اگر ایمیل کاربر اصلی را لازم دارید، باید به ViewModel اضافه شود *@
                                <td>@(Model.VpnEmailName)</td> @* نمایش ایمیل VPN به جای ایمیل کاربر اصلی *@
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">نام کاربری VPN</th>
                                <td>@Model.VpnEmailName</td>
                                <th scope="row" class="text-muted">نام نمایشی (Remark)</th>
                                <td>@(Model.RemarkName ?? "بدون نام")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">وضعیت (دیتابیس)</th>
                                <td>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">غیرفعال</span>
                                    }
                                </td>
                                <th scope="row" class="text-muted">وضعیت (سرور VPN)</th>
                                <td>
                                    @* استفاده از StatusText و StatusClass از ViewModel *@
                                    <span class="badge @Model.StatusClass">@Model.StatusText</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">نام سرور</th>
                                <td>@Model.VpnServerName</td> @* نمایش مستقیم از مدل *@
                                <th scope="row" class="text-muted">لینک اتصال</th>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.SubscriptionLink))
                                    {
                                        <a href="@Model.SubscriptionLink" class="btn btn-sm btn-outline-primary" title="کپی لینک اتصال">
                                            <i class="ri-links-line"></i> لینک
                                        </a>
                                        <button class="btn btn-sm btn-outline-secondary ms-1" onclick="copyToClipboard('@Model.SubscriptionLink', this)">
                                            <i class="ri-clipboard-line"></i> کپی
                                        </button>
                                    }
                                    else
                                    {
                                        <span>لینک موجود نیست</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">تاریخ شروع</th>
                                <td>@Model.StartDate.ToString("yyyy/MM/dd")</td>
                                <th scope="row" class="text-muted">تاریخ انقضا</th>
                                <td>@Model.EndDate.ToString("yyyy/MM/dd")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">مدت اشتراک (روز)</th>
                                <td>@Model.Duration</td>
                                <th scope="row" class="text-muted">روزهای باقیمانده (سرور)</th>
                                <td>@(Model.VpnRemainingDays.HasValue ? $"{Model.VpnRemainingDays} روز" : "نامحدود")</td> @* نمایش مستقیم از مدل *@
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">حجم کل (گیگابایت)</th>
                                <td>@Model.Traffic</td>
                                <th scope="row" class="text-muted">حجم باقیمانده (گیگابایت - سرور)</th>
                                <td>@Model.VpnRemainingTraffic.ToString("0.##") GB</td> @* نمایش مستقیم از مدل با فرمت *@
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">وضعیت مصرف ترافیک (سرور VPN)</h4>
            </div>
            <div class="card-body">
                <div class="px-4">
                    @* استفاده از VpnUsagePercentage از مدل *@
                    <div class="progress animated-progress custom-progress progress-label">
                        <div class="progress-bar @trafficProgressClass" role="progressbar"
                             style="width: @Model.VpnUsagePercentage%" aria-valuenow="@Model.VpnUsagePercentage" aria-valuemin="0" aria-valuemax="100">
                            <div class="label">@Model.VpnUsagePercentage%</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-3">
                        <div>
                            <p class="mb-0 text-muted">حجم کل: <span class="fw-medium">@Model.Traffic گیگابایت</span></p>
                        </div>
                        <div>
                            @* نمایش حجم مصرف شده محاسبه شده *@
                            <p class="mb-0 text-muted">حجم مصرف شده: <span class="fw-medium">@usedTrafficDisplay گیگابایت</span></p>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <p class="mb-0 text-muted small">باقیمانده در سرور: <span class="fw-medium">@Model.VpnRemainingTraffic.ToString("0.##") گیگابایت</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">وضعیت زمان اشتراک</h4>
            </div>
            <div class="card-body">
                <div class="px-4">
                    @if (Model.Duration > 0) // فقط اگر زمان محدود باشد نوار پیشرفت نشان بده
                    {
                        <div class="progress animated-progress custom-progress progress-label">
                            @* استفاده از timeUsagePercent محاسبه شده *@
                            <div class="progress-bar @timeProgressClass" role="progressbar"
                                 style="width: @timeUsagePercent%" aria-valuenow="@timeUsagePercent" aria-valuemin="0" aria-valuemax="100">
                                <div class="label">@timeUsagePercent%</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <div>
                                <p class="mb-0 text-muted">گذشته: <span class="fw-medium">@((Model.VpnRemainingDays.HasValue && Model.Duration > 0) ? (Model.Duration - Model.VpnRemainingDays.Value) : 0) روز</span></p>
                            </div>
                            <div>
                                <p class="mb-0 text-muted">باقی‌مانده: <span class="fw-medium">@(Model.VpnRemainingDays.HasValue ? $"{Model.VpnRemainingDays} روز" : "نامحدود")</span></p>
                            </div>
                        </div>
                    }
                    else // اگر زمان نامحدود است
                    {
                        <div class="alert alert-info text-center">
                            <i class="ri-time-line align-middle me-1"></i> اشتراک زمانی نامحدود است.
                        </div>
                    }
                    <div class="d-flex justify-content-between mt-1">
                        <div>
                            <p class="mb-0 text-muted small">شروع: <span class="fw-medium">@Model.StartDate.ToString("yyyy/MM/dd")</span></p>
                        </div>
                        <div>
                            <p class="mb-0 text-muted small">انقضا: <span class="fw-medium">@Model.EndDate.ToString("yyyy/MM/dd")</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">عملیات مدیریتی</h4>
            </div>
            <div class="card-body">
                <div class="d-flex gap-2">
                    <form id="resetTrafficForm" method="post" action="@Url.Action("ResetTraffic", "Subscription")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="button" class="btn btn-warning" id="resetTrafficBtn">
                            <i class="ri-restart-line me-1"></i> ریست ترافیک
                        </button>
                    </form>

                    <a href="#" class="btn btn-info disabled">
                        <i class="ri-edit-2-line me-1"></i> ویرایش اشتراک
                    </a>

                    <a href="#" class="btn btn-danger disabled">
                        <i class="ri-close-circle-line me-1"></i> غیرفعال‌سازی
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال ریست ترافیک -->
<div class="modal fade" id="resetTrafficModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ریست ترافیک</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="https://cdn.lordicon.com/kbtmbyzy.json" trigger="loop" colors="primary:#0ab39c,secondary:#405189" style="width:90px;height:90px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>آیا از ریست ترافیک اطمینان دارید؟</h4>
                        <p class="text-muted mx-4 mb-0">با این کار تمام ترافیک مصرفی کاربر ریست می‌شود و می‌تواند مجدداً از حجم اشتراک خود استفاده کند.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-success" id="confirmResetTraffic">بله، ریست شود</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // نمایش مودال ریست ترافیک
            $("#resetTrafficBtn").on("click", function (e) {
                e.preventDefault(); // جلوگیری از ارسال فرم پیش‌فرض یا رفتار لینک
                $('#resetTrafficModal').modal('show');
            });

            // تابع کپی لینک در کلیپ‌بورد
            window.copyToClipboard = function(text, buttonElement) {
                navigator.clipboard.writeText(text).then(function() {
                    // تغییر متن و آیکون دکمه به صورت موقت
                    const originalIcon = buttonElement.innerHTML;
                    buttonElement.innerHTML = '<i class="ri-check-line"></i> کپی شد!';
                    buttonElement.disabled = true; // غیرفعال کردن دکمه
                    setTimeout(() => {
                        buttonElement.innerHTML = originalIcon; // بازگرداندن آیکون و متن اصلی
                        buttonElement.disabled = false; // فعال کردن مجدد دکمه
                    }, 2000); // بازگشت به حالت اولیه بعد از 2 ثانیه
                }, function(err) {
                    console.error('خطا در کپی لینک: ', err);
                    // می‌توانید یک پیام خطا به کاربر نشان دهید (مثلاً با استفاده از toastr)
                    alert('خطا در کپی لینک. لطفا دستی کپی کنید.');
                });
            }
        });
    </script>
}