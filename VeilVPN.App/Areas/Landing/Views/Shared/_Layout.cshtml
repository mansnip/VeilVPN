    <script>
        // Plan switch functionality
        function check() {
            var planSwitch = document.getElementById('plan-switch');
            var monthlyPrices = document.querySelectorAll('.month');
            var annualPrices = document.querySelectorAll('.annual');

            if (planSwitch.checked) {
                monthlyPrices.forEach(function(el) {
                    el.style.display = 'none';
                });
                annualPrices.forEach(function(el) {
                    el.style.display = 'block';
                });
            } else {
                monthlyPrices.forEach(function(el) {
                    el.style.display = 'block';
                });
                annualPrices.forEach(function(el) {
                    el.style.display = 'none';
                });
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            check();

            // Add lazy loading to images
            var images = document.querySelectorAll('img');
            images.forEach(function(img) {
                img.setAttribute('loading', 'lazy');
            });
        });
    </script>

    <!--Swiper slider js-->
