@{
    Layout = "~/Areas/Landing/Views/Shared/_Layout.cshtml";
}

@{
    Layout = "~/Areas/Landing/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "RahaGozar - سرویس VPN امن، پرسرعت و قابل تنظیم";
    // اضافه کردن متا تگ توضیحات برای سئو
    ViewData["MetaDescription"] = "با RahaGozar به اینترنت آزاد و امن دسترسی پیدا کنید. اشتراک VPN خود را با انتخاب مدت زمان و حجم ترافیک دلخواه، از ۴۸٬۰۰۰ تومان بسازید. سرعت بالا، بدون قطعی، با پشتیبانی ۲۴/۷.";
}

<div class="layout-wrapper landing">
    <nav class="navbar navbar-expand-lg navbar-landing fixed-top" id="navbar" itemscope itemtype="https://schema.org/SiteNavigationElement">
        <div class="container">
            <a class="navbar-brand" href="/" title="RahaGozar - صفحه اصلی">
                @* حتما لوگوی خود را جایگزین کنید *@
                <img src="/assets/images/logo-dark.png" class="card-logo card-logo-dark" alt="لوگوی RahaGozar - حالت روشن" height="19">
                <img src="/assets/images/logo-light.png" class="card-logo card-logo-light" alt="لوگوی RahaGozar - حالت تاریک" height="19">
            </a>
            <button class="navbar-toggler py-0 fs-20 text-body" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="تغییر ناوبری">
                <i class="mdi mdi-menu"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto mt-2 mt-lg-0" id="navbar-example">
                    <li class="nav-item">
                        <a class="nav-link active" href="#hero" title="صفحه اصلی">صفحه اصلی</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#services" title="خدمات RahaGozar">خدمات ما</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#features" title="ویژگی‌های RahaGozar">ویژگی‌ها</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#plans" title="ساخت اشتراک دلخواه RahaGozar">ساخت اشتراک</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#reviews" title="نظرات کاربران RahaGozar">نظرات کاربران</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#faqs" title="سوالات متداول">سوالات متداول</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact" title="تماس با پشتیبانی RahaGozar">تماس با ما</a>
                    </li>
                </ul>

                <div class="">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var panelUrl = User.IsInRole("Admin") ? Url.Action("Index", "Home", new { Area = "Admin" }) : Url.Action("Index", "Panel", new { Area = "UserPanel" });
                        <a href="@panelUrl" class="btn btn-soft-success material-shadow-none" title="ورود به پنل کاربری"><i class="ri-dashboard-line align-middle me-1"></i> پنل کاربری</a>
                    }
                    else
                    {
                        <a href="@Url.Action("SignIn", "Authentication", new {area =""})" class="btn btn-link fw-medium text-decoration-none text-body" title="ورود به حساب کاربری"> <i class="ri-login-box-line align-middle me-1"></i> ورود</a>
                        <a href="@Url.Action("SignUp", "Authentication", new {area =""})" class="btn btn-primary" title="ایجاد حساب کاربری رایگان در RahaGozar"> <i class="ri-user-add-line align-middle me-1"></i> ثبت‌نام رایگان</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <!-- end navbar -->
    <div class="vertical-overlay" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent.show"></div>

    <!-- start hero section -->
    <section class="section pb-0 hero-section" id="hero">
        <div class="bg-overlay bg-overlay-pattern"></div>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9 col-sm-10">
                    <div class="text-center mt-lg-5 pt-5">
                        <h1 class="display-6 fw-semibold mb-3 lh-base">
                            اینترنت آزاد، امن و پرسرعت با <span class="text-success">RahaGozar</span>
                            <br>
                            <span class="text-primary">اشتراک VPN خود را بسازید!</span>
                        </h1>
                        <p class="lead text-muted lh-lg px-lg-5">
                            با RahaGozar محدودیت‌ها را کنار بزنید و با خیالی آسوده وب‌گردی کنید. سرویس VPN ما با رمزنگاری قوی، سرعت بالا و قابلیت تنظیم اشتراک، تجربه‌ای بی‌نظیر از اینترنت را برای شما رقم می‌زند.
                        </p>

                        <div class="d-flex gap-2 justify-content-center mt-4 pt-2">
                            @* لینک ثبت نام اگر کاربر لاگین نیست *@
                            @if (User.Identity == null || !User.Identity.IsAuthenticated)
                            {
                                <a href="@Url.Action("SignUp", "Authentication", new {area =""})" class="btn btn-primary" title="ایجاد حساب کاربری و شروع استفاده">
                                    <i class="ri-user-add-line align-middle me-1"></i> ثبت‌نام و شروع
                                </a>
                            }
                            <a href="#plans" class="btn btn-outline-success" title="ساخت اشتراک VPN دلخواه">
                                <i class="ri-tools-line align-middle me-1"></i> ساخت اشتراک دلخواه
                            </a>
                            <a href="#features" class="btn btn-link text-secondary" title="آشنایی با ویژگی‌های RahaGozar">
                                آشنایی با ویژگی‌ها <i class="ri-arrow-left-line align-middle"></i>
                            </a>
                        </div>
                    </div>

                    <div class="mt-4 mt-sm-5 pt-sm-5 mb-sm-n5 demo-carousel">
                        @* === تصویر اصلی Hero Section === *@
                        @* حتما یک تصویر جذاب و مرتبط با VPN یا شبکه امن جایگزین کنید *@
                        <div class="demo-img-patten-top d-none d-sm-block">
                            <img src="~/assets/images/landing/img-pattern.png" class="d-block img-fluid" alt="الگوی تزئینی بالا">
                        </div>
                        <div class="demo-img-patten-bottom d-none d-sm-block">
                            <img src="~/assets/images/landing/img-pattern.png" class="d-block img-fluid" alt="الگوی تزئینی پایین">
                        </div>
                        <div class="carousel slide carousel-fade shadow-lg p-2 bg-white rounded" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                <div class="carousel-item active" data-bs-interval="3000">
                                    @* تصویر مرتبط با امنیت یا سرعت VPN *@
                                    <img src="~/assets/images/landing/vpn-hero-1.png" class="d-block w-100 rounded" alt="امنیت و سرعت با RahaGozar VPN">
                                </div>
                                <div class="carousel-item" data-bs-interval="3000">
                                    @* تصویر نمایش‌دهنده دسترسی جهانی یا رفع محدودیت *@
                                    <img src="~/assets/images/landing/vpn-hero-2.png" class="d-block w-100 rounded" alt="دسترسی جهانی با RahaGozar VPN">
                                </div>
                                <div class="carousel-item" data-bs-interval="3000">
                                    @* تصویر نمایش‌دهنده سازگاری با دستگاه‌های مختلف *@
                                    <img src="~/assets/images/landing/vpn-hero-3.png" class="d-block w-100 rounded" alt="RahaGozar VPN روی همه دستگاه‌ها">
                                </div>
                            </div>
                        </div>
                        @* === پایان تصویر اصلی Hero Section === *@
                    </div>
                </div>
            </div>
        </div>
        <!-- Hero shape SVG -->
        <div class="position-absolute start-0 end-0 bottom-0 hero-shape-svg">
            <svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" viewbox="0 0 1440 120" aria-hidden="true">
                <g mask='url("#SvgjsMask1003")' fill="none">
                    <path d="M 0,118 C 288,98.6 1152,40.4 1440,21L1440 140L0 140z" fill="var(--vz-body-bg)"></path> @* رنگ پس‌زمینه بخش بعدی رو می‌گیره *@
                </g>
            </svg>
        </div>
    </section>
