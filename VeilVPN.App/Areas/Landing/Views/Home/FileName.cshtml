@section scripts {
    <!-- Swiper JS -->
    <script src="~/assets/libs/swiper/swiper-bundle.min.js"></script>
    <!-- landing init -->
    <script src="~/assets/js/pages/landing.init.js"></script>

@* اسکریپت برای محاسبه قیمت پلن سفارشی *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const durationSelector = document.getElementById('duration-selector');
            const trafficSlider = document.getElementById('traffic-slider');
            const trafficDisplay = document.getElementById('traffic-display');
            const calculatedPriceElement = document.querySelector('#calculated-price .price-value');
            const priceDurationElement = document.getElementById('price-duration');
            const orderButton = document.getElementById('order-button');
            // const usersSelector = document.getElementById('users-selector'); // اگر انتخاب کاربر فعال شد

            // --- قیمت‌های پایه (قابل تنظیم) ---
            const basePrices = {
                // ماهانه
                1: {
                    30: 48000,   // 1 ماهه، 30 گیگ
                    50: 65000,   // 1 ماهه، 50 گیگ
                    100: 95000,  // 1 ماهه، 100 گیگ
                    unlimited: 150000 // 1 ماهه، نامحدود
                },
                 // هزینه پایه برای هر کاربر اضافه (اگر فعال شد)
                // extraUserCostPerMonth: 20000
            };

            // --- مپ کردن مقادیر اسلایدر به حجم ---
             const trafficMap = {
                 0: { value: '30', text: '۳۰ گیگابایت' },
                 1: { value: '50', text: '۵۰ گیگابایت' },
                 2: { value: '100', text: '۱۰۰ گیگابایت' },
                 3: { value: 'unlimited', text: 'نامحدود' }
             };

            function formatPrice(price) {
                // فرمت کردن قیمت به شکل خوانا (با جداکننده هزارگان)
                return price.toLocaleString('fa-IR');
            }

            function calculatePrice() {
                const selectedDurationOption = durationSelector.options[durationSelector.selectedIndex];
                const durationMonths = parseInt(selectedDurationOption.value, 10);
                const discountPercent = parseInt(selectedDurationOption.dataset.discount || '0', 10);

                const sliderValue = trafficSlider.value;
                const trafficInfo = trafficMap[sliderValue];
                const trafficKey = trafficInfo.value; // '30', '50', '100', 'unlimited'

                // const selectedUsers = parseInt(usersSelector.value, 10); // اگر انتخاب کاربر فعال شد

                // قیمت پایه ماهانه برای حجم انتخاب شده
                let baseMonthlyPrice = basePrices[1][trafficKey] || 0;

                // محاسبه هزینه کاربر اضافه (اگر فعال شد)
                // let userCost = (selectedUsers > 1) ? (selectedUsers - 1) * basePrices.extraUserCostPerMonth : 0;
                // baseMonthlyPrice += userCost;

                // قیمت کل برای مدت زمان انتخاب شده (بدون تخفیف)
                let totalPrice = baseMonthlyPrice * durationMonths;

                // اعمال تخفیف
                if (discountPercent > 0) {
                    totalPrice = totalPrice * (1 - discountPercent / 100);
                }

                // گرد کردن به نزدیک‌ترین ۱۰۰۰ تومان (اختیاری)
                 totalPrice = Math.round(totalPrice / 1000) * 1000;

                // نمایش قیمت
                calculatedPriceElement.textContent = formatPrice(totalPrice);
                priceDurationElement.textContent = `برای ${selectedDurationOption.text.split('(')[0].trim()}`; // نمایش مدت زمان بدون بخش تخفیف

                // آپدیت لینک دکمه سفارش (اختیاری - اگر پارامترها باید به صفحه بعد ارسال شوند)
                 updateOrderButtonLink(durationMonths, trafficKey /*, selectedUsers*/);

            }

            function updateTrafficDisplay() {
                 const sliderValue = trafficSlider.value;
                 const trafficInfo = trafficMap[sliderValue];
                 trafficDisplay.textContent = trafficInfo.text;
                 calculatePrice(); // Recalculate price when traffic changes
             }

             function updateOrderButtonLink(duration, traffic /*, users*/) {
                // این تابع لینک دکمه سفارش را آپدیت می‌کند تا پارامترهای انتخابی
                // به صفحه ایجاد سفارش ارسال شوند (مثلا با Query String)
                let baseUrl = orderButton.href.split('?')[0]; // آدرس پایه بدون پارامتر

                // پارامترهای کوئری استرینگ
                 const params = new URLSearchParams();
                 params.set('duration', duration);
                 params.set('traffic', traffic);
                 // params.set('users', users); // اگر انتخاب کاربر فعال شد

                // ساخت لینک نهایی
                orderButton.href = `${baseUrl}?${params.toString()}`;
            }

            // Event Listeners
            durationSelector.addEventListener('change', calculatePrice);
            trafficSlider.addEventListener('input', updateTrafficDisplay); // Use 'input' for real-time update
            // usersSelector.addEventListener('change', calculatePrice); // اگر انتخاب کاربر فعال شد

            // Initial Calculation and Display
            updateTrafficDisplay(); // Set initial traffic display and calculate price
        });

        // --- اسکریپت برای فرم تماس (اختیاری) ---
        const contactForm = document.getElementById('contact-form');
        const submitButton = document.getElementById('submit-button');
        const responseDiv = document.getElementById('contact-message-response');

        if (contactForm) {
            contactForm.addEventListener('submit', function (e) {
                e.preventDefault(); // جلوگیری از ارسال پیش‌فرض فرم

                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> در حال ارسال...';
                responseDiv.innerHTML = ''; // پاک کردن پیام‌های قبلی

                const formData = new FormData(contactForm);

                fetch(contactForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        // مهم: ارسال توکن ضد جعل (CSRF Token)
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        // تلاش برای خواندن پیام خطا از سرور (اگر وجود داشته باشد)
                         return response.text().then(text => { throw new Error(text || `خطا در ارسال پیام: ${response.statusText}`); });
                    }
                    return response.json(); // فرض بر اینکه سرور JSON برمی‌گرداند
                })
                .then(data => {
                    if (data.success) {
                        responseDiv.innerHTML = `<div class="alert alert-success alert-dismissible fade show" role="alert">
                                                ${data.message || 'پیام شما با موفقیت ارسال شد. به زودی با شما تماس خواهیم گرفت.'}
                                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                                             </div>`;
                        contactForm.reset(); // پاک کردن فرم
                    } else {
                        responseDiv.innerHTML = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                ${data.message || 'خطایی در ارسال پیام رخ داد. لطفا دوباره تلاش کنید.'}
                                                 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                                             </div>`;
                    }
                })
                .catch(error => {
                    console.error('Error submitting contact form:', error);
                    responseDiv.innerHTML = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                                             خطایی در ارتباط با سرور رخ داد. لطفا اتصال اینترنت خود را بررسی کرده و دوباره تلاش کنید. (${error.message})
                                             <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                                         </div>`;
                })
                .finally(() => {
                    // فعال کردن مجدد دکمه و بازگرداندن متن اصلی آن
                    submitButton.disabled = false;
                    submitButton.innerHTML = '<i class="ri-send-plane-fill align-bottom me-1"></i> ارسال پیام';
                });
            });
        }

    </script>
}
