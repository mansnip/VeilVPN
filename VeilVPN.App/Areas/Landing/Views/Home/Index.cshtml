@using Application.Services.Interfaces
@inject IUserService _userService
@{
    Layout = "~/Areas/Landing/Views/Shared/_Layout.cshtml";

}

<div class="layout-wrapper landing">
    <nav class="navbar navbar-expand-lg navbar-landing fixed-top" id="navbar" itemscope itemtype="https://schema.org/SiteNavigationElement">
        <div class="container">
            <a class="navbar-brand" href="/" title="RahaGozar">
                <img src="/assets/images/logo-dark.png" class="card-logo card-logo-dark" alt="لوگوی RahaGozar - حالت روشن" height="17">
                <img src="/assets/images/logo-light.png" class="card-logo card-logo-light" alt="لوگوی RahaGozar - حالت تاریک" height="17">
            </a>
            <button class="navbar-toggler py-0 fs-20 text-body" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="تغییر ناوبری">
                <i class="mdi mdi-menu"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto mt-2 mt-lg-0" id="navbar-example">
                    <li class="nav-item">
                        <a class="nav-link active" href="#hero" title="صفحه اصلی">صفحه اصلی</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#services" title="خدمات RahaGozar">خدمات</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#features" title="ویژگی‌های RahaGozar">ویژگی‌ها</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#plans" title="طرح‌های اشتراک RahaGozar">طرح‌ها</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#reviews" title="نظرات کاربران RahaGozar">بررسی‌ها</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact" title="تماس با پشتیبانی RahaGozar">تماس با ما</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UserPanel/Tutorials/Index" title="تماس با پشتیبانی RahaGozar">تماس با ما</a>
                    </li>
                </ul>

                <div class="">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="/UserPanel/Panel/Index" class="btn btn-soft-success material-shadow-none" title="پنل کاربری">پنل کاربری</a>
                        var user = await _userService.GetUserById(User.Identity!.Name!);
                        if (user.Role == "Admin")
                        {
                            <a href="/Admin/Home/Index" class="btn btn-soft-primary material-shadow-none" title="پنل کاربری">پنل مدیریت</a>
                        }
                    }
                    else
                    {
                        <a href="/authentication/signin" class="btn btn-link fw-medium text-decoration-none text-body" title="ورود به حساب کاربری">ورود</a>
                        <a href="/authentication/signup" class="btn btn-primary" title="ثبت‌نام در RahaGozar">ثبت‌نام کنید</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <!-- end navbar -->
    <div class="vertical-overlay" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent.show"></div>

    <!-- start hero section -->
    <section class="section pb-0 hero-section" id="hero">
        <div class="bg-overlay bg-overlay-pattern"></div>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-sm-10">
                    <div class="text-center mt-lg-5 pt-5">
