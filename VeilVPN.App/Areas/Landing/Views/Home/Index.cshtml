    <section class="section bg-light" id="plans">
        <div class="bg-overlay bg-overlay-pattern"></div>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="text-center mb-5">
                        @* عنوان اصلی بخش محاسبه‌گر *@
                        <h2 class="mb-3 fw-semibold lh-base">اشتراک VPN سفارشی خود را بسازید!</h2>
                        @* توضیحات برای راهنمایی کاربر *@
                        <p class="text-muted mb-4">
                            با استفاده از اسلایدرهای زیر، حجم ترافیک و مدت زمان اعتبار مورد نیاز خود را مشخص کنید. قیمت اشتراک به صورت خودکار محاسبه و نمایش داده می‌شود.
                            با افزایش مدت زمان، از تخفیف‌های پلکانی بهره‌مند شوید!
                        </p>
                    </div>
                </div><!-- end col -->
            </div><!-- end row -->

            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-9">
                    @* کمی عریض‌تر برای جا دادن بهتر محتوا *@
                    <div class="card border-0 shadow-lg">
                        <div class="card-body p-4 p-md-5">
                            @* فرم برای ارسال اطلاعات به سرور (مهم) *@
                            @* اکشن فرم باید به کنترلر و اکشنی اشاره کند که سفارش را پردازش می‌کند *@
                            @* مثال: <form id="customPlanForm" asp-area="UserPanel" asp-controller="Subscription" asp-action="CreateCustomSubscription" method="post"> *@
                            <form id="customPlanForm" action="@Url.Action("BuySubscription", "Panel", new { area = "UserPanel" })" method="post">
                                @* توکن ضد جعل برای امنیت فرم *@
                                @Html.AntiForgeryToken()

                                @* فیلدهای پنهان برای ارسال مقادیر نهایی به سرور *@
                                <input type="hidden" id="hiddenTraffic" name="TrafficGB" value="50" /> @* مقدار پیش‌فرض *@
                                <input type="hidden" id="hiddenDuration" name="DurationDays" value="30" /> @* مقدار پیش‌فرض *@
                                <input type="hidden" id="hiddenRemarkName" name="RemarkName" value="" />

                                <div class="row gy-4 gy-md-5">
                                    @* افزایش فاصله عمودی در سایز md به بالا *@

                                    <div class="col-md-6">
                                        @* --- انتخاب حجم ترافیک --- *@
                                        <div class="mb-4 pb-2">
                                            @* افزودن فاصله پایین *@
                                            <h5 class="fs-16 mb-3">
                                                <i class="ri-database-2-line align-bottom me-1 text-primary"></i> حجم ترافیک (GB)
                                            </h5>
                                            <input type="range" class="form-range" id="trafficRange" name="trafficRangeSlider" min="10" max="500" step="10" value="50"> @* محدوده 1 تا 500 گیگ *@
                                            <div class="d-flex justify-content-between mt-1">
                                                <span class="fs-13 text-muted">10 GB</span>
                                                <span class="fw-medium fs-15 text-primary" id="trafficValue">50 GB</span> @* نمایش مقدار فعلی *@
                                                <span class="fs-13 text-muted">500 GB</span>
                                            </div>
                                        </div>

                                        @* --- انتخاب مدت زمان --- *@
                                        <div class="mb-4 pb-2">
                                            @* افزودن فاصله پایین *@
                                            <h5 class="fs-16 mb-3">
                                                <i class="ri-calendar-2-line align-bottom me-1 text-primary"></i> مدت زمان (روز)
                                            </h5>
                                            <input type="range" class="form-range" id="durationRange" name="durationRangeSlider" min="15" max="365" step="5" value="30"> @* محدوده 1 تا 365 روز *@
                                            <div class="d-flex justify-content-between mt-1">
                                                <span class="fs-13 text-muted">15 روز</span>
                                                <span class="fw-medium fs-15 text-primary" id="durationValue">30 روز</span> @* نمایش مقدار فعلی *@
                                                <span class="fs-13 text-muted">365 روز</span>
                                            </div>
                                            <small class="form-text text-muted mt-2 d-block">تخفیف‌ها برای 90 روز به بالا اعمال می‌شود.</small>
                                        </div>

                                        @* --- نام دلخواه اشتراک (اختیاری) --- *@
                                        <div>
                                            <h5 class="fs-16 mb-2">
                                                <i class="ri-pencil-line align-bottom me-1 text-primary"></i> نام دلخواه اشتراک (اختیاری)
                                            </h5>
                                            <input type="text" class="form-control" id="remarkName" placeholder="مثال: اشتراک شخصی من">
                                            <small class="form-text text-muted mt-1 d-block">این نام به شما کمک می‌کند اشتراک‌های مختلف خود را تشخیص دهید.</small>
                                        </div>

                                    </div>

                                    @* --- ستون خلاصه سفارش و پرداخت --- *@
                                    <div class="col-md-6">
                                        <div class="bg-soft-primary p-4 rounded-3 h-100 d-flex flex-column shadow-sm">
                                            @* تغییر رنگ به آبی و افزودن سایه *@
                                            <h5 class="fs-18 mb-3 text-center"><i class="ri-file-list-3-line align-bottom me-1"></i> خلاصه سفارش شما</h5>

                                            @* جدول نمایش جزئیات سفارش *@
                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm table-borderless align-middle ff-secondary mb-0">
                                                    <tbody>
                                                        <tr>
                                                            <th scope="row">حجم ترافیک:</th>
                                                            <td class="text-end fw-medium" id="summaryTraffic">50 گیگابایت</td>
                                                        </tr>
                                                        <tr>
                                                            <th scope="row">مدت زمان:</th>
                                                            <td class="text-end fw-medium" id="summaryDuration">30 روز</td>
                                                        </tr>
                                                        @* ردیف نام اشتراک (در صورت وارد شدن نمایش داده می‌شود) *@
                                                        <tr id="remarkNameRow" style="display: none;">
                                                            <th scope="row">نام اشتراک:</th>
                                                            <td class="text-end fw-medium" id="summaryRemarkName"></td>
                                                        </tr>
                                                        @* ردیف تخفیف (در صورت وجود نمایش داده می‌شود) *@
                                                        <tr id="discountRow" style="display: none;">
                                                            <th scope="row" class="text-success">تخفیف:</th>
                                                            <td class="text-end fw-medium text-success" id="summaryDiscount">0%</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <hr class="my-3 border-dashed">

                                            @* نمایش قیمت نهایی *@
                                            <div class="text-center mb-4">
                                                <p class="text-muted mb-1">مبلغ قابل پرداخت:</p>
                                                <h2 class="display-6 fw-bold mb-0 text-primary" id="summaryPrice">
                                                    در حال محاسبه... @* متن اولیه تا قیمت محاسبه شود *@
                                                </h2>
                                                @* واحد پولی را می‌توان خارج از span قیمت گذاشت *@
                                                <small class="fs-6 text-muted">تومان</small>
                                            </div>

                                            @* دکمه نهایی ثبت سفارش *@
                                            <div class="mt-auto">
                                                @* دکمه را پایین می‌برد *@
                                                @*
                                                این دکمه باید فرم را submit کند یا کاربر را به صفحه پرداخت هدایت کند.
                                                نوع دکمه به 'submit' تغییر داده شد تا فرم را ارسال کند.
                                                می‌توان با JS قبل از ارسال، اعتبار سنجی بیشتری انجام داد.
                                            *@
                                                <button type="submit" class="btn btn-primary w-100 btn-lg" id="order-button" title="ثبت و پرداخت سفارش">
                                                    <i class="ri-shopping-cart-2-line align-middle me-1"></i> ثبت و پرداخت سفارش
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div> @* end row *@
                            </form> @* end form *@
                        </div><!-- end card body -->
                    </div><!-- end card -->
                    <p class="text-center text-muted mt-4">نیاز به راهنمایی یا پلن‌های سازمانی دارید؟ <a href="#contact" class="link-primary text-decoration-underline">با ما تماس بگیرید</a>.</p>
                </div><!-- end col -->
            </div><!-- end row -->
        </div><!-- end container -->
    </section>
    <!-- end plan / Interactive Calculator -->
