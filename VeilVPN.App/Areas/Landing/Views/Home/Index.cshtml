@section scripts {
    <!-- Swiper JS (برای اسلایدر نظرات) -->
    <script src="~/assets/libs/swiper/swiper-bundle.min.js"></script>
    <!-- landing init (تنظیمات اولیه صفحه فرود قالب) -->
    <script src="~/assets/js/pages/landing.init.js"></script>

    @* --- اسکریپت محاسبه‌گر قیمت پلن سفارشی (بر اساس کد جدید شما) --- *@
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- قیمت‌های پایه (برای محاسبه سمت کلاینت در صورت خطای سرور) ---
            const pricePerGB = 2500; // قیمت هر گیگابایت: 2500 تومان
            const pricePerDay = 1500; // قیمت هر روز: 1500 تومان

            // --- المان‌های DOM ---
            // اسلایدرها
            const trafficRange = document.getElementById('trafficRange');
            const durationRange = document.getElementById('durationRange');
            const remarkNameInput = document.getElementById('remarkName'); // فیلد نام دلخواه اشتراک

            // المان‌های نمایش مقادیر
            const trafficValue = document.getElementById('trafficValue'); // نمایش مقدار ترافیک کنار اسلایدر
            const durationValue = document.getElementById('durationValue'); // نمایش مقدار مدت زمان کنار اسلایدر
            const summaryTraffic = document.getElementById('summaryTraffic'); // نمایش ترافیک در خلاصه سفارش
            const summaryDuration = document.getElementById('summaryDuration'); // نمایش مدت زمان در خلاصه سفارش
            const summaryPrice = document.getElementById('summaryPrice');       // نمایش قیمت نهایی در خلاصه سفارش
            const discountRow = document.getElementById('discountRow');       // ردیف نمایش تخفیف در خلاصه
            const summaryDiscount = document.getElementById('summaryDiscount');   // نمایش درصد تخفیف
            const remarkNameRow = document.getElementById('remarkNameRow');     // ردیف نمایش نام اشتراک در خلاصه
            const summaryRemarkName = document.getElementById('summaryRemarkName'); // نمایش نام اشتراک

            // فیلدهای پنهان فرم (برای ارسال به سرور هنگام ثبت سفارش نهایی)
            const hiddenTraffic = document.getElementById('hiddenTraffic');
            const hiddenDuration = document.getElementById('hiddenDuration');
            const hiddenRemarkName = document.getElementById('hiddenRemarkName');

            // --- Event Listeners ---

            // به‌روزرسانی نام اشتراک در خلاصه سفارش هنگام تایپ
            if (remarkNameInput) { // بررسی وجود المان قبل از افزودن listener
                remarkNameInput.addEventListener('input', function() {
                    const value = this.value.trim();
                    if (hiddenRemarkName) hiddenRemarkName.value = value;

                    if (remarkNameRow && summaryRemarkName) {
                        if (value) {
                            remarkNameRow.style.display = 'table-row'; // یا 'block' یا متناسب با layout
                            summaryRemarkName.textContent = value;
                        } else {
                            remarkNameRow.style.display = 'none';
                        }
                    }
                });
            }

            // تابع محاسبه قیمت در سمت کلاینت (فقط برای نمایش اولیه یا در صورت خطای سرور)
            function calculatePriceClientSide(traffic, duration) {
                 // محاسبه قیمت پایه
                const trafficCost = traffic * pricePerGB;
                const durationCost = duration * pricePerDay;

                // مجموع قیمت پایه
                let finalPrice = trafficCost + durationCost;

                // اعمال تخفیف بر اساس مدت زمان
                let discountPercent = 0;

                if (duration >= 300 && duration <= 365) {       // 10 تا 12 ماه (300-365 روز)
                    discountPercent = 20;                            // 20 درصد تخفیف
                } else if (duration >= 180 && duration < 300) { // 6 تا 10 ماه (180-299 روز)
                    discountPercent = 15;                            // 15 درصد تخفیف
                } else if (duration >= 90 && duration < 180) {  // 3 تا 6 ماه (90-179 روز)
                    discountPercent = 10;                            // 10 درصد تخفیف
                }

                // اعمال تخفیف
                if (discountPercent > 0) {
                   finalPrice = finalPrice * (1 - (discountPercent / 100));
                }


                // گرد کردن قیمت به هزار تومان نزدیک‌تر
                finalPrice = Math.round(finalPrice / 1000) * 1000;

                return { price: finalPrice, discount: discountPercent };
            }

            // دریافت قیمت از سرور با استفاده از Fetch API
            async function getPriceFromServer(traffic, duration) {
                // بررسی وجود توکن CSRF قبل از ارسال درخواست
                const csrfTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!csrfTokenInput) {
                    console.error('CSRF token not found. Cannot make server request.');
                    // در صورت عدم وجود توکن، از محاسبه سمت کلاینت استفاده می‌کنیم
                    return calculatePriceClientSide(traffic, duration);
                }
                const csrfToken = csrfTokenInput.value;

                try {
                    // تغییر آدرس به کنترلر جدید Subscription و اکشن CalculatePrice در اریا UserPanel
                    const url = '@Url.Action("CalculatePrice", "Subscription", new { area = "UserPanel" })';
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken // ارسال توکن CSRF
                        },
                        body: JSON.stringify({
                            traffic: traffic, // نام پارامترها باید با مدل ورودی اکشن مطابقت داشته باشد
                            duration: duration
                        })
                    });

                    if (!response.ok) {
                        // تلاش برای خواندن پیام خطا از سرور (اگر وجود داشته باشد)
                         const errorText = await response.text();
                         throw new Error(errorText || `خطا در دریافت قیمت از سرور: ${response.status}`);
                    }

                    const data = await response.json();
                    // فرض می‌کنیم سرور یک آبجکت JSON با پراپرتی‌های price و discount برمی‌گرداند
                    if (typeof data.price !== 'number' || typeof data.discount !== 'number') {
                         throw new Error('پاسخ دریافتی از سرور معتبر نیست.');
                    }
                    return { price: data.price, discount: data.discount };

                } catch (error) {
                    console.error('خطا در ارتباط با سرور برای محاسبه قیمت:', error);
                    // در صورت بروز هرگونه خطا (شبکه، سرور، پاسخ نامعتبر)، از محاسبه سمت کلاینت استفاده می‌کنیم
                    // می‌توانید یک پیام خطا به کاربر نمایش دهید
                    if (summaryPrice) summaryPrice.textContent = "خطا در محاسبه";
                    await new Promise(resolve => setTimeout(resolve, 1500)); // نمایش خطا برای مدت کوتاه
                    return calculatePriceClientSide(traffic, duration);
                }
            }

            // به‌روزرسانی نمایش مقادیر و قیمت در UI
            async function updateDisplay() {
                // بررسی وجود المان‌ها قبل از استفاده
                if (!trafficRange || !durationRange || !trafficValue || !durationValue || !summaryTraffic || !summaryDuration || !hiddenTraffic || !hiddenDuration || !summaryPrice || !discountRow || !summaryDiscount) {
                    console.error("یکی یا چند المان مورد نیاز برای محاسبه‌گر قیمت یافت نشد.");
                    return;
                }

                const traffic = parseInt(trafficRange.value, 10);
                const duration = parseInt(durationRange.value, 10);

                // نمایش مقادیر انتخاب شده کنار اسلایدرها
                trafficValue.textContent = `${traffic} GB`;
                durationValue.textContent = `${duration} روز`;

                // نمایش مقادیر انتخاب شده در خلاصه سفارش
                summaryTraffic.textContent = `${traffic} گیگابایت`;
                summaryDuration.textContent = `${duration} روز`;

                // به‌روزرسانی فیلدهای پنهان فرم
                hiddenTraffic.value = traffic;
                hiddenDuration.value = duration;

                // نشان دادن "در حال محاسبه..." هنگام درخواست قیمت
                summaryPrice.textContent = "در حال محاسبه...";
                discountRow.style.display = "none"; // پنهان کردن تخفیف تا محاسبه انجام شود

                // دریافت قیمت (ترجیحاً از سرور)
                const result = await getPriceFromServer(traffic, duration);

                // نمایش قیمت نهایی محاسبه شده
                // استفاده از toLocaleString('fa-IR') برای نمایش اعداد فارسی با جداکننده هزارگان
                summaryPrice.textContent = `${result.price.toLocaleString('fa-IR')} تومان`;

                // نمایش تخفیف اگر مقدار آن بزرگتر از صفر باشد
                if (result.discount > 0) {
                    discountRow.style.display = "table-row"; // یا 'block' یا متناسب با layout
                    summaryDiscount.textContent = `${result.discount.toLocaleString('fa-IR')}%`;
                } else {
                    discountRow.style.display = "none";
                }
            }

            // متغیر برای نگهداری تایمر debounce
             let debounceTimer;

             // تابع debounce برای جلوگیری از فراخوانی مکرر updateDisplay
             function debouncedUpdateDisplay() {
                 clearTimeout(debounceTimer);
                 debounceTimer = setTimeout(updateDisplay, 300); // 300 میلی‌ثانیه تاخیر
             }


            // رویدادهای تغییر مقادیر اسلایدرها
            if (trafficRange) {
                trafficRange.addEventListener('input', function() {
                    // به‌روزرسانی سریع مقادیر نمایشی بدون انتظار برای پاسخ سرور
                    if(trafficValue) trafficValue.textContent = `${this.value} GB`;
                    if(summaryTraffic) summaryTraffic.textContent = `${this.value} گیگابایت`;
                    if(hiddenTraffic) hiddenTraffic.value = this.value;

                    // قیمت را با تاخیر دریافت/محاسبه می‌کنیم
                    debouncedUpdateDisplay();
                });
            }

            if (durationRange) {
                durationRange.addEventListener('input', function() {
                    // به‌روزرسانی سریع مقادیر نمایشی بدون انتظار برای پاسخ سرور
                    if(durationValue) durationValue.textContent = `${this.value} روز`;
                    if(summaryDuration) summaryDuration.textContent = `${this.value} روز`;
                    if(hiddenDuration) hiddenDuration.value = this.value;

                    // قیمت را با تاخیر دریافت/محاسبه می‌کنیم
                     debouncedUpdateDisplay();
                });
            }


            // مقداردهی اولیه هنگام بارگذاری صفحه
            // ابتدا بررسی می‌کنیم که آیا المان‌های اصلی وجود دارند
            if (trafficRange && durationRange) {
                 updateDisplay(); // محاسبه و نمایش قیمت اولیه
            } else {
                 console.warn("اسلایدرهای ترافیک یا مدت زمان یافت نشدند. محاسبه‌گر قیمت غیرفعال است.");
                 // می‌توانید در اینجا بخش مربوط به محاسبه‌گر را پنهان کنید یا پیام مناسبی نمایش دهید
            }

        });
    </script>

    @* --- اسکریپت برای فرم تماس (اختیاری - اگر هنوز از آن استفاده می‌کنید) --- *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const contactForm = document.getElementById('contact-form'); // آیدی فرم تماس
             const submitButton = document.getElementById('submit-contact-button'); // آیدی دکمه ارسال فرم تماس
             const responseDiv = document.getElementById('contact-message-response'); // المان نمایش پیام پاسخ
             const csrfTokenInput = document.querySelector('input[name="__RequestVerificationToken"]'); // توکن CSRF

             if (contactForm && submitButton && responseDiv && csrfTokenInput) {
                contactForm.addEventListener('submit', function (e) {
                    e.preventDefault(); // جلوگیری از ارسال پیش‌فرض فرم

                    submitButton.disabled = true;
                    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> در حال ارسال...';
                    responseDiv.innerHTML = ''; // پاک کردن پیام‌های قبلی

                    const formData = new FormData(contactForm);
                    const csrfToken = csrfTokenInput.value;

                    fetch(contactForm.action, { // URL اکشن از پراپرتی action فرم خوانده می‌شود
                        method: 'POST',
                        body: formData,
                        headers: {
                            // مهم: ارسال توکن ضد جعل (CSRF Token)
                            'RequestVerificationToken': csrfToken
                        }
                    })
                    .then(response => {
                         if (!response.ok) {
                             // تلاش برای خواندن پیام خطا از سرور (اگر وجود داشته باشد)
                              return response.text().then(text => { throw new Error(text || `خطا در ارسال پیام: ${response.statusText}`); });
                         }
                         // بررسی کنید که آیا پاسخ JSON است یا خیر
                         const contentType = response.headers.get("content-type");
                         if (contentType && contentType.indexOf("application/json") !== -1) {
                             return response.json(); // فرض بر اینکه سرور JSON برمی‌گرداند
                         } else {
                              return response.text().then(text => {
                                  // اگر پاسخ JSON نبود، آن را به عنوان یک پیام موفقیت متنی در نظر بگیرید
                                  // یا یک ساختار JSON پیش‌فرض برای موفقیت ایجاد کنید
                                  console.log("Server response (non-JSON):", text);
                                  return { success: true, message: text || 'پیام با موفقیت ارسال شد.' };
                              });
                         }
                    })
                    .then(data => {
                        // بر اساس ساختار پاسخ JSON از سرور عمل کنید
                         if (data.success) {
                             responseDiv.innerHTML = `<div class="alert alert-success alert-dismissible fade show" role="alert">
                                                     ${data.message || 'پیام شما با موفقیت ارسال شد. به زودی با شما تماس خواهیم گرفت.'}
                                                     <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                                                  </div>`;
                             contactForm.reset(); // پاک کردن فرم
                         } else {
                             responseDiv.innerHTML = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                     ${data.message || 'خطایی در ارسال پیام رخ داد. لطفا دوباره تلاش کنید.'}
                                                      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                                                  </div>`;
                         }
                    })
                    .catch(error => {
                        console.error('Error submitting contact form:', error);
                        responseDiv.innerHTML = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                 خطایی در ارتباط با سرور رخ داد. لطفا اتصال اینترنت خود را بررسی کرده و دوباره تلاش کنید. (${error.message})
                                                 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                                             </div>`;
                    })
                    .finally(() => {
                        // فعال کردن مجدد دکمه و بازگرداندن متن اصلی آن
                        submitButton.disabled = false;
                        // متن اصلی دکمه ارسال فرم تماس را اینجا قرار دهید
                        submitButton.innerHTML = '<i class="ri-send-plane-fill align-bottom me-1"></i> ارسال پیام';
                    });
                });
             } else {
                  // اگر یکی از المان‌های فرم تماس یافت نشد، یک هشدار در کنسول ثبت کنید
                  if (!contactForm) console.warn("المان فرم تماس (#contact-form) یافت نشد.");
                  if (!submitButton) console.warn("دکمه ارسال فرم تماس (#submit-contact-button) یافت نشد.");
                  if (!responseDiv) console.warn("المان نمایش پاسخ فرم تماس (#contact-message-response) یافت نشد.");
                  if (!csrfTokenInput) console.warn("توکن CSRF در فرم یافت نشد.");
             }
        });
    </script>

}
